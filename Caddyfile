# Reverse proxy for the CYFR self-hosted stack. See docker-compose.yml.
#
#   /mcp*, /api/*,    → cyfr (Emissary API, :4000)
#   /auth/*, /t/*
#   everything else    → porta (A.Q.U.A. PWA, vite preview on :8080)
#
# Set CYFR_HOST and CADDY_ACME_EMAIL in .env. With CYFR_HOST=localhost Caddy
# serves plain HTTP on :80 (no ACME); with a real domain it auto-provisions TLS.
#
# This service only runs when the `tls` compose profile is active — `cyfr
# init` sets CYFR_BEHIND_PROXY=true when you answer "yes" to the TLS prompt
# and `cyfr up` adds `--profile tls` accordingly. In direct mode the porta
# container handles everything on :8080 directly (vite preview proxies the
# cyfr paths internally, no Caddy needed).

{
	email {$CADDY_ACME_EMAIL}
}

{$CYFR_HOST:localhost} {
	encode zstd gzip

	# --- CYFR API (Emissary :4000): MCP, REST, auth, tinctures ---
	# `handle /mcp` is the exact-path matcher — without the `*` it does NOT
	# also catch `/mcp-servers` (the PWA route). cyfr's MCP transport is the
	# single `/mcp` endpoint; the PWA's `mcp-servers` page lives under porta.
	handle /mcp {
		reverse_proxy cyfr:4000
	}
	handle /api/* {
		reverse_proxy cyfr:4000
	}
	handle /auth/* {
		reverse_proxy cyfr:4000
	}
	handle /t/* {
		reverse_proxy cyfr:4000
	}

	# --- A.Q.U.A. PWA (everything else) ---
	handle {
		header {
			Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-src 'self'; worker-src 'self'; manifest-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
			Referrer-Policy strict-origin-when-cross-origin
			X-Content-Type-Options nosniff
			X-Frame-Options SAMEORIGIN
		}
		reverse_proxy porta:8080
	}

	# --- (optional) Prism LiveView dashboard ---
	# Prism serves at `/`, so mounting it under a sub-path requires Prism to be
	# path-prefix aware. Disabled by default.
	# handle_path /prism/* {
	#	reverse_proxy cyfr:4001
	# }
}
