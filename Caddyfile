# Reverse proxy for a public CYFR home. See docker-compose.yml.
#
#   everything → cyfr:{$CYFR_PROXY_PORT:4001} (the endpoint's proxy listener: Prism, /mcp, /api, /auth, /t)
#
# Set CYFR_HOST and CADDY_ACME_EMAIL in .env. Caddy serves TLS and redirects
# plain HTTP to it. With CYFR_HOST=localhost, the default, the certificate
# comes from Caddy's own local CA, with no ACME; with a real domain Caddy
# obtains one over ACME, registered under CADDY_ACME_EMAIL when it is set
# and under no email when it is empty.
#
# This service runs in the `public` compose profile alone, which `cyfr up`
# and `cyfr reach` select when CYFR_REACH=public (`cyfr reach public
# --domain <your domain>` writes it). A local or tailnet home has no Caddy.
#
# Client-IP trust: Caddy's default reverse_proxy behavior APPENDS the peer IP
# to X-Forwarded-For (no explicit directive needed), and cyfr's proxy
# listener resolves the client right-to-left, stripping the hops inside
# CYFR_TRUSTED_PROXY_CIDRS, which compose sets to this Caddy's and
# Tailscale's addresses on the edge network. If you stack another proxy or
# CDN in front of Caddy, add its addresses to CYFR_TRUSTED_PROXY_CIDRS in
# .env, or client IPs will resolve to that proxy and IP allowlists will fail
# closed.
#
# Every route is proxied to cyfr's one endpoint, which sets its own security
# headers (CSP/XFO) per pipeline. HSTS is this proxy's: the endpoint sees plain
# HTTP from Caddy and so sends none, and the site block sets the endpoint's own
# value on every response it serves for any host but a loopback one.
# tests/proxy-hsts/run.sh holds the two values equal.
{
	# Quoted, so an empty or unset CADDY_ACME_EMAIL is an empty argument and
	# registers no email, where a bare placeholder would leave `email` with
	# none and Caddy would refuse the file.
	email "{$CADDY_ACME_EMAIL}"
}

{$CYFR_HOST:localhost} {
	encode zstd gzip

	# HSTS, the endpoint's value (CyfrWeb.Plugs.ApiSecurityHeaders), on every
	# response this site serves, Caddy's own errors included. A loopback host
	# gets none: its certificate is from Caddy's local CA, and a browser that
	# trusted that root would pin HTTPS for two years on every port of
	# localhost and, by includeSubDomains, on every *.localhost name.
	# Loopback is localhost, a name ending in .localhost at any depth,
	# 127.0.0.1 and ::1, in any case. The pattern is a regexp because the host
	# matcher's *.localhost matches one label only, and it allows the brackets
	# {http.request.host} keeps on an IPv6 host sent without a port.
	@hsts not vars_regexp {http.request.host} `(?i)^(localhost|.+\.localhost|127\.0\.0\.1|\[?::1\]?)$`
	header @hsts Strict-Transport-Security "max-age=63072000; includeSubDomains"

	# Everything: cyfr's one endpoint (Prism, /mcp, /api, /auth, /t). cyfr sets
	# its own CSP/XFO on every response it serves.
	handle {
		reverse_proxy cyfr:{$CYFR_PROXY_PORT:4001} {
			# The header above is set before the upstream's headers are added
			# to the response, so an upstream's own HSTS is dropped here, for
			# every host, and no response carries two.
			header_down -Strict-Transport-Security
		}
	}
}
