erl_crash.dump

# SQLite databases
*.db
*.db-shm
*.db-wal
/data/

# Environment files
.env
.env.local
.env.*.local

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
*~
.gemini
.kilocode
.claude
CLAUDE.md

# macOS
.DS_Store

# Sigstore keys (never commit)
cosign.key
*.key

# Wasmex/Wasmtime compiled NIFs cache
priv/native/

# Phoenix generated assets
apps/*/priv/static/assets/

# Test coverage
/cover/

# Dialyzer
priv/plts/

# Release artifacts
/rel/

# Elixir LS
.elixir_ls/

# Per-app ignores are inherited
apps/*/_build/
apps/*/deps/
apps/*/cover/
apps/*/.elixir_ls/
apps/*/data/
apps/*/components/**/output.json
apps/*/components/**/test.txt

# Phoenix static cache manifest
apps/*/priv/static/cache_manifest.json

# Go (Codex CLI)
apps/codex/cyfr

# goreleaser output
dist/
cyfr-scaffold.tar.gz

# Component build artifacts
components/**/target/

# Component storage is project-scoped: components/{org}/{project}/{type}s/{publisher}/
# Ignore every publisher's components (pulled/published/seeded copies); keep only
# the bundled local-publisher set under the seeded local/default workspace tracked.
components/*/*/catalysts/*/
!components/local/default/catalysts/local/
components/*/*/reagents/*/
!components/local/default/reagents/local/
components/*/*/formulas/*/
!components/local/default/formulas/local/
components/*/*/tinctures/*/
!components/local/default/tinctures/local/

# Docker Compose local overrides (auto-generated by cyfr up)
docker-compose.override.yml

# Temporary files
tmp/

# Docs symlink (points to external directory)
docs

# Porta (Tauri desktop app)
apps/porta/target/
apps/porta/gen/
