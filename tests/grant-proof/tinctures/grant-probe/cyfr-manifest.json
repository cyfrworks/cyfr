{
  "name": "grant-probe",
  "type": "tincture",
  "version": "1.0.0",
  "publisher": "local",
  "description": "The grant proof's tincture: it asks for two hosts, a folder and a key it can go without, and lets what it reads of the folder reach one host and its notes the other.",
  "needs": {
    "feed": {
      "type": "api_key:grant.test",
      "fields": ["TOKEN"],
      "reason": "to read the probe's feed",
      "required": false
    }
  },
  "caps": {
    "egress": {"domains": ["alpha.grant.test", "beta.grant.test"], "methods": ["GET"]},
    "storage": {"paths": ["data/probe/"], "actions": ["read"]},
    "flows": [
      {"from": "files_by_grant", "to": "alpha.grant.test"},
      {"from": "filed", "to": "beta.grant.test"}
    ]
  },
  "tincture": {
    "entry": "index.html"
  }
}
