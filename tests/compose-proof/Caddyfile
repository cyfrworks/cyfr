# The Compose proof's front (tests/compose-proof/run.sh): plain HTTP on
# port 80, proxied to cyfr's proxy listener as the shipped Caddyfile
# proxies its TLS site, so the leg through Caddy is the shipped stack's
# path to the address cyfr's proxy listener binds, with no certificate to
# trust. Compose passes CYFR_PROXY_PORT to caddy, with its default.
:80 {
	reverse_proxy cyfr:{$CYFR_PROXY_PORT}
}
