  "comment": "The certified cross-home confirmation (Prima.ConfirmationAssertion): a remote person's own CYFR, after a fresh confirmation there by a passkey at its own RP ID or a protected device, signs with the person's live key that they confirmed one pending confirmation at the deciding CYFR; the deciding CYFR checks it under the person's head read fresh from their directory against the record it holds. keys and identity are person_assertion.json's. record is the deciding CYFR's pending confirmation the assertions name (ref = Prima.Confirmation.ref(id), digest = Prima.Confirmation.digest(record), preview_digest = Prima.ConfirmationAssertion.preview_digest(preview), the SHA-256 of the JCS bytes of the record's preview: the person's own CYFR signs only for a carried preview whose preview_digest is the one it was told, and the deciding CYFR refuses one over another preview). exchange is how it is carried and recorded, and what the one Devices list answers.",
  "exchange": {
    "deciding": {
      "callback": {
        "encoding": "base64url_unpadded_jcs",
        "fragment": "home_assertion",
        "path": "/confirm"
      },
      "confirmation.confirm": {
        "args": [
          "home_assertion",
          "ref"
        ],
        "excludes": [
          "assertion",
          "code",
          "device_proof"
        ],
        "records": {
          "confirmed_client_id": null,
          "confirmed_passkey_id": null,
          "proof": "home"
        }
      },
      "confirmation.pending": {
        "at_home": [
          "athanor",
          "audience",
          "digest",
          "expires_at",
          "preview",
          "preview_digest",
          "ref"
        ],
        "methods": {
          "first_method": [
            "oidc",
            "email"
          ],
          "local": [
            "passkey",
            "device"
          ],
          "remote": [
            "device",
            "home"
          ],
          "restore": [
            "oidc",
            "email"
          ]
        },
        "record_adds": {
          "home": [
            "at_home"
          ]
        }
      },
      "head": "live",
      "refusals": {
        "bad_signature": "proof_refused",
        "directory": "identity_stale",
        "expired": "proof_refused",
        "local_person": "not_remote",
        "malformed": "proof_refused",
        "stale_key_epoch": "proof_refused",
        "wrong_athanor": "proof_refused",
        "wrong_audience": "proof_refused",
        "wrong_digest": "proof_refused",
        "wrong_identifier": "proof_refused",
        "wrong_preview": "proof_refused",
        "wrong_ref": "proof_refused"
      }
    },
    "devices": {
      "pairing.list": {
        "holder_kinds": [
          "chip",
          "platform",
          "software"
        ],
        "row": [
          "certificate_expires_at",
          "client_id",
          "current",
          "display_name",
          "holder_kind",
          "paired_at",
          "source",
          "storage",
          "synced"
        ],
        "sources": {
          "chip": "device_cert",
          "platform": "passkey",
          "software": "device_cert"
        },
        "synced": {
          "chip": false,
          "platform": "backup_eligible",
          "software": false
        }
      },
      "pairing.revoke": {
        "args": [
          "client_id"
        ],
        "scope": {
          "chip": "device",
          "platform": "credential",
          "software": "device"
        }
      }
    },
    "home": {
      "page": {
        "encoding": "base64url_unpadded_jcs",
        "fragment": "confirm",
        "path": "/carry",
        "request": [
          "athanor",
          "audience",
          "digest",
          "expires_at",
          "preview",
          "preview_digest",
          "ref"
        ]
      },
      "person.assert_confirmation": {
        "args": [
          "athanor",
          "audience",
          "digest",
          "expires_at",
          "preview",
          "preview_digest",
          "ref"
        ],
        "confirmation_action": "remote_confirmation",
        "expires_at": "min(now + lifetime_ms, request.expires_at)",
        "proofs": [
          "passkey",
          "device"
        ],
        "result": [
          "assertion",
          "callback"
        ]
      }
    },
    "terminal": {
      "certificate": {
        "binds": [
          "athanor",
          "audience",
          "client_id",
          "device_key",
          "issuer"
        ],
        "protocol": "cyfr-device-cert/v1",
        "subject": "identity"
      },
      "pairing.complete": {
        "certify": [
          "athanor",
          "audience",
          "client_id"
        ],
        "result_optional": [
          "certify"
        ]
      },
      "person.certify": {
        "args": [
          "athanor",
          "audience",
          "client_id",
          "device_key"
        ],
        "confirmation_action": "device_pairing",
        "result": [
          "certificate"
        ],
        "session": "device_session"
      }
    }
  },
