{
  "description": "The directory a CYFR names on its public sign-in page (PrismWeb.LoginLive): the attribute on the page's root, read by the CYFR app before any sign-in starts. Prism renders each of rendered's directories there once; the Go reader (apps/codex/internal/account/discover.go) reads each of pages, counting attributes as HTML reads them, not occurrences of the name, and answers the directory and its account pages' origin, or refuses.",
  "path": "/login",
  "attribute": "data-account-directory",
  "rendered": [
    "https://cyfr.run",
    "https://accounts.example.com/cyfr/directory",
    "https://accounts.example.com:8443",
    "https://accounts.example.com/data-account-directory"
  ],
  "pages": [
    {
      "name": "the default directory",
      "html": "<!doctype html><html><body><div class=\"min-h-screen\" data-account-directory=\"https://cyfr.run\"><h1>Welcome</h1></div></body></html>",
      "directory": "https://cyfr.run",
      "origin": "https://cyfr.run"
    },
    {
      "name": "a directory under a base path",
      "html": "<div data-account-directory=\"https://accounts.example.com/cyfr/directory\" class=\"x\"></div>",
      "directory": "https://accounts.example.com/cyfr/directory",
      "origin": "https://accounts.example.com"
    },
    {
      "name": "a directory on a port, escaped as HTML escapes an attribute",
      "html": "<div data-account-directory=\"https://accounts.example.com:8443/a&amp;b\"></div>",
      "directory": "https://accounts.example.com:8443/a&b",
      "origin": "https://accounts.example.com:8443"
    },
    {
      "name": "a directory whose address holds the attribute's name",
      "html": "<div data-account-directory=\"https://accounts.example.com/data-account-directory\"></div>",
      "directory": "https://accounts.example.com/data-account-directory",
      "origin": "https://accounts.example.com"
    },
    {
      "name": "the attribute's name in text and in another attribute beside the attribute",
      "html": "<div title=\"data-account-directory\" data-account-directory=\"https://cyfr.run\"><p>data-account-directory=\"https://evil.example\"</p></div>",
      "directory": "https://cyfr.run",
      "origin": "https://cyfr.run"
    },
    {
      "name": "no attribute",
      "html": "<div class=\"min-h-screen\"></div>",
      "refused": "missing"
    },
    {
      "name": "the attribute twice",
      "html": "<div data-account-directory=\"https://cyfr.run\"><p data-account-directory=\"https://cyfr.run\"></p></div>",
      "refused": "duplicate"
    },
    {
      "name": "the attribute once quoted and once not",
      "html": "<div data-account-directory=\"https://cyfr.run\"><p data-account-directory=https://evil.example></p></div>",
      "refused": "duplicate"
    },
    {
      "name": "single-quoted, which HTML reads as the same attribute",
      "html": "<div data-account-directory='https://cyfr.run'></div>",
      "directory": "https://cyfr.run",
      "origin": "https://cyfr.run"
    },
    {
      "name": "plain http",
      "html": "<div data-account-directory=\"http://cyfr.run\"></div>",
      "refused": "invalid"
    },
    {
      "name": "a trailing slash",
      "html": "<div data-account-directory=\"https://cyfr.run/\"></div>",
      "refused": "invalid"
    },
    {
      "name": "a query",
      "html": "<div data-account-directory=\"https://cyfr.run/?next=x\"></div>",
      "refused": "invalid"
    },
    {
      "name": "credentials in the address",
      "html": "<div data-account-directory=\"https://user@cyfr.run\"></div>",
      "refused": "invalid"
    },
    {
      "name": "an uppercase host",
      "html": "<div data-account-directory=\"https://CYFR.run\"></div>",
      "refused": "invalid"
    },
    {
      "name": "empty",
      "html": "<div data-account-directory=\"\"></div>",
      "refused": "invalid"
    }
  ]
}
