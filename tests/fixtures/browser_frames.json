      "stream": [
        "\u001eB100000032b97eb28d20fdf43f{\"t\":\"hello\",\"v\":1,\"chunk\":49152,\"keep_ms\":120000}x\u001eB10000001adefdd34d37959518{\"t\":\"ack\",\"id\":7,\"seq\":0}\n"
