      "stream": [
        "\u001eB100000032B97EB28D20FDF43F{\"t\":\"hello\",\"v\":1,\"chunk\":49152,\"keep_ms\":120000}\n\u001eB10000001adefdd34d37959518{\"t\":\"ack\",\"id\":7,\"seq\":0}\n"
      ],
      "frames": [
        "{\"t\":\"ack\",\"id\":7,\"seq\":0}"
      ],
      "rest": ""
    },
    {
      "name": "a length past the bound is not a frame",
