          {"name": "permission_mode", "kind": "enum", "values": ["ask", "auto"]},
          {"name": "system_prefix", "kind": "string", "default": ""},
          {"name": "thinking_budget", "kind": "integer", "default": 0},
          {"name": "verbose", "kind": "boolean", "default": false},
          {"name": "label", "kind": "string"}
        ]
      },
      "options": [
        {"name": "effort", "kind": "enum", "values": ["low", "medium", "high"], "default": "medium"},
        {"name": "permission_mode", "kind": "enum", "values": ["ask", "auto"]},
        {"name": "system_prefix", "kind": "string", "default": ""},
        {"name": "thinking_budget", "kind": "integer", "default": 0},
        {"name": "verbose", "kind": "boolean", "default": false},
        {"name": "label", "kind": "string"}
      ]
    }
  ],
