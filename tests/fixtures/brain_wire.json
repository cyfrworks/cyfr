{
  "comment": "The brain wire, version 1: the one protocol between a brain's driver (apps/locus/keeper/cmd/cyfr-claude-code, Go) and its holder (Opus.Brain.Wire, Elixir), over a `run` session of the backends service, each way one JSON object per line. A line is at most `max_line_bytes` bytes, UTF-8, the object's members exactly those its message names in `fields` (each present) and `optional` (each present or absent), each of the type `types` names: `id` a non-empty string of at most `max_id_bytes` bytes; `string` any string; `count` a whole number from 0; `boolean`; `object` a JSON object; `ids` and `strings` arrays of ids and of strings; `content` an array of blocks, each one `blocks` shows; `tools` an array of tools, each `{name, description, parameters}` with a name of 1 to 128 bytes, a description string and parameters an object; `config` an object of the members `config` names, each of its type; `counts` an object of exactly the four `counts` names, each a count; `models` an array of `{id, name}`, both strings, the id an id; `phase` one of `phases`; `error_type` one of `error_types`. A list holds at most `max_list` entries. A line that does not read so, names a `t` the other side does not take, or is past a bound, ends the session: `refuse` gives such lines, each with its reason, and `read` gives lines that read, each with what it reads as. Commands go from the holder to the driver, events from the driver to the holder. The driver's first line is `hello`, naming the version and its `boot`, fresh for each driver process. A delivery (`work`, `post`, `answer`) names the id the holder stored it under; `models` and `forget` an id the holder chose. The driver answers each command once: `start` with `started` or `gone`, `work`, `post` and `answer` with `accepted` once the harness's input took it or `refused` when it was not written, `models` with `models` or `refused`, `forget` with `forgot` or `refused`; the holder writes the next command only once the last is answered. Every event of a native turn (`text`, `said`, `own`, `ask`, `usage`, `idle`, `error`) names the `gen` its session was started with and, when the driver knows it, the `work` of the command whose line started that native turn. `native` names those events: the program's own lines, which the driver writes only when its harness wrote one; the rest are the driver's own. `usage` names a native `result` (Claude Code: each result's own identity, its counts the result's alone) or a cumulative `total` per native thread (Codex), exactly one of the two. A `post`'s line to Claude Code carries a uuid derived from the post's id, so a result naming the uuid names the post: the uuid is the first 16 bytes of the SHA-256 of `uuid.prefix` followed by the id, with the version nibble set to 4 and the variant bits to 10, written in lowercase 8-4-4-4-12 form; `uuid.cases` gives ids and their uuids. A `start` that resumes names in `pending` the posts whose delivery is not known, and `started.held` names those of them the session's transcript holds. There is no interrupt: Stop closes the session.",
  "version": 1,
  "max_line_bytes": 1048576,
  "max_id_bytes": 256,
  "max_list": 1000,
  "config": {
    "model": "string",
    "effort": "string",
    "permission_mode": "string",
    "harness_tools": "strings"
  },
  "counts": ["input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens"],
  "phases": ["start", "end"],
  "error_types": ["invalid_request", "authentication", "rate_limited", "overloaded", "provider_error", "unknown_model"],
  "blocks": [
    {"type": "text", "text": "What is in notes.md?"},
    {"type": "image", "media_type": "image/png", "data": "iVBORw0KGgo="},
    {"type": "document", "media_type": "application/pdf", "data": "JVBERi0xLjQ="}
  ],
  "media_types": {
    "image": ["image/jpeg", "image/png", "image/gif", "image/webp"],
    "document": ["application/pdf"]
  },
  "native": ["text", "said", "own", "ask", "usage", "idle", "error"],
  "commands": {
    "start": {
      "fields": ["t", "gen", "config"],
      "optional": ["session", "system", "pending"],
      "types": {"gen": "count", "config": "config", "session": "id", "system": "string", "pending": "ids"},
      "example": {"t": "start", "gen": 2, "session": "4b0c3b1e-2f43-4c5e-9d8a-1f6e2a7c9b30", "config": {"model": "opus", "effort": "high", "permission_mode": "default", "harness_tools": ["Read", "Grep"]}, "system": "You are a crew member of this athanor.", "pending": ["stp_0193a6a0-7f00-7000-8000-000000000001"]}
    },
    "work": {
      "fields": ["t", "id", "work", "tools"],
      "optional": [],
      "types": {"id": "id", "work": "id", "tools": "tools"},
      "example": {"t": "work", "id": "stp_0193a6a0-7f00-7000-8000-000000000002", "work": "trn_0193a6a0-7f00-7000-8000-00000000000a", "tools": [{"name": "files", "description": "Read the athanor's files", "parameters": {"type": "object", "properties": {"path": {"type": "string"}}}}]}
    },
    "post": {
      "fields": ["t", "id", "work", "content"],
      "optional": ["context"],
      "types": {"id": "id", "work": "id", "content": "content", "context": "content"},
      "example": {"t": "post", "id": "stp_0193a6a0-7f00-7000-8000-000000000003", "work": "trn_0193a6a0-7f00-7000-8000-00000000000a", "content": [{"type": "text", "text": "What is in notes.md?"}]}
    },
    "answer": {
      "fields": ["t", "id", "ask", "content", "is_error"],
      "optional": [],
      "types": {"id": "id", "ask": "id", "content": "string", "is_error": "boolean"},
      "example": {"t": "answer", "id": "stp_0193a6a0-7f00-7000-8000-000000000004", "ask": "6f1e2d3c-4b5a-4968-8776-655443322110", "content": "notes.md holds three lines.", "is_error": false}
    },
    "models": {
      "fields": ["t", "id"],
      "optional": [],
      "types": {"id": "id"},
      "example": {"t": "models", "id": "mdl_0193a6a0-7f00-7000-8000-000000000005"}
    },
    "forget": {
      "fields": ["t", "id", "session"],
      "optional": [],
      "types": {"id": "id", "session": "id"},
      "example": {"t": "forget", "id": "obx_0193a6a0-7f00-7000-8000-000000000006", "session": "4b0c3b1e-2f43-4c5e-9d8a-1f6e2a7c9b30"}
    }
  },
  "events": {
    "hello": {
      "fields": ["t", "v", "driver", "boot"],
      "optional": [],
      "types": {"v": "count", "driver": "id", "boot": "id"},
      "example": {"t": "hello", "v": 1, "driver": "cyfr-claude-code", "boot": "b6c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5"}
    },
    "started": {
      "fields": ["t", "session", "fresh", "held"],
      "optional": [],
      "types": {"session": "id", "fresh": "boolean", "held": "ids"},
      "example": {"t": "started", "session": "4b0c3b1e-2f43-4c5e-9d8a-1f6e2a7c9b30", "fresh": false, "held": []}
    },
    "gone": {
      "fields": ["t"],
      "optional": [],
      "types": {},
      "example": {"t": "gone"}
    },
    "accepted": {
      "fields": ["t", "id"],
      "optional": [],
      "types": {"id": "id"},
      "example": {"t": "accepted", "id": "stp_0193a6a0-7f00-7000-8000-000000000003"}
    },
    "refused": {
      "fields": ["t", "id", "reason"],
      "optional": [],
      "types": {"id": "id", "reason": "string"},
      "example": {"t": "refused", "id": "stp_0193a6a0-7f00-7000-8000-000000000002", "reason": "The tools are 1048600 bytes as one line to the harness, past the 1048576 one line carries."}
    },
    "text": {
      "fields": ["t", "gen", "message", "delta"],
      "optional": ["work"],
      "types": {"gen": "count", "work": "id", "message": "id", "delta": "string"},
      "example": {"t": "text", "gen": 2, "work": "trn_0193a6a0-7f00-7000-8000-00000000000a", "message": "msg_01ABCdef", "delta": "notes.md "}
    },
    "said": {
      "fields": ["t", "gen", "message", "text"],
      "optional": ["work"],
      "types": {"gen": "count", "work": "id", "message": "id", "text": "string"},
      "example": {"t": "said", "gen": 2, "work": "trn_0193a6a0-7f00-7000-8000-00000000000a", "message": "msg_01ABCdef", "text": "notes.md holds three lines."}
    },
    "own": {
      "fields": ["t", "gen", "name", "phase"],
      "optional": ["work"],
      "types": {"gen": "count", "work": "id", "name": "string", "phase": "phase"},
      "example": {"t": "own", "gen": 2, "work": "trn_0193a6a0-7f00-7000-8000-00000000000a", "name": "Bash", "phase": "start"}
    },
    "ask": {
      "fields": ["t", "gen", "ask", "name", "arguments"],
      "optional": ["work"],
      "types": {"gen": "count", "work": "id", "ask": "id", "name": "string", "arguments": "object"},
      "example": {"t": "ask", "gen": 2, "work": "trn_0193a6a0-7f00-7000-8000-00000000000a", "ask": "6f1e2d3c-4b5a-4968-8776-655443322110", "name": "files", "arguments": {"path": "notes.md"}}
    },
    "usage": {
      "fields": ["t", "gen", "counts"],
      "optional": ["work", "result", "total"],
      "types": {"gen": "count", "work": "id", "result": "id", "total": "id", "counts": "counts"},
      "example": {"t": "usage", "gen": 2, "work": "trn_0193a6a0-7f00-7000-8000-00000000000a", "result": "9a8b7c6d-5e4f-4a3b-8c2d-1e0f9a8b7c6d", "counts": {"input_tokens": 1200, "output_tokens": 80, "cache_read_tokens": 900, "cache_write_tokens": 0}}
    },
    "idle": {
      "fields": ["t", "gen", "answered", "stop"],
      "optional": ["work"],
      "types": {"gen": "count", "work": "id", "answered": "ids", "stop": "string"},
      "example": {"t": "idle", "gen": 2, "work": "trn_0193a6a0-7f00-7000-8000-00000000000a", "answered": ["stp_0193a6a0-7f00-7000-8000-000000000003"], "stop": "end_turn"}
    },
    "error": {
      "fields": ["t", "gen", "type", "message"],
      "optional": ["work"],
      "types": {"gen": "count", "work": "id", "type": "error_type", "message": "string"},
      "example": {"t": "error", "gen": 2, "work": "trn_0193a6a0-7f00-7000-8000-00000000000a", "type": "rate_limited", "message": "Claude Code reported a rate limit; ask again later."}
    },
    "models": {
      "fields": ["t", "id", "models", "efforts"],
      "optional": [],
      "types": {"id": "id", "models": "models", "efforts": "strings"},
      "example": {"t": "models", "id": "mdl_0193a6a0-7f00-7000-8000-000000000005", "models": [{"id": "opus", "name": "Opus"}, {"id": "sonnet", "name": "Sonnet"}], "efforts": ["low", "medium", "high"]}
    },
    "forgot": {
      "fields": ["t", "id", "session"],
      "optional": [],
      "types": {"id": "id", "session": "id"},
      "example": {"t": "forgot", "id": "obx_0193a6a0-7f00-7000-8000-000000000006", "session": "4b0c3b1e-2f43-4c5e-9d8a-1f6e2a7c9b30"}
    }
  },
  "uuid": {
    "prefix": "cyfr-brain-post\u0000",
    "cases": [
      {"id": "stp_0193a6a0-7f00-7000-8000-000000000003", "uuid": "f8032511-cd67-439b-85f6-8cf7d21929c8"},
      {"id": "p", "uuid": "f8682b94-1b3b-49c7-a13b-2ba17456ccf3"}
    ]
  },
  "read": [
    {"name": "the driver's hello", "from": "driver", "line": "{\"t\":\"hello\",\"v\":1,\"driver\":\"cyfr-claude-code\",\"boot\":\"b6c1d2e3\"}", "reads": {"t": "hello", "v": 1, "driver": "cyfr-claude-code", "boot": "b6c1d2e3"}},
    {"name": "a usage of no work", "from": "driver", "line": "{\"t\":\"usage\",\"gen\":0,\"result\":\"r1\",\"counts\":{\"input_tokens\":1,\"output_tokens\":2,\"cache_read_tokens\":3,\"cache_write_tokens\":4}}", "reads": {"t": "usage", "gen": 0, "result": "r1", "counts": {"input_tokens": 1, "output_tokens": 2, "cache_read_tokens": 3, "cache_write_tokens": 4}}},
    {"name": "an idle that answers nothing", "from": "driver", "line": "{\"t\":\"idle\",\"gen\":1,\"answered\":[],\"stop\":\"end_turn\"}", "reads": {"t": "idle", "gen": 1, "answered": [], "stop": "end_turn"}},
    {"name": "a post with an image", "from": "holder", "line": "{\"t\":\"post\",\"id\":\"p1\",\"work\":\"w1\",\"content\":[{\"type\":\"text\",\"text\":\"look\"},{\"type\":\"image\",\"media_type\":\"image/png\",\"data\":\"iVBORw0KGgo=\"}]}", "reads": {"t": "post", "id": "p1", "work": "w1", "content": [{"type": "text", "text": "look"}, {"type": "image", "media_type": "image/png", "data": "iVBORw0KGgo="}]}},
    {"name": "a fresh start with no configuration set", "from": "holder", "line": "{\"t\":\"start\",\"gen\":0,\"config\":{}}", "reads": {"t": "start", "gen": 0, "config": {}}}
  ],
  "refuse": [
    {"name": "not JSON", "from": "driver", "line": "Welcome to Claude Code", "reason": "unreadable"},
    {"name": "not an object", "from": "driver", "line": "[\"hello\"]", "reason": "unreadable"},
    {"name": "an unknown message", "from": "driver", "line": "{\"t\":\"shell\",\"cmd\":\"rm -rf /\"}", "reason": "unknown"},
    {"name": "a command from the driver", "from": "driver", "line": "{\"t\":\"post\",\"id\":\"p1\",\"work\":\"w1\",\"content\":[]}", "reason": "unknown"},
    {"name": "a field missing", "from": "driver", "line": "{\"t\":\"accepted\"}", "reason": "unreadable"},
    {"name": "a field beyond its message's", "from": "driver", "line": "{\"t\":\"accepted\",\"id\":\"p1\",\"thread\":\"thr_other\"}", "reason": "unreadable"},
    {"name": "a field of the wrong type", "from": "driver", "line": "{\"t\":\"text\",\"gen\":\"2\",\"message\":\"m\",\"delta\":\"x\"}", "reason": "unreadable"},
    {"name": "a negative generation", "from": "driver", "line": "{\"t\":\"text\",\"gen\":-1,\"message\":\"m\",\"delta\":\"x\"}", "reason": "unreadable"},
    {"name": "an empty id", "from": "driver", "line": "{\"t\":\"accepted\",\"id\":\"\"}", "reason": "unreadable"},
    {"name": "an error typed outside the refusals", "from": "driver", "line": "{\"t\":\"error\",\"gen\":0,\"type\":\"secret_denied\",\"message\":\"m\"}", "reason": "unreadable"},
    {"name": "a usage naming both a result and a total", "from": "driver", "line": "{\"t\":\"usage\",\"gen\":0,\"result\":\"r\",\"total\":\"t\",\"counts\":{\"input_tokens\":1,\"output_tokens\":2,\"cache_read_tokens\":3,\"cache_write_tokens\":4}}", "reason": "unreadable"},
    {"name": "a usage naming neither", "from": "driver", "line": "{\"t\":\"usage\",\"gen\":0,\"counts\":{\"input_tokens\":1,\"output_tokens\":2,\"cache_read_tokens\":3,\"cache_write_tokens\":4}}", "reason": "unreadable"},
    {"name": "counts missing one", "from": "driver", "line": "{\"t\":\"usage\",\"gen\":0,\"result\":\"r\",\"counts\":{\"input_tokens\":1,\"output_tokens\":2,\"cache_read_tokens\":3}}", "reason": "unreadable"},
    {"name": "an own tool in an unknown phase", "from": "driver", "line": "{\"t\":\"own\",\"gen\":0,\"name\":\"Bash\",\"phase\":\"running\"}", "reason": "unreadable"},
    {"name": "a model listing entry with no id", "from": "driver", "line": "{\"t\":\"models\",\"id\":\"m\",\"models\":[{\"name\":\"Opus\"}],\"efforts\":[]}", "reason": "unreadable"},
    {"name": "a block of an unknown type", "from": "holder", "line": "{\"t\":\"post\",\"id\":\"p1\",\"work\":\"w1\",\"content\":[{\"type\":\"audio\",\"data\":\"AAAA\"}]}", "reason": "unreadable"},
    {"name": "an image of a type the harness does not take", "from": "holder", "line": "{\"t\":\"post\",\"id\":\"p1\",\"work\":\"w1\",\"content\":[{\"type\":\"image\",\"media_type\":\"image/svg+xml\",\"data\":\"PHN2Zz4=\"}]}", "reason": "unreadable"},
    {"name": "a configuration member it does not name", "from": "holder", "line": "{\"t\":\"start\",\"gen\":0,\"config\":{\"dangerously_skip_permissions\":true}}", "reason": "unreadable"},
    {"name": "a tool with no parameters object", "from": "holder", "line": "{\"t\":\"work\",\"id\":\"w\",\"work\":\"w1\",\"tools\":[{\"name\":\"files\",\"description\":\"\",\"parameters\":[]}]}", "reason": "unreadable"},
    {"name": "a line past the bound", "from": "driver", "line_bytes": 1048577, "reason": "too_large"}
  ]
}
