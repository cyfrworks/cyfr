    {"name": "a null Origin", "store": "empty", "token": "setup", "headers": {"origin": "null"}, "status": 403, "refusal": "forbidden", "reading": "refused"},
    {"name": "another version", "store": "empty", "token": "setup", "body": "{\"version\":2}", "status": 400, "refusal": "invalid_argument", "reading": "refused"},
    {"name": "a version spelled as a string", "store": "empty", "token": "setup", "body": "{\"version\":\"1\"}", "status": 400, "refusal": "invalid_argument", "reading": "refused"},
    {"name": "a version spelled as a fraction", "store": "empty", "token": "setup", "body": "{\"version\":1.0}", "status": 400, "refusal": "invalid_argument", "reading": "refused"},
    {"name": "an empty object", "store": "empty", "token": "setup", "body": "{}", "status": 400, "refusal": "invalid_argument", "reading": "refused"},
    {"name": "a field beside the version", "store": "empty", "token": "setup", "body": "{\"version\":1,\"token\":\"x\"}", "status": 400, "refusal": "invalid_argument", "reading": "refused"},
    {"name": "an array", "store": "empty", "token": "setup", "body": "[1]", "status": 400, "refusal": "invalid_argument", "reading": "refused"},
    {"name": "a body of another media type", "store": "empty", "token": "setup", "content_type": "text/plain", "status": 400, "refusal": "invalid_argument", "reading": "refused"},
