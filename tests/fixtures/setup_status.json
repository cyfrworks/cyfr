    {"name": "a person with no sign-in method yet, the setup token", "store": "person", "token": "setup", "status": 200, "answer": {"version": 1, "state": "open"}, "reading": "open"},
    {"name": "a body at the bound", "store": "empty", "token": "setup", "padded_to": 1024, "status": 200, "answer": {"version": 1, "state": "open"}, "reading": "open"},
    {"name": "a spent token", "store": "set_up", "token": "setup", "status": 200, "answer": {"version": 1, "state": "closed"}, "reading": "closed"},
    {"name": "a restore's pending claim, the setup token", "store": "restore_pending", "token": "setup", "status": 200, "answer": {"version": 1, "state": "closed"}, "reading": "closed"},
    {"name": "an invalid token on a fresh installation", "store": "empty", "token": "other", "status": 200, "answer": {"version": 1, "state": "closed"}, "reading": "closed"},
