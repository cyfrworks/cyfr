{
  "name": "aqua",
  "type": "formula",
  "version": "1.0.4",
  "publisher": "local",
  "description": "AQUA agentic loop. Per-agent tool allowlist (tool_policy: tool.action -> ask|auto, supports tool.* globs); read-kind actions and auto-flagged actions are directly callable, everything else is requested for human approval. Uniform for orchestrator and sub-agents.",
  "dependencies": {
    "static": [
      {
        "ref": "catalyst:local.files",
        "optional": false,
        "reason": "File operations"
      },
      {
        "ref": "catalyst:moonmoon69.claude",
        "optional": false,
        "reason": "Claude LLM provider"
      },
      {
        "ref": "catalyst:moonmoon69.openai",
        "optional": false,
        "reason": "OpenAI LLM provider"
      },
      {
        "ref": "catalyst:moonmoon69.gemini",
        "optional": false,
        "reason": "Gemini LLM provider"
      },
      {
        "ref": "catalyst:moonmoon69.grok",
        "optional": false,
        "reason": "Grok LLM provider"
      },
      {
        "ref": "catalyst:moonmoon69.openrouter",
        "optional": false,
        "reason": "OpenRouter LLM provider"
      }
    ]
  },
  "schema": {
    "input": {
      "type": "object",
      "required": [
        "catalyst_ref",
        "model",
        "task",
        "system"
      ],
      "properties": {
        "catalyst_ref": {
          "type": "string",
          "description": "LLM catalyst reference, e.g. catalyst:moonmoon69.claude:1.0.0"
        },
        "model": {
          "type": "string",
          "description": "Model identifier (e.g. claude-sonnet-4-5-20250514)"
        },
        "task": {
          "type": "string",
          "description": "Task or follow-up message"
        },
        "system": {
          "type": "string",
          "description": "Full system prompt (caller-composed)"
        },
        "messages": {
          "type": "array",
          "description": "Conversation history for continuation"
        },
        "visible_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tool names to expose to the LLM. Omit for all tools."
        },
        "sub_agents": {
          "type": "array",
          "description": "Sub-agent definitions provided by the harness. Each defines a specialist that becomes a virtual tool.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "description",
              "prompt"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Sub-agent name (used as virtual tool name)"
              },
              "title": {
                "type": "string",
                "description": "Human-readable title"
              },
              "description": {
                "type": "string",
                "description": "Tool description shown to the LLM"
              },
              "prompt": {
                "type": "string",
                "description": "Full system prompt for the sub-agent"
              },
              "visible_tools": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Tools this sub-agent can see. Omit for all tools."
              },
              "catalyst_ref": {
                "type": "string",
                "description": "Catalyst reference for this sub-agent (resolved by harness)"
              },
              "model": {
                "type": "string",
                "description": "Model for this sub-agent"
              }
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "turns": {
          "type": "integer"
        },
        "messages": {
          "type": "array",
          "description": "Full conversation history including tool_use/tool_result pairs"
        },
        "component_ref": {
          "type": "string"
        },
        "usage": {
          "type": "object",
          "description": "Accumulated token usage across all turns",
          "properties": {
            "input_tokens": {
              "type": "integer"
            },
            "output_tokens": {
              "type": "integer"
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "name": "General task with Claude",
      "input": {
        "catalyst_ref": "catalyst:moonmoon69.claude:1.0.0",
        "model": "claude-sonnet-4-5-20250514",
        "task": "List all Rust files in components/ and describe what each does",
        "system": "You are an agent running inside CYFR, a governed computation platform."
      }
    }
  ],
  "caps": {
    "tools": [
      "tools.list",
      "execution.run",
      "execution.list",
      "execution.logs",
      "execution.status",
      "execution.cancel",
      "execution.run_stream",
      "component.search",
      "component.inspect",
      "component.list",
      "component.categories",
      "component.pull",
      "component.create",
      "build.compile",
      "build.toolchains",
      "aqua.list",
      "aqua.get",
      "aqua.create",
      "aqua.update",
      "aqua.delete",
      "config.get",
      "config.get_all",
      "config.list",
      "system.status",
      "storage.read",
      "storage.write",
      "storage.list",
      "schedule.create",
      "schedule.list",
      "schedule.pause",
      "schedule.resume",
      "schedule.delete",
      "component.setup_plan",
      "external.call",
      "mcp_servers.list",
      "mcp_servers.get",
      "mcp_servers.test",
      "mcp_servers.refresh"
    ],
    "limits": {
      "timeout": "15m",
      "max_concurrent_tasks": 30,
      "max_request_size": 5242880,
      "max_response_size": 5242880,
      "batch_timeout": "5m"
    }
  }
}
