{
  "name": "agent",
  "type": "formula",
  "version": "0.6.0",
  "publisher": "local",
  "description": "Generic multi-provider agentic loop with tool use",
  "setup": {
    "policy": {
      "allowed_tools": [
        "execution.run",
        "component.search",
        "component.inspect",
        "component.list",
        "build.compile_and_save",
        "build.toolchains",
        "secret.list",
        "policy.show",
        "policy.list",
        "system.status"
      ],
      "timeout": "10m",
      "max_concurrent_tasks": 10,
      "batch_timeout": "5m"
    }
  },
  "dependencies": {
    "static": [
      {
        "ref": "catalyst:local.files:0.1.0",
        "optional": false,
        "reason": "File operations"
      }
    ]
  },
  "schema": {
    "input": {
      "type": "object",
      "required": ["catalyst_ref", "model", "task", "system"],
      "properties": {
        "catalyst_ref": {
          "type": "string",
          "description": "LLM catalyst reference, e.g. catalyst:local.claude:1.0.0"
        },
        "model": {
          "type": "string",
          "description": "Model identifier (e.g. claude-sonnet-4-5-20250514)"
        },
        "task": {
          "type": "string",
          "description": "Task or follow-up message"
        },
        "system": {
          "type": "string",
          "description": "Full system prompt (caller-composed)"
        },
        "messages": {
          "type": "array",
          "description": "Conversation history for continuation"
        },
        "files_ref": {
          "type": "string",
          "default": "catalyst:local.files:0.1.0",
          "description": "Files catalyst reference"
        },
        "max_turns": {
          "type": "integer",
          "default": 30,
          "description": "Maximum agentic loop turns"
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "content": { "type": "string" },
        "turns": { "type": "integer" },
        "messages": {
          "type": "array",
          "description": "Full conversation history including tool_use/tool_result pairs"
        },
        "component_ref": { "type": "string" }
      }
    }
  },
  "examples": [
    {
      "name": "General task with Claude",
      "input": {
        "catalyst_ref": "catalyst:local.claude:1.0.0",
        "model": "claude-sonnet-4-5-20250514",
        "task": "List all Rust files in components/ and describe what each does",
        "system": "You are an agent running inside CYFR, a governed computation platform."
      }
    }
  ]
}
