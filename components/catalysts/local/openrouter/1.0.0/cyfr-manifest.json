{
  "name": "openrouter",
  "version": "1.0.0",
  "type": "catalyst",
  "publisher": "local",
  "description": "OpenRouter API — unified access to 400+ AI models with automatic fallback",
  "schema": {
    "input": {
      "type": "object",
      "required": ["operation"],
      "properties": {
        "operation": {
          "enum": [
            "chat.completions.create",
            "models.list",
            "embeddings.create",
            "credits.get",
            "key.info"
          ]
        },
        "stream": {
          "type": "boolean",
          "description": "Enable streaming for chat completions"
        },
        "params": {
          "type": "object",
          "description": "Operation-specific parameters"
        }
      }
    },
    "output": {
      "type": "object"
    }
  },
  "examples": [
    {
      "name": "Chat completion",
      "input": {
        "operation": "chat.completions.create",
        "params": {
          "model": "anthropic/claude-sonnet-4",
          "messages": [{"role": "user", "content": "Hello"}]
        }
      },
      "output": {
        "status": 200,
        "data": {
          "choices": [{"message": {"content": "Hi!"}}]
        }
      }
    },
    {
      "name": "Streaming chat",
      "input": {
        "operation": "chat.completions.create",
        "stream": true,
        "params": {
          "model": "meta-llama/llama-3.1-8b-instruct:free",
          "messages": [{"role": "user", "content": "Count to 5"}]
        }
      },
      "output": {
        "status": 200,
        "data": {
          "chunks": ["..."],
          "combined_text": "1, 2, 3, 4, 5"
        }
      }
    },
    {
      "name": "List models",
      "input": {"operation": "models.list", "params": {}},
      "output": {"status": 200, "data": {"data": ["..."]}}
    },
    {
      "name": "Check credits",
      "input": {"operation": "credits.get", "params": {}},
      "output": {"status": 200, "data": {"total_credits": 10.0, "total_usage": 1.5}}
    }
  ],
  "wasi": {
    "http": true,
    "secrets": true,
    "streaming": true
  },
  "setup": {
    "secrets": [
      {
        "name": "OPENROUTER_API_KEY",
        "description": "API key from https://openrouter.ai/settings/keys",
        "required": true
      }
    ],
    "policy": {
      "allowed_domains": ["openrouter.ai"],
      "allowed_methods": ["GET", "POST"],
      "rate_limit": {"requests": 100, "window": "1m"},
      "timeout": "3m",
      "max_response_size": 5242880
    }
  },
  "defaults": {
    "base_url": "https://openrouter.ai/api/v1"
  }
}
