package cyfr:catalyst@0.1.0;

interface run {
    /// Execute the catalyst with JSON input, returning JSON output.
    ///
    /// The input is `{"operation": "...", "params": {...}}` and the output
    /// `{"status": N, "data": ...}` or `{"status": N, "error": {"type",
    /// "message"}}`. A manifest may declare `contracts` — named sets of
    /// operations a host asks for by name; `model/chat@1` is `chat`,
    /// `describe` and `models` (see component-guide.md, "Model catalysts").
    run: func(input: string) -> string;
}

world catalyst {
    export run;
    import cyfr:http/fetch@0.1.0;
    import cyfr:http/streaming@0.1.0;
    import cyfr:vault/read@0.1.0;
    import cyfr:storage/files@0.1.0;
    import cyfr:oauth/token@0.1.0;
    import cyfr:emit/events@0.1.0;
}
