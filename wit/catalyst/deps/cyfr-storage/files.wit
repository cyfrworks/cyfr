package cyfr:storage@0.1.0;

/// File storage operations in the running component's athanor, which the
/// host takes from the execution and never from a request: a path is
/// relative to that athanor's tree. The host checks each request against
/// the storage the component's consent edge grants: the action must be one
/// of its storage actions and the path one its storage paths allow, under a
/// guest scope (`data/` or `components/`), relative and with no traversal.
/// Input and output are JSON-encoded strings.
interface files {
    /// Execute a storage operation. JSON format:
    /// Read:   {"action": "read", "path": "data/file.txt"}
    /// Write:  {"action": "write", "path": "data/file.txt", "content": "<base64>"}
    /// Append: {"action": "append", "path": "data/log.txt", "content": "<base64>"}
    /// List:   {"action": "list", "path": "data/"}
    /// Delete: {"action": "delete", "path": "data/file.txt"}
    /// Exists: {"action": "exists", "path": "data/file.txt"}
    ///
    /// Response: {"status": "ok", ...} or {"error": {"type": "...", "message": "..."}}
    call: func(json-request: string) -> string;
}
