#
# The guest kernel's options beside Firecracker's microVM configuration
# (its microvm-kernel-ci-x86_64-6.18.config and ci.config at the pinned
# release), merged over them in Dockerfile.locus's guest-kernel stage.
#
# The guard's rules inside the guest: IPv6 nftables for its ip6tables, and
# ctnetlink for its connection table. Firecracker's configuration has
# neither.
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
# Each session's memory bound is a cgroup of its own inside the guest.
CONFIG_MEMCG=y
# A finished session's memory goes back to the host while the guest runs:
# the balloon device's free-page reporting, from order 0 by the boot
# argument the launcher gives (internal/vm).
CONFIG_VIRTIO_BALLOON=y
CONFIG_PAGE_REPORTING=y
