{
  "version": 1,
  "system": {
    "id": "ubuntu",
    "version_id": "26.04",
    "codename": "resolute",
    "name": "Ubuntu 26.04 LTS",
    "architectures": ["amd64", "arm64"]
  },
  "universe": {
    "component": "universe",
    "command": "sudo add-apt-repository universe"
  },
  "bootstrap": [
    {"package": "ca-certificates", "installed": "ca-certificates", "universe": false},
    {"package": "curl", "commands": ["curl", "wget"], "universe": false},
    {"package": "cosign", "commands": ["cosign"], "universe": true}
  ],
  "docker": {
    "packages": [
      {"package": "docker.io", "universe": true},
      {"package": "docker-compose-v2", "universe": true},
      {"package": "apparmor", "universe": false}
    ],
    "minimum_major": 28,
    "group": "docker",
    "service": "docker.service",
    "endpoint": "unix:///var/run/docker.sock"
  },
  "install_path": "/usr/local/bin/cyfr",
  "lock": {
    "path": "/run/cyfr-install.lock",
    "seconds": 60
  }
}
