#
# The AppArmor profile every Locus container runs under, on a host with
# AppArmor. Its name carries its content: the name below, its twelve
# digits zeros, is a placeholder, which each load replaces with cyfr-locus-
# and the first 12 hex digits of the SHA-256 of this text as it stands
# (package apparmor's Name; the file name beside it holds the result). It is built into cyfr:
# `cyfr init` and `update` write it to /etc/apparmor.d/<its name> and load
# it, so it is loaded at every boot; .env's CYFR_LOCUS_APPARMOR names it to
# docker-compose.yml's `security_opt`, Docker refuses a container whose
# named profile is not loaded, and the keeper proves at its boot that it
# runs under its image's name (cyfr-locus's stage.Confinement).
# Docker's default profile with four changes:
#   1. `userns,`: the keeper gives every spawn a user namespace of its own,
#      and the spawn holds its capabilities inside it alone.
#   2. In place of `deny mount,`: the mounts a stage makes while it builds
#      its space's files under /var/lib/locus/space, and its pivot into them.
#      Nothing else is mounted, by the keeper or by a space.
#   3. The container runs with `systempaths=unconfined`, since a /proc that
#      Docker has masked lets no one mount a fresh one: what Docker masks is
#      denied here instead, no read, and what it makes read-only, no write,
#      to the keeper and to every space (Docker's two lists are
#      cyfr-locus's internal/stage/docker_paths.json, which its tests hold
#      this profile to).
#   4. `unix` and POSIX message queues, which the newer rule set refuses
#      otherwise: a space's queues are its own IPC namespace's and end with
#      it, and the keeper reads what a spawn left in the container's.
abi <abi/4.0>,
include <tunables/global>

profile cyfr-locus-000000000000 flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>

  network,
  capability,
  file,
  umount,
  unix,
  userns,
  mqueue type=posix,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=cyfr-locus-000000000000,
  ptrace (trace,read,tracedby,readby) peer=cyfr-locus-000000000000,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/** w,
  deny @{PROC}/bus/** w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/{,**} rwklx,
  deny /sys/devices/virtual/powercap/{,**} rwklx,
  deny /sys/devices/system/cpu/cpu*/thermal_throttle/{,**} rwklx,
  deny /sys/kernel/security/** rwklx,

  deny @{PROC}/{acpi,asound,scsi}/{,**} rwklx,
  deny @{PROC}/{interrupts,keys,latency_stats,timer_list,timer_stats,sched_debug} rwklx,

  mount options=(rw,rprivate) -> /,
  mount fstype=tmpfs -> /var/lib/locus/space/,
  mount fstype=tmpfs -> /var/lib/locus/space/**,
  mount fstype=proc -> /var/lib/locus/space/proc/,
  mount fstype=sysfs -> /var/lib/locus/space/sys/,
  mount fstype=cgroup2 -> /var/lib/locus/space/sys/fs/cgroup/,
  mount fstype=devpts -> /var/lib/locus/space/dev/pts/,
  mount options=(rw,rbind) -> /var/lib/locus/space/**,
  mount options=(rw,bind) /dev/* -> /var/lib/locus/space/dev/*,
  pivot_root oldroot=/var/lib/locus/space/.old/ /var/lib/locus/space/,
}
