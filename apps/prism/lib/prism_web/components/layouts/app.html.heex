<div class="flex h-screen overflow-hidden bg-gray-950">
  <!-- Sidebar -->
  <nav class="hidden lg:flex lg:flex-shrink-0">
    <div class="flex w-64 flex-col">
      <div class="flex min-h-0 flex-1 flex-col border-r border-gray-800 bg-gray-900">
        <!-- Logo -->
        <div class="flex h-16 flex-shrink-0 items-center px-4 border-b border-gray-800">
          <span class="text-xl font-bold text-white tracking-tight">Prism</span>
          <span class="ml-2 text-xs text-gray-500">CYFR</span>
        </div>

        <!-- Navigation -->
        <div class="flex flex-1 flex-col overflow-y-auto pt-3 pb-4">
          <nav class="flex-1 space-y-1 px-3">
            <.nav_link href={~p"/"} icon="home" label="Dashboard" />
            <.nav_link href={~p"/agent"} icon="play" label="Agent" />

            <div class="pt-4 pb-1">
              <p class="px-3 text-xs font-semibold uppercase tracking-wider text-gray-500">
                Operations
              </p>
            </div>
            <.nav_link href={~p"/executions"} icon="play" label="Executions" />
            <.nav_link href={~p"/logs"} icon="document" label="Logs" />
            <.nav_link href={~p"/components"} icon="cube" label="Components" />
            <span class="group flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium text-gray-600 cursor-not-allowed" title="Coming soon">
              <.icon name="wrench" class="h-5 w-5 text-gray-700" />
              Builds
            </span>

            <div class="pt-4 pb-1">
              <p class="px-3 text-xs font-semibold uppercase tracking-wider text-gray-500">
                Governance
              </p>
            </div>
            <.nav_link href={~p"/secrets"} icon="key" label="Secrets" />
            <.nav_link href={~p"/keys"} icon="lock" label="API Keys" />


            <div class="pt-4 pb-1">
              <p class="px-3 text-xs font-semibold uppercase tracking-wider text-gray-500">
                System
              </p>
            </div>
            <.nav_link href={~p"/settings"} icon="cog" label="Settings" />
          </nav>
        </div>

        <!-- User info -->
        <div :if={assigns[:current_user]} class="flex flex-shrink-0 border-t border-gray-800 p-4">
          <div class="flex items-center w-full">
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-300 truncate">
                {@current_user.email || @current_user.id}
              </p>
              <p class="text-xs text-gray-500 truncate">{@current_user.provider}</p>
            </div>
            <a href={~p"/auth/logout"} class="ml-3 text-gray-500 hover:text-gray-300">
              <.icon name="logout" class="h-5 w-5" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main content -->
  <div class="flex flex-1 flex-col overflow-hidden">
    <!-- Top bar -->
    <div class="flex h-16 flex-shrink-0 border-b border-gray-800 bg-gray-900">
      <div class="flex flex-1 items-center justify-between px-4 lg:px-8">
        <h1 class="text-lg font-semibold text-white">{assigns[:page_title] || "Prism"}</h1>
      </div>
    </div>

    <!-- Flash messages -->
    <div class="px-4 lg:px-8">
      <.flash :if={Phoenix.Flash.get(@flash, :info)} kind={:info}>
        {Phoenix.Flash.get(@flash, :info)}
      </.flash>
      <.flash :if={Phoenix.Flash.get(@flash, :error)} kind={:error}>
        {Phoenix.Flash.get(@flash, :error)}
      </.flash>
    </div>

    <!-- Page content -->
    <main class="flex-1 overflow-y-auto p-4 lg:p-8">
      {@inner_content}
    </main>
  </div>
</div>
