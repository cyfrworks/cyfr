{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "A.Q.U.A.",
  "version": "0.2.0",
  "identifier": "com.cyfrworks.aqua",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "boot",
        "title": "A.Q.U.A.",
        "width": 480,
        "height": 420,
        "decorations": false,
        "center": true,
        "resizable": false,
        "url": "boot/index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:4000 http://localhost:4001 ws://localhost:4001; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; frame-src http://localhost:4001"
    },
    "trayIcon": null
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./entitlements.plist",
      "signingIdentity": null,
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
