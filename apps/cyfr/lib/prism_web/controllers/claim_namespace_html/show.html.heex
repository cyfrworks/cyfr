<div class="min-h-screen flex items-center justify-center bg-gray-950 px-4">
  <div class="max-w-md w-full space-y-6">
    <div class="text-center">
      <p class="text-sm text-indigo-300/70 uppercase tracking-[0.3em] mb-4">One more thing&hellip;</p>
      <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-indigo-300 leading-tight">
        Claim your cyfr.run namespace
      </h1>
    </div>

    <div class="bg-gray-900 rounded-lg shadow-xl p-8 space-y-4">
      <p class="text-sm text-gray-400 leading-relaxed">
        Your namespace is your name everywhere CYFR runs: it is bound to the identity you signed in
        with, once. Lowercase letters, digits and single hyphens (1–39 characters); bare — no dot,
        no <code class="text-gray-300">@</code>. Examples:
        <code class="text-gray-300">alice</code>, <code class="text-gray-300">bob-123</code>.
      </p>

      <div
        :if={@error}
        class="rounded-lg bg-red-900/50 border border-red-800 px-4 py-3 text-sm text-red-300"
      >
        {@error}
      </div>

      <form method="post" action="/claim-namespace/submit" class="space-y-4">
        <input type="hidden" name="_csrf_token" value={@csrf_token} />
        <div>
          <label for="username" class="block text-xs font-medium text-gray-400 mb-1">
            Namespace
          </label>
          <input
            id="username"
            type="text"
            name="username"
            value={@suggested}
            pattern={@pattern}
            minlength="1"
            maxlength="39"
            required
            autofocus
            autocomplete="off"
            class="w-full rounded-md border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white placeholder-gray-500 focus:border-indigo-500 focus:outline-none"
          />
        </div>
        <button
          type="submit"
          class="w-full px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-sm font-medium transition-colors"
        >
          Claim namespace
        </button>
      </form>
    </div>
  </div>
</div>
