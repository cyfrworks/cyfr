<div class="min-h-screen bg-gray-950 px-4 py-10">
  <div class="max-w-3xl mx-auto space-y-6">
    <div class="text-center">
      <p class="text-sm text-indigo-300/70 uppercase tracking-[0.3em] mb-4">Before you publish&hellip;</p>
      <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-indigo-300 leading-tight">
        Accept the cyfr.run policies
      </h1>
      <p class="mt-3 text-sm text-gray-400">
        Review and accept the policies below. You are accepting bundle version
        <code class="text-gray-300">{@version}</code>.
      </p>
    </div>

    <div
      :if={@error}
      class="rounded-lg bg-red-900/50 border border-red-800 px-4 py-3 text-sm text-red-300"
    >
      {@error}
    </div>

    <div class="space-y-2">
      <details
        :for={{{name, title, body}, index} <- Enum.with_index(@bodies)}
        id={"policy-" <> name}
        class="bg-gray-900 rounded-lg border border-gray-800"
        open={index == 0}
      >
        <summary class="cursor-pointer select-none px-4 py-3 text-sm font-medium text-gray-200">
          {title}
        </summary>
        <pre class="max-h-96 overflow-auto whitespace-pre-wrap px-4 pb-4 text-xs leading-relaxed text-gray-400 font-mono">{body}</pre>
      </details>
    </div>

    <form method="post" action="/legal/accept/submit" class="bg-gray-900 rounded-lg shadow-xl p-6 space-y-3">
      <input type="hidden" name="_csrf_token" value={@csrf_token} />
      <input type="hidden" name="policy_version" value={@version} />
      <input type="hidden" name="provider" value={@provider} />
      <input type="hidden" name="policies" value={Enum.map_join(@bodies, ",", &elem(&1, 0))} />
      <fieldset class="space-y-2">
        <legend class="text-sm font-medium text-gray-200 mb-2">Acknowledgements</legend>
        <label
          :for={{name, title, _body} <- @bodies}
          class="flex items-start gap-2 text-sm text-gray-300"
        >
          <input
            type="checkbox"
            name={ack_field(name)}
            value="on"
            required
            class="mt-0.5 rounded border-gray-700 bg-gray-950 text-indigo-500 focus:ring-indigo-500"
          /> I have read and agree to the {title}.
        </label>
      </fieldset>
      <button
        type="submit"
        class="w-full px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-sm font-medium transition-colors"
      >
        Accept and continue
      </button>
    </form>
  </div>
</div>
