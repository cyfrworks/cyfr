<div class="min-h-screen flex items-center justify-center bg-gray-950 px-4">
  <div class="max-w-md w-full space-y-6">
    <div class="text-center">
      <h1 class="text-2xl font-extrabold tracking-tight text-indigo-200/80">Couldn't continue</h1>
    </div>
    <div class="bg-gray-900 rounded-lg shadow-xl p-8 space-y-4">
      <div class="rounded-lg bg-red-900/50 border border-red-800 px-4 py-3 text-sm text-red-300">
        {@message}
      </div>
      <p class="text-sm text-gray-400">
        <a href="/legal/accept" class="text-indigo-300 hover:underline">Try again</a>
        · <a href="/login" class="text-indigo-300 hover:underline">Sign in again</a>
      </p>
    </div>
  </div>
</div>
