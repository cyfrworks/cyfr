<div class="flex h-screen overflow-hidden bg-gray-950">
  <!-- Sidebar -->
  <nav class="hidden lg:flex lg:flex-shrink-0">
    <div class="flex w-64 flex-col">
      <div class="flex min-h-0 flex-1 flex-col border-r border-gray-800 bg-gray-900">
        <!-- Logo -->
        <div class="flex h-16 flex-shrink-0 items-center px-4 border-b border-gray-800 gap-2">
          <img src={~p"/images/logo.jpg"} alt="CYFR" class="h-8 w-8 rounded-lg" />
          <span class="text-xl font-bold text-white tracking-tight">CYFR</span>
        </div>

        <!-- Mode tabs -->
        <div class="flex border-b border-gray-800">
          <.link navigate={~p"/"} class={[
            "flex-1 text-center py-2.5 text-sm font-medium border-b-2 transition-colors",
            if(assigns[:active_nav] != "tinctures",
              do: "border-blue-500 text-blue-300",
              else: "border-transparent text-gray-500 hover:text-gray-300"
            )
          ]}>
            Dashboard
          </.link>
          <.link navigate={~p"/tinctures"} class={[
            "flex-1 text-center py-2.5 text-sm font-medium border-b-2 transition-colors",
            if(assigns[:active_nav] == "tinctures",
              do: "border-blue-500 text-blue-300",
              else: "border-transparent text-gray-500 hover:text-gray-300"
            )
          ]}>
            Tinctures
          </.link>
        </div>

        <!-- Navigation (Dashboard mode) -->
        <div :if={assigns[:active_nav] != "tinctures"} class="flex flex-1 flex-col overflow-y-auto pt-3 pb-4">
          <nav class="flex-1 space-y-1 px-3">
            <.nav_link href={~p"/"} icon="play" label="Ask AQUA" active={assigns[:active_nav] == "agent"} />

            <div class="pt-4 pb-1">
              <p class="px-3 text-xs font-semibold uppercase tracking-wider text-gray-500">
                Workflows
              </p>
            </div>
            <.nav_link href={~p"/executions"} icon="play" label="Executions" active={assigns[:active_nav] == "executions"} />
            <.nav_link href={~p"/schedules"} icon="clock" label="Schedules" active={assigns[:active_nav] == "schedules"} />
            <.nav_link href={~p"/logs"} icon="document" label="Server Logs" active={assigns[:active_nav] == "logs"} />

            <div class="pt-4 pb-1">
              <p class="px-3 text-xs font-semibold uppercase tracking-wider text-gray-500">
                Registry
              </p>
            </div>
            <.nav_link href={~p"/components"} icon="cube" label="Components" active={assigns[:active_nav] == "components"} />
            <.nav_link href={~p"/builds"} icon="wrench" label="Builds" active={assigns[:active_nav] == "builds"} />

            <div class="pt-4 pb-1">
              <p class="px-3 text-xs font-semibold uppercase tracking-wider text-gray-500">
                Security
              </p>
            </div>
            <.nav_link href={~p"/secrets"} icon="key" label="Secrets" active={assigns[:active_nav] == "secrets"} />
            <.nav_link href={~p"/keys"} icon="lock" label="API Keys" active={assigns[:active_nav] == "keys"} />

            <div class="pt-4 pb-1">
              <p class="px-3 text-xs font-semibold uppercase tracking-wider text-gray-500">
                Integrations
              </p>
            </div>
            <.nav_link href={~p"/mcp-servers"} icon="globe" label="MCP Servers" active={assigns[:active_nav] == "mcp_servers"} />

            <div class="pt-4 pb-1">
              <p class="px-3 text-xs font-semibold uppercase tracking-wider text-gray-500">
                System
              </p>
            </div>
            <.nav_link href={~p"/settings"} icon="cog" label="Settings" active={assigns[:active_nav] == "settings"} />
          </nav>
        </div>

        <!-- Tinctures list (Tinctures mode) -->
        <div :if={assigns[:active_nav] == "tinctures"} class="flex flex-1 flex-col overflow-y-auto pt-3 pb-4">
          <div class="flex justify-end px-3 pb-1">
            <button
              phx-click="refresh_tinctures"
              title="Register & refresh"
              class="p-1 rounded text-gray-500 hover:text-gray-300 hover:bg-gray-700"
            >
              <.icon name="refresh" class="h-3.5 w-3.5" />
            </button>
          </div>
          <nav class="flex-1 space-y-1 px-3">
            <div :for={tincture <- assigns[:tinctures] || []} class="relative">
              <div class="flex items-center">
                <button
                  phx-click="select_tincture"
                  phx-value-tincture={tincture.id}
                  class={[
                    "flex-1 min-w-0 px-3 py-2 rounded-lg text-left transition-colors text-sm font-medium truncate",
                    if(tincture.id == assigns[:active_tincture],
                      do: "bg-blue-600/20 text-blue-300",
                      else: "text-gray-300 hover:bg-gray-800 hover:text-white"
                    )
                  ]}
                >
                  <span class="flex items-center gap-2">
                    <span class="truncate">{tincture.name}</span>
                    <span
                      :if={Map.get(tincture, :public, false)}
                      class="flex-shrink-0 text-[10px] px-1.5 py-0.5 rounded bg-green-900/50 text-green-400 font-medium"
                    >
                      public
                    </span>
                  </span>
                </button>
                <div class="flex-shrink-0 flex items-center">
                  <button
                    id={"info-btn-#{tincture.id}"}
                    phx-click="toggle_tooltip"
                    phx-value-tincture={tincture.id}
                    class="p-1 rounded text-gray-600 hover:text-gray-400"
                  >
                    <.icon name="info" class="h-3.5 w-3.5" />
                  </button>
                  <button
                    phx-click="toggle_menu"
                    phx-value-tincture={tincture.id}
                    class="p-1 rounded text-gray-500 hover:text-gray-300 hover:bg-gray-700"
                  >
                    <.icon name="dots-vertical" class="h-4 w-4" />
                  </button>
                </div>
              </div>
              <!-- Dropdown menu -->
              <div
                :if={assigns[:menu_open] == tincture.id}
                phx-click-away="close_menu"
                class="absolute right-0 top-full z-50 mt-1 w-48 rounded-lg bg-gray-800 border border-gray-700 shadow-xl py-1"
              >
                <button
                  phx-click="toggle_visibility"
                  phx-value-tincture={tincture.id}
                  class="w-full px-3 py-2 text-left text-sm text-gray-300 hover:bg-gray-700 flex items-center gap-2"
                >
                  <.icon name={if Map.get(tincture, :public, false), do: "lock", else: "globe"} class="h-4 w-4" />
                  {if Map.get(tincture, :public, false), do: "Make Private", else: "Make Public"}
                </button>
                <button
                  :if={Map.get(tincture, :public, false)}
                  phx-click="copy_url"
                  phx-value-tincture={tincture.id}
                  class="w-full px-3 py-2 text-left text-sm text-gray-300 hover:bg-gray-700 flex items-center gap-2"
                >
                  <.icon name="link" class="h-4 w-4" />
                  Copy Public URL
                </button>
              </div>
            </div>
            <p :if={(assigns[:tinctures] || []) == []} class="text-sm text-gray-600 px-3 py-2">
              No tinctures installed
            </p>
          </nav>
        </div>

        <!-- User info -->
        <div :if={assigns[:current_user]} class="flex flex-shrink-0 border-t border-gray-800 p-4">
          <div class="flex items-center w-full">
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-300 truncate">
                {@current_user.email || @current_user.id}
              </p>
              <p class="text-xs text-gray-500 truncate">{@current_user.provider}</p>
            </div>
            <a href={~p"/auth/logout"} class="ml-3 text-gray-500 hover:text-gray-300">
              <.icon name="logout" class="h-5 w-5" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main content -->
  <div class="flex flex-1 flex-col overflow-hidden">
    <.flash_group flash={@flash} />

    <!-- Page content -->
    <main class="flex-1 flex flex-col min-h-0 overflow-y-auto p-4 lg:p-8">
      <div class="flex-1 min-h-0">
        {@inner_content}
      </div>
    </main>
  </div>
</div>
