<%!-- The page's layer over the desktop (`PrismWeb.ShellLive`, the root
      layout's): it takes no pointer where it draws nothing, so the desktop
      under it stays live. --%>
<div id="page-layer" class="pointer-events-none absolute inset-0 flex flex-col">
  <% mode = Prism.Labels.mode(assigns[:ui_mode]) %>
  <% overlay? = assigns[:overlay] != false %>
  <!-- The chrome: brand, the drawer, the person — and in dev the live indicators. -->
  <div id="chrome-top" class="pointer-events-auto relative z-[66] shrink-0">
    {live_render(@socket, PrismWeb.TopbarLive,
      id: "topbar",
      session: %{
        "athanor_id" => assigns[:athanor] && @athanor.id,
        "ui_mode" => mode
      }
    )}
  </div>

  <div class="pointer-events-auto">
    <.flash_group flash={@flash} />
  </div>
  <!-- The command palette (⌘⇧K, the topbar's search icon, the drawer's
       Search… row). The companion JS hook listens for the shortcut and
       pushes toggle/close into this component. -->
  <div class="pointer-events-auto">
    <.live_component
      :if={assigns[:context]}
      module={PrismWeb.CommandPaletteLiveComponent}
      id="command-palette"
      context={@context}
      athanor_route={assigns[:athanor_route]}
      active_context={assigns[:active_context]}
      ui_mode={mode}
    />
  </div>

  <div class="pointer-events-auto">
    <.drawer mode={mode} athanor_route={@athanor_route} active_nav={assigns[:active_nav]} />
  </div>

  <%!-- A Dashboard page: an overlay over the desktop's apps' area, from the
        top bar to the shelf, which stays in reach. A panel inset on the
        desk, the whole area in the hand. Opening one is a move within the
        session, never a page load, so the desktop's frames keep running
        under it; its close goes back to the desktop. --%>
  <section
    :if={overlay?}
    id="settings-overlay"
    aria-label={assigns[:page_title] || "Settings"}
    class="settings-overlay pointer-events-auto z-[65] flex overflow-hidden bg-gray-950 text-gray-200"
  >
    <.sidebar
      :if={Prism.Labels.dev?(mode)}
      mode={mode}
      athanor_route={@athanor_route}
      active_nav={assigns[:active_nav]}
    />
    <div class="relative flex min-w-0 flex-1 flex-col">
      <.link
        id="settings-close"
        navigate={PrismWeb.DesktopLive.path(@athanor_route)}
        class="absolute right-2 top-2 z-10 rounded-md px-2 py-1 text-sm text-gray-400 hover:bg-gray-800 hover:text-gray-200"
        aria-label="Back to the desktop"
        title="Back to the desktop"
      >
        ×
      </.link>
      <main class="relative flex min-h-0 flex-1 flex-col overflow-y-auto p-4 lg:p-8">
        <div
          id="page-loading"
          phx-hook="PageLoadingIndicator"
          class="hidden absolute inset-0 z-20 flex items-center justify-center bg-gray-950/40 backdrop-blur-[1px] pointer-events-none"
        >
          <div class="flex items-center gap-3 text-sm text-gray-300">
            <svg class="h-5 w-5 animate-spin text-blue-400" fill="none" viewBox="0 0 24 24">
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"
              >
              </circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
              >
              </path>
            </svg>
            <span>Loading…</span>
          </div>
        </div>
        <div id="page-content" class="flex-1 min-h-0">
          {@inner_content}
        </div>
      </main>
    </div>
  </section>
  <%!-- The desktop's own address draws no overlay: only what its page
        holds, its system layer, whose prompts the browser draws in its top
        layer and which takes the pointer it is drawn under. --%>
  <div :if={not overlay?} id="page-content" class="contents pointer-events-auto">
    {@inner_content}
  </div>
</div>
