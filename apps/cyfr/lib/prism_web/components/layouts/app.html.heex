<div class="flex h-screen flex-col overflow-hidden bg-gray-950">
  <% mode = Prism.Labels.mode(assigns[:ui_mode]) %>
  <!-- The chrome: brand, the athanor switcher, the drawer, the person — and in dev the live indicators -->
  {live_render(@socket, PrismWeb.TopbarLive,
    id: "topbar",
    session: %{"athanor_id" => assigns[:athanor] && @athanor.id, "ui_mode" => mode}
  )}

  <!-- Body row: sidebar (dev, wide screens) + drawer (both modes) + main content -->
  <div class="flex flex-1 overflow-hidden">
    <.sidebar
      :if={Prism.Labels.dev?(mode)}
      mode={mode}
      athanor_route={@athanor_route}
      active_nav={assigns[:active_nav]}
    />
    <.drawer mode={mode} athanor_route={@athanor_route} active_nav={assigns[:active_nav]} />

    <!-- Main content -->
    <div class="flex flex-1 flex-col overflow-hidden">
      <.flash_group flash={@flash} />
      <!-- The command palette (⌘⇧K, the topbar's search icon, the drawer's
           Search… row). The companion JS hook listens for the shortcut and
           pushes toggle/close into this component. -->
      <.live_component
        :if={assigns[:context]}
        module={PrismWeb.CommandPaletteLiveComponent}
        id="command-palette"
        context={@context}
        active_context={assigns[:active_context]}
        ui_mode={mode}
      />

      <!-- Page content -->
      <main class={[
        "relative flex-1 flex flex-col min-h-0 overflow-y-auto",
        if(assigns[:active_nav] in ["tinctures", "chat"], do: "p-0", else: "p-4 lg:p-8")
      ]}>
        <div
          id="page-loading"
          phx-hook="PageLoadingIndicator"
          class="hidden absolute inset-0 z-20 flex items-center justify-center bg-gray-950/40 backdrop-blur-[1px] pointer-events-none"
        >
          <div class="flex items-center gap-3 text-sm text-gray-300">
            <svg class="h-5 w-5 animate-spin text-blue-400" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span>Loading…</span>
          </div>
        </div>
        <div id="page-content" class="flex-1 min-h-0">
          {@inner_content}
        </div>
      </main>
    </div>
  </div>
</div>
