<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-950">
  <.document_head page_title={assigns[:page_title]} />
  <body class="relative h-full overflow-hidden antialiased text-gray-200">
    <%!-- The person's desktop: a LiveView of its own beside the page's, so a
          move between the session's pages, which replaces the page's
          LiveView alone, never moves or reloads a frame the desktop holds.
          It fills the screen under the top bar; the page's layer
          (`app.html.heex`) draws the top bar and, for a Dashboard page, the
          page as an overlay over the desktop. --%>
    {live_render(desktop_conn(@conn), PrismWeb.ShellLive,
      id: "desktop",
      container: {:div, class: "absolute inset-x-0 bottom-0 top-12"}
    )}
    {@inner_content}
  </body>
</html>
