<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
<div class="h-screen w-screen overflow-hidden bg-gray-950">
  <%!-- Flash messages (floating above shell) --%>
  <div class="fixed top-4 right-4 z-[99999] space-y-2">
    <.flash :if={Phoenix.Flash.get(@flash, :info)} kind={:info}>
      {Phoenix.Flash.get(@flash, :info)}
    </.flash>
    <.flash :if={Phoenix.Flash.get(@flash, :error)} kind={:error}>
      {Phoenix.Flash.get(@flash, :error)}
    </.flash>
  </div>

  {@inner_content}
</div>
