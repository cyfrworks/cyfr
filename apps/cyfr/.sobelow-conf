# Sobelow gate: fail CI on any High-confidence finding (`exit: "high"`).
# Medium/Low findings still print for humans but do not gate.
#
# Ignored checks — each is a structural false positive here, verified:
#   Config.CSP       — Content-Security-Policy is set by our own pipeline
#                      plugs (EmissaryWeb.Plugs.BrowserCSP on :browser,
#                      EmissaryWeb.Plugs.ApiSecurityHeaders on the API/MCP
#                      pipelines), which Sobelow's scan does not recognise
#                      as a CSP source.
#   Config.Headers   — the :tincture pipelines deliberately skip
#                      put_secure_browser_headers; the tincture controller
#                      sets its own CSP/sandbox headers (frame-ancestors
#                      'self' plus the allow-scripts-only iframe pin).
#   Config.CSRFRoute — GET+POST mapped to `method_not_allowed` is the
#                      deliberate 405 responder for /mcp, not action reuse.
# `skip: true` honors inline `# sobelow_skip [...]` annotations, each of
# which carries its own justification comment at the call site.
[
  verbose: false,
  private: false,
  skip: true,
  router: "",
  exit: "high",
  format: "txt",
  out: "",
  threshold: "low",
  ignore: ["Config.CSP", "Config.Headers", "Config.CSRFRoute"],
  ignore_files: [],
  version: false
]
