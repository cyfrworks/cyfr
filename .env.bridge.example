# Bridge-container settings. Copy to .env.bridge to override defaults.
# CYFR_MCP_BRIDGE_KEY is not set here: compose passes it from the project
# .env, where cyfr reads the same value. Keep application credentials out of
# this file; backends receive only the environment their server row defines.

# Port inside the container (default 8001; never published to the host).
# MCP_BRIDGE_PORT=8001

# Per-call and handshake timeouts for stdio backends, in milliseconds.
# MCP_BRIDGE_RPC_TIMEOUT_MS=30000
# MCP_BRIDGE_INIT_TIMEOUT_MS=15000

# Calls one backend may have in flight at once (default 32).
# MCP_BRIDGE_MAX_IN_FLIGHT=32

# Structured JSON logs (Datadog, Splunk, ELK, Loki).
# CYFR_LOG_FORMAT=json
