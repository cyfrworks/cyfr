# Bridge-container settings. Copy to .env.bridge to override defaults.
# Compose forwards MCP_BRIDGE_TOKEN from the project .env. Keep application
# credentials out of this file; registered backends run child processes.

# The bearer /mcp requires (must match MCP_BRIDGE_TOKEN in .env). Leave it
# to the project .env unless this container needs a different value.
# MCP_BRIDGE_TOKEN=

# Boot WITHOUT a token. Disables the fail-closed refusal and leaves /mcp —
# which spawns `sh -c` — open to anything that can reach the port. Only ever
# on an isolated network.
# MCP_BRIDGE_ALLOW_INSECURE=

# Port inside the container (default 8001; never published to the host).
# MCP_BRIDGE_PORT=8001

# Where backends.json lives (the ./data/mcp-bridge volume).
# MCP_BRIDGE_DATA=/data/backends.json

# Per-call and handshake timeouts for stdio children.
# MCP_BRIDGE_RPC_TIMEOUT_MS=30000
# MCP_BRIDGE_INIT_TIMEOUT_MS=15000

# Concurrency and size ceilings.
# MCP_BRIDGE_MAX_IN_FLIGHT=32
# MCP_BRIDGE_MAX_BACKENDS=32

# Structured JSON logs (Datadog, Splunk, ELK, Loki).
# CYFR_LOG_FORMAT=json
