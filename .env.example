# CYFR deployment file
#
# `cyfr init` writes .env from this file: it asks for the hostname, your
# sign-in email, TLS or not and, with TLS, a Let's Encrypt email, and mints
# every empty key below. Run again, it adds only the keys .env lacks. From
# a source checkout, `cp .env.example .env` and fill in each empty key as
# its comment says, then `docker compose --profile locus-builds up -d`
# (add `--profile tls` behind Caddy).

# Signs sessions and derives the key secrets are sealed with at rest:
# `openssl rand -base64 48`. A restored data directory needs the same value.
CYFR_SECRET_KEY_BASE=

# Where clients reach the server.
CYFR_PORT=4000
CYFR_HOST=localhost

# `true` with Caddy in front (TLS mode), which `cyfr up` then starts;
# `false` reaches cyfr directly at http://localhost:4000.
CYFR_BEHIND_PROXY=false

# The address Let's Encrypt registers Caddy's certificate under, in TLS
# mode with a real CYFR_HOST.
CADDY_ACME_EMAIL=

# The browser CORS allowlist. Empty admits no cross-origin client, which
# the stack never has: Prism, the API, /mcp and the tinctures share one
# origin. With the line removed a release with sign-in refuses to boot.
CYFR_CORS_ALLOWED_ORIGINS=

# The private hosts, addresses or CIDRs the server's own outbound calls may
# reach, comma-separated: the backends service, and any internal MCP
# server, registry or identity provider your athanors use.
CYFR_PRIVATE_EGRESS_TARGETS=locus-backends

# Sign-in through the GitHub and Google device flows, with public client
# IDs; replace them with your own OAuth apps'. Google needs its client
# secret too, CYFR_GOOGLE_CLIENT_SECRET, set in .env and never in a tracked
# file.
CYFR_GITHUB_CLIENT_ID=Ov23lib66tiIwXkgUpwm
CYFR_GOOGLE_CLIENT_ID=426327824138-b6e3envp9iov017h9q5use82oiqrccg1.apps.googleusercontent.com

# The execution worker's keys: the root only cyfr holds
# (`openssl rand -hex 32`), and the opus service's key derived from it for
# its service id, wrk_opus:
#   env CYFR_OPUS_KEY=… mix cyfr.opus.key wrk_opus
# or with openssl alone, the same HMAC:
#   printf 'cyfr-opus/v1/worker\nwrk_opus' | openssl dgst -sha256 -mac HMAC -macopt hexkey:$CYFR_OPUS_KEY
CYFR_OPUS_KEY=
OPUS_SERVICE_KEY=

# The backends service's key, which runs the stdio MCP servers:
# `openssl rand -hex 32`.
CYFR_LOCUS_BACKENDS_KEY=

# The builds service: its URL and its key (`openssl rand -hex 32`), both
# or neither. While the URL names the compose service, `cyfr up` starts
# locus-builds; set both empty to turn builds off.
CYFR_LOCUS_BUILDS_URL=http://locus-builds:4100
CYFR_LOCUS_BUILDS_KEY=

# The server's operators, comma-separated emails: each is always let in
# and holds the platform-admin capability. Unset, no one can sign in.
# CYFR_PLATFORM_ADMIN_EMAILS=

# =============================================================================
# Deployment choices
# =============================================================================

# PostgreSQL in place of the embedded SQLite: an image built with
# CYFR_DATABASE=postgres (the published image is SQLite), and its URL.
# Several members on one database migrate by hand: CYFR_AUTO_MIGRATE=false.
# CYFR_DATABASE=postgres
# CYFR_DATABASE_URL=postgres://user:pass@host:5432/cyfr
# CYFR_AUTO_MIGRATE=true

# S3-compatible object storage in place of ./data; MinIO and other non-AWS
# stores set the endpoint and path-style addressing too.
# CYFR_STORAGE=s3
# CYFR_S3_BUCKET=
# CYFR_S3_REGION=us-east-1
# CYFR_S3_ACCESS_KEY_ID=
# CYFR_S3_SECRET_ACCESS_KEY=
# CYFR_S3_ENDPOINT=
# CYFR_S3_PATH_STYLE=false

# An external OIDC issuer in place of GitHub and Google; all three values
# are required once oidc is selected.
# CYFR_AUTH_PROVIDER=oidc
# CYFR_OIDC_ISSUER=https://auth.example.com
# CYFR_OIDC_CLIENT_ID=
# CYFR_OIDC_CLIENT_SECRET=

# A builder elsewhere: set CYFR_LOCUS_BUILDS_URL above to its URL and
# CYFR_LOCUS_BUILDS_KEY to its key, and name its host in
# CYFR_PRIVATE_EGRESS_TARGETS; `cyfr up` then starts no local locus-builds.

# A headless node: the API, /mcp and public tinctures, and no browser
# page. Not with an external OIDC issuer.
# CYFR_HEADLESS=true

# The identity directory this server enrolls its people at, an https URL
# you choose: there is no default. Unset, everything local works and
# enrollment is refused.
# CYFR_DIRECTORY_URL=https://directory.example.com

# Restoring a person onto this fresh installation from their printed kit:
# the installation's restore capability (`openssl rand -hex 32`), set in
# .env alone. Set, ordinary first sign-in is refused and the first person
# is the one the restore brings back.
# CYFR_RESTORE_TOKEN=

# Prometheus metrics at /metrics, with the bearer token a scrape presents.
# CYFR_PROMETHEUS_METRICS=true
# CYFR_METRICS_TOKEN=

# The worker service's id and where it calls cyfr's host API, the workers
# cyfr dispatches to, and where the host API listens. Compose sets each;
# another service id is named in CYFR_OPUS_WORKERS too.
# OPUS_SERVICE_ID=wrk_opus
# OPUS_HOST_URL=http://cyfr:4300
# CYFR_OPUS_WORKERS=wrk_opus=http://opus:4200
# CYFR_HOST_API_BIND=127.0.0.1
# CYFR_HOST_API_PORT=4300

# The containers' limits, which compose reads and no release reads. Each
# memory limit holds every runner or build at its own bound and the service
# beside them:
#   OPUS_MEMORY_LIMIT >= 8 runner uids x OPUS_RUNNER_MEMORY_BYTES + 1 GiB
#     (.env.opus; default 8 x 384 MiB + 1 GiB = 4 GiB)
#   LOCUS_BUILDS_MEMORY_LIMIT >=
#     LOCUS_BUILDS_MAX_CONCURRENT x (LOCUS_BUILDS_MEMORY_BYTES + 1 GiB)
#     (.env.locus; default 2 x (1 GiB + 1 GiB) = 4 GiB)
# CYFR_CPU_LIMIT=4
# OPUS_MEMORY_LIMIT=4G
# OPUS_CPU_LIMIT=4
# LOCUS_BUILDS_MEMORY_LIMIT=4G
# LOCUS_BUILDS_CPU_LIMIT=2

# Every variable the server reads, with its default, and every platform
# setting (the limits, windows and log level changed on Prism's Settings
# page or with `cyfr settings`): configuration-guide.md.
