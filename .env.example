# CYFR Configuration
#
# Two ways this file is used:
#   • `cyfr init` downloads this file (alongside docker-compose.yml + Caddyfile),
#     copies it to .env, fills in CYFR_SECRET_KEY_BASE, and prompts for CYFR_HOST,
#     CYFR_PLATFORM_ADMIN_EMAILS, the TLS y/n choice, and (if TLS) CADDY_ACME_EMAIL.
#   • From a source checkout: `cp .env.example .env`, set CYFR_SECRET_KEY_BASE
#     (and CYFR_HOST / CADDY_ACME_EMAIL if you're using Caddy), then
#     `docker compose up -d`. See README.md → "Deploy to a Server".

# =============================================================================
# Required
# =============================================================================

# Generate with: mix phx.gen.secret  (or: openssl rand -base64 48)
CYFR_SECRET_KEY_BASE=

# =============================================================================
# Server
# =============================================================================
CYFR_PORT=4000
CYFR_HOST=localhost

# Structured (JSON) logging for Datadog/Splunk/ELK/Loki. Unset = plain text.
# CYFR_LOG_FORMAT=json

# Session idle timeout in hours (default: 720 / 30 days, 0 = never expires).
# CYFR_SESSION_TTL_HOURS=720

# Extra origins (comma-separated) accepted by the MCP endpoint's Origin check
# in addition to https://CYFR_HOST and the localhost defaults. Only needed if
# you embed the PWA on another origin or run multiple frontends.
# CYFR_MCP_ALLOWED_ORIGINS=https://app.example.com,https://other.example.org

# MCP transport rate limit, per client IP (default: 120 requests / 60s window).
# Counts requests and SSE connection opens; long-lived streams are unaffected.
# CYFR_MCP_RATE_LIMIT_MAX=120
# CYFR_MCP_RATE_LIMIT_WINDOW_MS=60000

# Concurrent WASM execution caps — global, and per athanor.
# The per-tenant cap bounds how many slots one athanor can hold at once.
# CYFR_MAX_CONCURRENT_EXECUTIONS=128
# CYFR_MAX_CONCURRENT_EXECUTIONS_PER_TENANT=16

# =============================================================================
# Authentication
# =============================================================================
# Device Flow only needs a Client ID — no secret required (except Google, which
# requires the secret on the token exchange). The values below are CYFR's own
# published OAuth apps, so `cyfr login` works out of the box; swap in your own
# if you'd rather not depend on them.

# GitHub OAuth App (https://github.com/settings/developers) — enable "Device Flow"
CYFR_GITHUB_CLIENT_ID=Ov23lib66tiIwXkgUpwm
# GitHub device flow (CLI and Prism) does not use a client secret.
# CYFR_GITHUB_CLIENT_SECRET=
CYFR_GOOGLE_CLIENT_ID=426327824138-b6e3envp9iov017h9q5use82oiqrccg1.apps.googleusercontent.com
CYFR_GOOGLE_CLIENT_SECRET=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

# Platform admins (comma-separated emails): the server's operators. A listed
# email is always let in and gets the platform-admin capability on first sign-in
# — a seat in Home, the door (server allowlist), and the operator verbs. Everyone
# else is let in only by the allowlist a platform admin manages (`cyfr admin
# allow <email>`, or `*` for anyone the provider authenticates). Set it, or no
# one (including you) can sign in.
# CYFR_PLATFORM_ADMIN_EMAILS=alice@example.com

# Public-door caps (all optional; unset = off). A private box needs none of
# them; a server whose allowlist is `*` sets them.
# CYFR_MAX_ATHANORS=500
# CYFR_MAX_GROUPS_PER_PERSON=50
# CYFR_MAX_MEMBERS_PER_GROUP=200
# CYFR_MINT_PER_HOUR=60
# CYFR_ATHANOR_STORAGE_BYTES=1073741824

# Federated SSO via a generic OIDC issuer (Okta, Auth0, Keycloak, Azure AD…).
# Set CYFR_AUTH_PROVIDER=oidc and all three CYFR_OIDC_* values; if oidc is
# selected with any of them missing, the server refuses to start (it will not
# silently fall back to no-auth). Leave unset to use GitHub/Google above.
# CYFR_AUTH_PROVIDER=oidc
# CYFR_OIDC_ISSUER=https://auth.example.com
# CYFR_OIDC_CLIENT_ID=
# CYFR_OIDC_CLIENT_SECRET=

# CORS allowlist for browser clients (comma-separated origins). REQUIRED for
# a server (release) deployment: authentication is on by default (see the
# client IDs above), and the server refuses to boot a release that combines
# authentication with the wildcard CORS default. Set it to the origin(s) your
# browser clients are served from; an empty value allows no cross-origin
# callers at all (fail-closed — same-origin traffic is unaffected).
# CYFR_CORS_ALLOWED_ORIGINS=https://app.example.com

# =============================================================================
# Crypto & session security
# =============================================================================
# Encryption keyring for at-rest secrets (vault entries, webhook secrets,
# registry tokens). Unset = a single key derived from CYFR_SECRET_KEY_BASE.
# Set explicitly to rotate keys: JSON of {"primary":"label","keys":{"label":
# "<base64 ≥32 bytes>", ...}} — old labels stay listed so existing rows
# decrypt; run Sanctum.Cipher.Rotation.reencrypt_all/1 to re-seal.
# CYFR_CRYPTO_KEYRING=

# Session/LiveView signing salts. Unset = derived from CYFR_SECRET_KEY_BASE;
# set explicitly only if you rotate the key base but must keep sessions.
# CYFR_EMISSARY_SESSION_SALT=
# CYFR_LV_SALT=

# PBKDF2 iterations for derived keys (default 100000). Lower only for tests.
# CYFR_PBKDF2_ITERATIONS=100000

# =============================================================================
# Network bind
# =============================================================================
# Bind address of the one endpoint (default 0.0.0.0). Set 127.0.0.1 to bind
# localhost-only.
# CYFR_BIND_ADDRESS=0.0.0.0

# =============================================================================
# Paths & registry
# =============================================================================
# The one runtime storage root (every athanor's data and components, caches,
# and the SQLite database) and the seed-bundle source read in place. Release
# (prod) knobs, like CYFR_DATABASE_PATH; the container image sets its own.
# CYFR_DATA_PATH=data
# CYFR_BUNDLE_PATH=components/_bundle
# The SQLite database file — defaults to cyfr.db under CYFR_DATA_PATH.
# CYFR_DATABASE_PATH=data/cyfr.db

# Registry hosts — defaults target cyfr.run; point at your own for a
# self-hosted registry.
# CYFR_REGISTRY_URL=cyfr.run
# CYFR_OCI_REGISTRY_URL=registry.cyfr.run

# The address this instance is reachable at from outside. Behind a proxy or a
# tunnel that is neither the bind address nor any request's Host, so only you
# can say it. Webhook URLs are absolute when it is set and bare paths when it
# is not.
# CYFR_PUBLIC_URL=https://cyfr.example.com

# Label recorded against registry push tokens this instance mints, so a token
# is identifiable in the registry's own list. Defaults to the hostname.
# CYFR_DEVICE_LABEL=my-laptop

# Signature verification for OCI pulls: keyless (Sigstore Fulcio+Rekor) by
# default; set a public key path for keyed verification.
# CYFR_COSIGN_KEY=
# CYFR_COSIGN_PASSWORD=

# =============================================================================
# Observability
# =============================================================================
# Prometheus metrics at /metrics on the API port. Off by default: the endpoint
# is unauthenticated when enabled, so bind to a private interface or put a
# reverse-proxy allowlist in front before turning it on.
# CYFR_PROMETHEUS_METRICS=true

# OpenTelemetry traces (OTLP). Off by default.
# CYFR_OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# =============================================================================
# Storage backend
# =============================================================================
# Default is the local filesystem (./data). Set CYFR_STORAGE=s3 to use an
# S3-compatible object store; all four required vars must be set or the server
# refuses to start. CYFR_S3_ENDPOINT + CYFR_S3_PATH_STYLE=true target MinIO and
# other non-AWS providers.
# CYFR_STORAGE=s3
# CYFR_S3_BUCKET=
# CYFR_S3_REGION=us-east-1
# CYFR_S3_ACCESS_KEY_ID=
# CYFR_S3_SECRET_ACCESS_KEY=
# CYFR_S3_ENDPOINT=
# CYFR_S3_PREFIX=
# CYFR_S3_PATH_STYLE=false

# =============================================================================
# Database
# =============================================================================
# Default is embedded SQLite (./data/cyfr.db) — zero config. Postgres is opt-in
# and the adapter is chosen at BUILD time (Ecto can't swap adapters at runtime),
# so a Postgres deployment needs an image built with CYFR_DATABASE=postgres
# (the published image is SQLite). At runtime, point it at your database with
# CYFR_DATABASE_URL — required for a Postgres build, no localhost fallback.
# CYFR_DATABASE selects the adapter and is read at BUILD time, not runtime —
# setting it on a running container does nothing.
# CYFR_DATABASE=sqlite
# CYFR_DATABASE_URL=postgres://user:pass@host:5432/cyfr
# CYFR_DB_POOL_SIZE=20
# CYFR_DB_SSL=false
#
# CYFR_AUTO_MIGRATE — the server migrates the schema on boot (default true).
# Several nodes on one Postgres, or an operator running the schema step by
# hand (`bin/cyfr eval "Cyfr.Release.migrate()"`), set it to false.
# CYFR_AUTO_MIGRATE=true
#
# CYFR_HEADLESS — a Codex-only node (default false): the API, MCP and public
# tinctures are served, every browser page (sign-in, Prism) answers 404.
# Not with an external OIDC provider: the CLI signs in through the built-in
# device flow, which an external provider replaces with the browser page.
# CYFR_HEADLESS=false

# =============================================================================
# Self-hosted stack (docker-compose.yml)
# =============================================================================
# CYFR_SECRET_KEY_BASE and CYFR_HOST above are shared with the stack.

# Reverse proxy / TLS — `cyfr init`'s TLS prompt sets this for you:
#   • TLS (Caddy in front, public hostname):   CYFR_BEHIND_PROXY=true
#   • Direct (local, no Caddy):                CYFR_BEHIND_PROXY=false
# CYFR_BEHIND_PROXY trusts X-Forwarded-* and silences the plain-HTTP warning.
# `cyfr up` adds `--profile tls` automatically when CYFR_BEHIND_PROXY=true.
CYFR_BEHIND_PROXY=false

# Trusted reverse-proxy hops in front of cyfr when CYFR_BEHIND_PROXY=true.
# The client IP is resolved right-to-left from X-Forwarded-For, stripping this
# many proxy hops. The shipped stack has exactly one (Caddy). If you put
# another proxy/CDN in front, raise the count — or list the proxies in
# CYFR_TRUSTED_PROXY_CIDRS (comma-separated IPs/CIDRs; takes precedence).
# A wrong value makes client IPs resolve to a proxy address, so API-key IP
# allowlists fail closed (never open).
# CYFR_TRUSTED_PROXY_HOPS=1
# CYFR_TRUSTED_PROXY_CIDRS=

# CPU limit for the cyfr container (compose `cpus:`). Bounds aggregate damage
# from WASM components that never yield.
# CYFR_CPU_LIMIT=4

# Email for Let's Encrypt — only needed when CYFR_BEHIND_PROXY=true (TLS mode)
# AND CYFR_HOST is a real domain.
CADDY_ACME_EMAIL=

# Private egress. Outbound calls (MCP servers, OAuth token endpoints, registry
# pulls, HTTP from components) refuse private addresses unless the target is
# named here — hostnames, IPs or CIDRs, comma-separated. `mcp-bridge` is the
# compose service; add the internal hosts your athanors talk to (the lights,
# an internal registry, an internal IdP). Link-local (169.254/16) is always
# refused. Empty refuses every private target.
CYFR_PRIVATE_EGRESS_TARGETS=mcp-bridge

# mcp-bridge bearer token. The bridge runs `sh -c` for `add_backend`, so
# anything that can POST to its /mcp endpoint gets RCE. It is reachable only on
# the trusted container network (its port is never published to the host).
# `cyfr init` generates this token so the bridge boots closed; register the
# bridge in the PWA with header `Authorization: vault:mcp_bridge_token` and store
# the same value in a Vault entry named `mcp_bridge_token`. The bridge REFUSES
# to boot with an empty token (it would otherwise expose `sh -c` to the
# network); set one here, or set MCP_BRIDGE_ALLOW_INSECURE=1 below to opt into
# running open on an isolated network.
MCP_BRIDGE_TOKEN=

# The bridge's other settings. MCP_BRIDGE_ALLOW_INSECURE=1 is the explicit
# opt-in to boot WITHOUT a token: it disables the refusal described above and
# leaves /mcp — which spawns `sh -c` — open to anything that can reach the
# port. Only ever on an isolated network.
# MCP_BRIDGE_PORT=8001
# MCP_BRIDGE_DATA=/data/backends.json
# MCP_BRIDGE_RPC_TIMEOUT_MS=30000
# MCP_BRIDGE_INIT_TIMEOUT_MS=15000
# MCP_BRIDGE_ALLOW_INSECURE=
