# CYFR Configuration (Sanctum Core)
# Copy this to .env and fill in your values.
# For enterprise features (OIDC, SAML, air-gapped signing), see Sanctum Arx.

# =============================================================================
# Required
# =============================================================================

# Generate with: mix phx.gen.secret
CYFR_SECRET_KEY_BASE=

# =============================================================================
# Server
# =============================================================================
CYFR_PORT=4000
CYFR_HOST=localhost
CYFR_LOG_LEVEL=info

# Session TTL in hours (default: 24, 0 = infinite / never expires)
# CYFR_SESSION_TTL_HOURS=24

# =============================================================================
# Authentication
# =============================================================================
# Device Flow only needs Client ID - no secret required.

# GitHub OAuth App (https://github.com/settings/developers)
# Enable "Device Flow" in app settings
CYFR_GITHUB_CLIENT_ID=Ov23lib66tiIwXkgUpwm
CYFR_GOOGLE_CLIENT_ID=426327824138-b6e3envp9iov017h9q5use82oiqrccg1.apps.googleusercontent.com
CYFR_GOOGLE_CLIENT_SECRET=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

# Optional: Restrict to specific users
# CYFR_ALLOWED_USER=alice@example.com

# =============================================================================
# Self-hosted stack (docker-compose.yml: cyfr + web + caddy + neko + chrome-mcp)
# =============================================================================
# CYFR_SECRET_KEY_BASE and CYFR_HOST above are shared with the stack.

# Email for Let's Encrypt — only needed when CYFR_HOST is a real domain.
CADDY_ACME_EMAIL=

# --- neko (remote browser) ---
# Single password — used for both the regular and admin neko roles.
NEKO_PASSWORD=changeme
# WebRTC media ports published on the host: a UDP range + a single TCP fallback.
NEKO_EPR=59000-59100
NEKO_TCPMUX=59999
# Public address advertised for WebRTC ICE. Defaults to CYFR_HOST; set this to
# the VPS's public IP if CYFR_HOST is "localhost" or a domain that doesn't
# resolve to this host.
# NEKO_NAT1TO1=203.0.113.10
