# CYFR deployment file
#
# `cyfr init` writes .env from this file: it asks how the server is reached
# and your sign-in email, mints every empty key below, and writes the access
# settings the answer implies. Run again, it adds only the keys .env lacks.
# From a source checkout, `cp .env.example .env`, fill in each empty key as
# its comment says, then `cyfr up`.

# Signs sessions and derives the key secrets are sealed with at rest:
# `openssl rand -base64 48`, at least 64 bytes; a blank or shorter value
# refuses the boot. A restored data directory needs the same value.
CYFR_SECRET_KEY_BASE=

# The server's browser address: `none` (no browser address: this computer
# alone, at its private address below), `tailnet` (your devices on Tailscale),
# `domain` (a domain, through Caddy) or `proxy` (a domain your own proxy
# serves). `cyfr access browser <kind>` changes it and writes every setting
# it implies with it: CYFR_HOST, and with a browser address CYFR_PUBLIC_URL,
# CYFR_TAILNET_NODE_ID (tailnet), CADDY_ACME_EMAIL (domain, optional) and
# CYFR_PROXY_PUBLISH (proxy: where your proxy forwards to, default
# 127.0.0.1:4001). proxy also needs CYFR_TRUSTED_PROXY_HOPS or
# CYFR_TRUSTED_PROXY_CIDRS below. The server refuses to start on settings
# that contradict the kind, and names the command that fixes them.
CYFR_BROWSER=none
CYFR_HOST=localhost
# The loopback listener's port, published on this machine's loopback alone.
CYFR_PORT=4000

# The server's tunnel key, which `cyfr init` mints once for a new CYFR:
# CYFR_LINK_KEY, its private half and pre-shared key, kept secret, and
# CYFR_LINK_PUBLIC, its public half (64 lowercase hexadecimal digits). The
# public half names the server's private address,
# http://h-<16 letters and digits>.localhost:<CYFR_PORT>, where this
# computer reaches it whatever its browser address; without it the server
# refuses to start.
CYFR_LINK_KEY=
CYFR_LINK_PUBLIC=

# The browser CORS allowlist, comma-separated origins. Empty or unset admits
# no cross-origin client, which the stack never has: Prism, the API, /mcp
# and the tinctures share one origin. A release with sign-in refuses to boot
# on the wildcard `*` alone.
CYFR_CORS_ALLOWED_ORIGINS=

# The private hosts the server's own outbound calls may reach, comma-separated,
# each a name, an address written in full or a CIDR range: Locus, whose
# backends role runs programs, and any internal MCP server, registry or
# identity provider your athanors use.
CYFR_PRIVATE_EGRESS_TARGETS=locus

# The runtime's keys: the root only cyfr holds (`openssl rand -hex 32`),
# and the runtime role's key derived from it for its service id,
# wrk_locus:
#   env CYFR_LOCUS_RUNTIME_ROOT=… mix cyfr.locus.runtime_key wrk_locus
# or with openssl alone, the same HMAC:
#   printf 'cyfr-locus/v1/runtime\nwrk_locus' | openssl dgst -sha256 -mac HMAC -macopt hexkey:$CYFR_LOCUS_RUNTIME_ROOT
CYFR_LOCUS_RUNTIME_ROOT=
LOCUS_RUNTIME_KEY=

# The backends role's key, which starts the role that runs the stdio MCP
# servers: `openssl rand -hex 32`.
CYFR_LOCUS_BACKENDS_KEY=

# The builds role's key (`openssl rand -hex 32`). Set, Locus starts its
# builds role and cyfr builds there, at the host of CYFR_LOCUS_BACKENDS_URL
# on port 4100; empty, builds are off.
CYFR_LOCUS_BUILDS_KEY=

# The AppArmor profile the Locus container runs under, by its name:
# cyfr's own, which `cyfr init` and `cyfr update` write here and load.
CYFR_LOCUS_APPARMOR=

# =============================================================================
# Deployment choices
# =============================================================================

# PostgreSQL in place of the embedded SQLite: an image built with
# CYFR_DATABASE=postgres (the published image is SQLite), and its URL.
# Several servers in one cluster sharing a database migrate by hand: CYFR_AUTO_MIGRATE=off.
# CYFR_DATABASE=postgres
# CYFR_DATABASE_URL=postgres://user:pass@host:5432/cyfr
# CYFR_AUTO_MIGRATE=on

# S3-compatible object storage in place of ./data; MinIO and other non-AWS
# stores set the endpoint and path-style addressing too.
# CYFR_STORAGE=s3
# CYFR_S3_BUCKET=
# CYFR_S3_REGION=us-east-1
# CYFR_S3_ACCESS_KEY_ID=
# CYFR_S3_SECRET_ACCESS_KEY=
# CYFR_S3_ENDPOINT=
# CYFR_S3_PATH_STYLE=off

# The account service this server's people sign in through and whose
# accounts it reads, an https URL (default https://cyfr.run, the account
# service cyfr.run hosts).
# CYFR_DIRECTORY_URL=https://directory.example.com

# The installation's setup token: 64 lowercase hexadecimal characters,
# written by `cyfr init`, which prints the setup link
# (<CYFR address>/setup#<token>), and by the CYFR app's setup. It makes
# the first person, who administers this CYFR, through that link or the
# box's own screen, and then opens nothing. Unset, no one can set this CYFR up.
CYFR_SETUP_TOKEN=

# Prometheus metrics at /metrics, with the bearer token a scrape presents.
# CYFR_PROMETHEUS_METRICS=on
# CYFR_METRICS_TOKEN=

# The proxy listener's port, where caddy (domain) and tailscale (tailnet)
# forward on the edge network; published only with proxy, at
# CYFR_PROXY_PUBLISH.
# CYFR_PROXY_PORT=4001

# Whose forwarded headers the proxy listener trusts. The stack trusts its
# own Caddy and Tailscale; proxy needs one of these stated: how many
# proxies stand in front of CYFR (1 for your proxy alone; your proxy
# reaches CYFR through Docker's published port, so its own address is not
# the one CYFR sees), or the addresses and CIDRs to trust.
# CYFR_TRUSTED_PROXY_HOPS=1
# CYFR_TRUSTED_PROXY_CIDRS=

# The worker service's id and where it calls cyfr's host API, the workers
# cyfr dispatches to, and where the host API listens. Compose sets each;
# another service id is named in CYFR_LOCUS_RUNTIME_WORKERS too.
# LOCUS_RUNTIME_SERVICE_ID=wrk_locus
# LOCUS_RUNTIME_HOST_API_URL=http://cyfr:4300
# CYFR_LOCUS_RUNTIME_WORKERS=wrk_locus=http://locus:4200
# CYFR_HOST_API_BIND=127.0.0.1
# CYFR_HOST_API_PORT=4300

# cyfr's processor limit and Locus's pool, which compose reads and no
# release reads. All of Locus's work, every run, build and program
# session, shares one memory bound, which cyfr-locus writes into its
# cgroup: the machine's memory less LOCUS_CORE_RESERVE_BYTES, kept for
# CYFR itself (the cyfr container and the screen; default 2304 MiB), or
# the Locus container's own limit where that is less, less
# LOCUS_SERVICE_BYTES, what Locus's three services hold beside it (default
# 800 MiB), never below 0; at 0 no work starts. The reserve holds CYFR
# itself at about 1.7 GiB at its peak, the screen's app included: a
# machine where CYFR itself holds more needs a higher reserve (about
# 3072 MiB for 700 MiB more). Each role's processors are split between its
# service and its work, neither lending to the other, and together they
# may exceed the machine's: CYFR itself has no share set apart.
# CYFR_CPU_LIMIT=4
# LOCUS_CORE_RESERVE_BYTES=2415919104
# LOCUS_SERVICE_BYTES=838860800
# LOCUS_RUNTIME_CPU_LIMIT=4
# LOCUS_BUILDS_CPU_LIMIT=2
# (The backends role has no processor bound.)

# Every variable the server reads, with its default, and every platform
# setting (the limits, windows and log level changed on Prism's Settings
# page): configuration-guide.md.
