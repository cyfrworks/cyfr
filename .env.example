# CYFR deployment file
#
# `cyfr init` writes .env from this file: it asks how the home is reached
# and your sign-in email, mints every empty key below, and writes the access
# settings the answer implies. Run again, it adds only the keys .env lacks.
# From a source checkout, `cp .env.example .env`, fill in each empty key as
# its comment says, then `cyfr up`.

# Signs sessions and derives the key secrets are sealed with at rest:
# `openssl rand -base64 48`, at least 64 bytes; a blank or shorter value
# refuses the boot. A restored data directory needs the same value.
CYFR_SECRET_KEY_BASE=

# How the home is reached: `local` (this computer alone, at
# http://localhost:<CYFR_PORT>), `tailnet` (your devices on Tailscale) or
# `public` (a domain, through Caddy). `cyfr access <mode>` changes it and
# writes every setting it implies with it: CYFR_HOST, and for tailnet and
# public CYFR_PUBLIC_URL, CYFR_TAILNET_NODE_ID (tailnet) and
# CADDY_ACME_EMAIL (public, optional). The server refuses to start on
# settings that contradict the mode, and names the command that fixes them.
CYFR_ACCESS=local
CYFR_HOST=localhost
# The loopback listener's port, published on this machine's loopback alone.
CYFR_PORT=4000

# The browser CORS allowlist, comma-separated origins. Empty or unset admits
# no cross-origin client, which the stack never has: Prism, the API, /mcp
# and the tinctures share one origin. A release with sign-in refuses to boot
# on the wildcard `*` alone.
CYFR_CORS_ALLOWED_ORIGINS=

# The private hosts, addresses or CIDRs the server's own outbound calls may
# reach, comma-separated: the backends service, and any internal MCP
# server, registry or identity provider your athanors use.
CYFR_PRIVATE_EGRESS_TARGETS=locus-backends

# GitHub and Google as sign-in methods a person links, each offered when
# it is configured, with public client IDs; replace them with your own
# OAuth apps'. Google is offered once its client secret is set too,
# CYFR_GOOGLE_CLIENT_SECRET, in .env and never in a tracked file.
CYFR_GITHUB_CLIENT_ID=Ov23lib66tiIwXkgUpwm
CYFR_GOOGLE_CLIENT_ID=426327824138-b6e3envp9iov017h9q5use82oiqrccg1.apps.googleusercontent.com

# The runtime's keys: the root only cyfr holds (`openssl rand -hex 32`),
# and the locus-runtime service's key derived from it for its service id,
# wrk_locus:
#   env CYFR_LOCUS_RUNTIME_ROOT=… mix cyfr.locus.runtime_key wrk_locus
# or with openssl alone, the same HMAC:
#   printf 'cyfr-locus/v1/runtime\nwrk_locus' | openssl dgst -sha256 -mac HMAC -macopt hexkey:$CYFR_LOCUS_RUNTIME_ROOT
CYFR_LOCUS_RUNTIME_ROOT=
LOCUS_RUNTIME_KEY=

# The backends service's key, which runs the stdio MCP servers:
# `openssl rand -hex 32`.
CYFR_LOCUS_BACKENDS_KEY=

# The builds service: its URL and its key (`openssl rand -hex 32`), both
# or neither. While the URL names the compose service, `cyfr up` starts
# locus-builds; set both empty to turn builds off.
CYFR_LOCUS_BUILDS_URL=http://locus-builds:4100
CYFR_LOCUS_BUILDS_KEY=

# =============================================================================
# Deployment choices
# =============================================================================

# PostgreSQL in place of the embedded SQLite: an image built with
# CYFR_DATABASE=postgres (the published image is SQLite), and its URL.
# Several servers in one cluster sharing a database migrate by hand: CYFR_AUTO_MIGRATE=off.
# CYFR_DATABASE=postgres
# CYFR_DATABASE_URL=postgres://user:pass@host:5432/cyfr
# CYFR_AUTO_MIGRATE=on

# S3-compatible object storage in place of ./data; MinIO and other non-AWS
# stores set the endpoint and path-style addressing too.
# CYFR_STORAGE=s3
# CYFR_S3_BUCKET=
# CYFR_S3_REGION=us-east-1
# CYFR_S3_ACCESS_KEY_ID=
# CYFR_S3_SECRET_ACCESS_KEY=
# CYFR_S3_ENDPOINT=
# CYFR_S3_PATH_STYLE=off

# An OpenID Connect issuer as a sign-in method a person links, offered
# beside GitHub and Google once all three values are set; a partly set
# issuer refuses the boot.
# CYFR_OIDC_ISSUER=https://auth.example.com
# CYFR_OIDC_CLIENT_ID=
# CYFR_OIDC_CLIENT_SECRET=

# A builder elsewhere: set CYFR_LOCUS_BUILDS_URL above to its URL and
# CYFR_LOCUS_BUILDS_KEY to its key, and name its host in
# CYFR_PRIVATE_EGRESS_TARGETS; `cyfr up` then starts no local locus-builds.

# A headless node: the API, /mcp and public tinctures, and no browser
# page. Not with an OpenID Connect issuer.
# CYFR_HEADLESS=on

# The identity directory this server enrolls its people at, an https URL
# (default https://cyfr.run, the directory cyfr.run hosts).
# CYFR_DIRECTORY_URL=https://directory.example.com

# The installation's setup token: 64 lowercase hexadecimal characters,
# written by `cyfr init` and `cyfr setup`, which print the setup link
# (<CYFR address>/setup#<token>). It makes the first person, who
# administers this CYFR, through that link or `cyfr login --setup`, and
# signs them in again until they hold a passkey, a paired device or a
# linked sign-in method. Unset, no one can set this CYFR up.
CYFR_SETUP_TOKEN=

# Restoring a person onto this fresh installation from their printed kit:
# the installation's restore capability (`openssl rand -hex 32`), set in
# .env alone. Set, setup is refused and the first person
# is the one the restore brings back.
# CYFR_RESTORE_TOKEN=

# Prometheus metrics at /metrics, with the bearer token a scrape presents.
# CYFR_PROMETHEUS_METRICS=on
# CYFR_METRICS_TOKEN=

# The proxy listener's port, where caddy (public) and tailscale (tailnet)
# forward on the edge network; never published.
# CYFR_PROXY_PORT=4001

# The worker service's id and where it calls cyfr's host API, the workers
# cyfr dispatches to, and where the host API listens. Compose sets each;
# another service id is named in CYFR_LOCUS_RUNTIME_WORKERS too.
# LOCUS_RUNTIME_SERVICE_ID=wrk_locus
# LOCUS_RUNTIME_HOST_API_URL=http://cyfr:4300
# CYFR_LOCUS_RUNTIME_WORKERS=wrk_locus=http://locus-runtime:4200
# CYFR_HOST_API_BIND=127.0.0.1
# CYFR_HOST_API_PORT=4300

# The containers' limits, which compose reads and no release reads. Each
# memory limit holds every runner or build at its own bound and the service
# beside them:
#   LOCUS_RUNTIME_MEMORY_LIMIT >= 8 runner uids x LOCUS_RUNTIME_MEMORY_BYTES + 1 GiB
#     (.env.locus; default 8 x 384 MiB + 1 GiB = 4 GiB)
#   LOCUS_BUILDS_MEMORY_LIMIT >=
#     LOCUS_BUILDS_MAX_CONCURRENT x (LOCUS_BUILDS_MEMORY_BYTES + 1 GiB)
#     (.env.locus; default 2 x (1 GiB + 1 GiB) = 4 GiB)
# CYFR_CPU_LIMIT=4
# LOCUS_RUNTIME_MEMORY_LIMIT=4G
# LOCUS_RUNTIME_CPU_LIMIT=4
# LOCUS_BUILDS_MEMORY_LIMIT=4G
# LOCUS_BUILDS_CPU_LIMIT=2

# Every variable the server reads, with its default, and every platform
# setting (the limits, windows and log level changed on Prism's Settings
# page or with `cyfr settings`): configuration-guide.md.
