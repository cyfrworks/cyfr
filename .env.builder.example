# Builder-container settings for `docker compose --profile builder up -d`.
# Copy to .env.builder to override defaults. Compose forwards CYFR_BUILDER_TOKEN
# from the project .env; do not include application credentials here.

# The shared bearer token (must match CYFR_BUILDER_TOKEN in .env).
# CYFR_BUILDER_TOKEN=

# Port the builder service listens on inside the container (default 4100).
# CYFR_BUILDER_PORT=4100

# Concurrent toolchain builds (cargo/npm — a CPU core and hundreds of MB
# each for minutes). Enforced by the builder's own limiter too, so a
# second app node cannot over-run this container.
# CYFR_MAX_CONCURRENT_BUILDS=2

# Structured JSON logs (Datadog, Splunk, ELK, Loki).
# CYFR_LOG_FORMAT=json
