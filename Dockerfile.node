# syntax=docker/dockerfile:1.7-labs
# Node-based services for the CYFR stack. Build context: repo root.
#
# Two targets:
#   --target porta       → the A.Q.U.A. PWA, built with vite and served by
#                          nginx (which also proxies /mcp /api /auth /t to
#                          cyfr:4000 — see apps/porta/nginx.conf).
#                          Published as ghcr.io/cyfrworks/cyfr-porta.
#   --target mcp-bridge  → the HTTP MCP gateway that wraps stdio/npx MCP
#                          servers; registered with cyfr like any other
#                          HTTP MCP. Source under apps/mcp-bridge/.
#
# e.g.  docker build -f Dockerfile.node --target porta      -t ghcr.io/cyfrworks/cyfr-porta .
#       docker build -f Dockerfile.node --target mcp-bridge -t cyfr-mcp-bridge .

FROM node:24-alpine AS base

# ===========================================================================
# porta — build the React PWA with vite, serve the static bundle with nginx.
# nginx proxies /mcp /api /auth /t to cyfr on the compose network (see
# apps/porta/nginx.conf — same route shape as the vite dev proxy and the
# Caddyfile). When Caddy is in front (the optional `tls` compose profile),
# Caddy fronts those paths first and this proxy never sees them. The runtime
# image carries only the built assets — no node_modules, no dev toolchain.
# ===========================================================================
FROM base AS porta-build
WORKDIR /app
COPY apps/porta/src-ui/package.json apps/porta/src-ui/package-lock.json ./
RUN npm ci
COPY apps/porta/src-ui/ ./
RUN npm run build

FROM nginx:1.27-alpine AS porta
LABEL org.opencontainers.image.licenses="Apache-2.0"
EXPOSE 8080
COPY apps/porta/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=porta-build /app/dist /usr/share/nginx/html
# This image contains only the Apache-2.0 Porta UI. Bundle the repo-level
# license docs so operators can see the full CYFR product license boundary.
COPY LICENSE FAIR_SOURCE.md /app/
COPY LICENSES/ /app/LICENSES/

# ===========================================================================
# mcp-bridge — HTTP MCP gateway. Single /mcp endpoint that surfaces:
#   • admin tools: add_backend / remove_backend / list_backends / restart_backend
#   • forwarded child tools, renamed `<backend>__<tool>`
# Children are stdio MCP servers (typically `npx -y <pkg>`) managed at
# runtime via the admin tools. State lives in /data/backends.json (bind-
# mounted from ./data/mcp-bridge on the host).
# ===========================================================================
FROM base AS mcp-bridge
LABEL org.opencontainers.image.licenses="Apache-2.0"
WORKDIR /app
COPY apps/mcp-bridge/package.json apps/mcp-bridge/package-lock.json ./
RUN npm ci --omit=dev
COPY apps/mcp-bridge/server.mjs ./
# This image contains only the Apache-2.0 bridge. Bundle the repo-level
# license docs so operators can see the full CYFR product license boundary.
COPY LICENSE FAIR_SOURCE.md /app/
COPY LICENSES/ /app/LICENSES/
ENV NODE_ENV=production
EXPOSE 8001
CMD ["node", "server.mjs"]
