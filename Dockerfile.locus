# syntax=docker/dockerfile:1.7-labs
# The Locus container: the untrusted things CYFR runs, and nothing else.
# One release serves three roles, each by its key and each in a container
# of its own: holding LOCUS_RUNTIME_KEY it is the runtime, the WASM engine
# and its worker service, reached by CYFR on its own listener and reaching
# CYFR's host API over HTTP (Prima.WorkerAPI, Prima.HostAPI); holding
# LOCUS_BUILDS_KEY it compiles components and tinctures over the build
# wire (Prima.BuilderProtocol), sources in a signed request and artifacts
# in its answer; holding LOCUS_BACKENDS_KEY it runs the stdio MCP servers
# CYFR registers over the backends wire (Prima.LocusBackends). A node that
# holds the runtime's key holds no other: its runners have no network, and
# it shares no node, key or network with a role that has open egress. The
# app image (Dockerfile) carries no compilers, engine or backend; this one
# carries no endpoint of the product's, no database and no tenant state,
# and the release holds only the shared contracts and Locus (`mix release
# locus`). Compose runs it three times, as locus-runtime, locus-builds and
# locus-backends, each with its own key, pool and network, and twice more
# as the egress guards of the builds and backends islands (cyfr-guard,
# apps/locus/keeper/guard/cyfr-guard.sh): a guard holds NET_ADMIN alone,
# installs the island's egress rules in a network namespace of its own,
# which the island's service then shares, and runs no release.
#
# Process model: cyfr-locus runs as root holding only SETUID, SETGID and
# KILL (it refuses to start with any other capability), starts the locus
# release as locus, and runs every runner, build or backend under a pooled
# uid of its own — runners as locus-runner01…locus-runner08 (30101-30108),
# builds as locus-build01…locus-build16 (30001-30016), backends as
# locus-backend01…locus-backend32 (20001-20032) — with a 0700 home under
# /var/lib/locus/homes, inside a memory bound of its own
# (LOCUS_RUNTIME_MEMORY_BYTES, 384 MiB, LOCUS_BUILDS_MEMORY_BYTES, 1 GiB,
# and LOCUS_BACKENDS_MEMORY_BYTES, 512 MiB, unless set). When a runner, a
# build or a backend ends every process of its uid is killed and
# everything the uid left is removed before another gets it; the locus
# release refuses to serve any role without cyfr-locus. A runner runs one
# execution subtree at a time (`Locus.Runtime.Runner`) with its control
# channel on file descriptor 3, holds no key, and the runtime's service
# loads no component.
#
# The memory bound is a cgroup v2 group cyfr-locus makes for each spawn, so
# the container must be started with the security option
# `writable-cgroups=true` (Docker Engine 28 or later on a cgroup v2 host).
# It adds no capability. Without it cyfr-locus cannot bound a spawn and
# refuses every one: the builds and backends services answer each
# `unavailable`, and the runtime starts no runner and logs, both naming the
# option; none runs unbounded.
#
# The runtime's runner pool is isolated (`runner:…:netns`): cyfr-locus
# clones every runner into a user and network namespace of its own,
# mapping only the runner's pooled uid and gid, whose loopback stays down,
# so a runner holds no capability and reaches nothing but the descriptors
# it inherited. The clone takes no capability of the container's, but two
# things of the host and the engine: the host allows unprivileged user
# namespaces (user.max_user_namespaces above 0, and where AppArmor
# restricts them, kernel.apparmor_restrict_unprivileged_userns), and the
# container runs under the seccomp profile /etc/cyfr/keeper.json carries,
# Docker's default with clone allowed to make a user and network namespace
# and unshare and setns denied (docker-compose.yml's locus-runtime
# `security_opt: seccomp=./keeper.seccomp.json`,
# apps/locus/keeper/seccomp/keeper.json shipped beside it), since Docker's
# own profile denies such a clone. Without either, cyfr-locus refuses to
# start, naming both. The runtime container's read-only root carries the
# build toolchain's files too; its runners still hold no capability, no
# route and no descriptor but their channel and relay.

# ---- The process helper, cyfr-locus: a static Go binary, pinned to the Go
# release apps/locus/keeper/go.mod names ----
FROM golang:1.27.3-alpine@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS keeper
WORKDIR /src
COPY apps/locus/keeper/go.mod apps/locus/keeper/go.sum ./
RUN go mod download
COPY apps/locus/keeper/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/cyfr-locus .

# ---- The release build ----
FROM hexpm/elixir:1.20.4-erlang-29.1.1-debian-trixie-20261005@sha256:fd5f8520b3836b8b1e5d5e6dd890d1fda394e4e378bbc0cbc67cd618f321e29b AS relbuilder

RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

ENV MIX_ENV=prod
# Mix through 1.20 can wait forever on its own build lock the second time a
# fresh lock directory is taken, and every build step starts one fresh. One
# Mix process at a time builds here, so the lock is off.
ENV MIX_OS_CONCURRENCY_LOCK=0

WORKDIR /app

RUN mix local.hex --force && mix local.rebar --force

# The release is built from the two apps it holds: the umbrella here is
# the contracts and Locus alone, so nothing of the control plane is
# fetched, compiled or present in this stage.
# The pinned wasm-tools every component is validated with
# (`Prima.ComponentFeatures`), its archive checked against the pinned
# sha256 by the one installer (scripts/wasm-tools.sh).
COPY scripts/wasm-tools.sh scripts/wasm-tools.sh
RUN scripts/wasm-tools.sh install /opt/wasm-tools

COPY mix.exs mix.lock ./
COPY apps/prima/mix.exs apps/prima/mix.exs
COPY apps/locus/mix.exs apps/locus/mix.exs

# The deps' precompiled NIFs are fetched into the caches their compiles
# read (rustler_precompiled's and elixir_make's) before the deps compile,
# which cannot download them itself
# (scripts/fetch-prebuilt-binaries.sh says why).
COPY scripts/fetch-prebuilt-binaries.sh scripts/fetch-prebuilt-binaries.sh
RUN mix deps.get --only prod && scripts/fetch-prebuilt-binaries.sh && mix deps.compile

COPY config/ config/
COPY apps/prima/ apps/prima/
COPY apps/locus/ apps/locus/
# Prima.WIT embeds the whole WIT tree at COMPILE time, and the
# runtime never reads it from disk: a release without its ABI fails the
# build here instead.
COPY wit/ wit/

RUN mix do compile + release locus --no-compile

# ---- The toolchain runtime ----
FROM debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f

LABEL org.opencontainers.image.source="https://github.com/cyfrworks/cyfr"
LABEL org.opencontainers.image.licenses="Apache-2.0"

# Debian publishes a fixed package before the base image is rebuilt around
# it, so take what the archive has at build time: the image scans in
# test.yml and release.yml fail on a fixable HIGH or CRITICAL.
# APT_REFRESH busts the build cache for this layer so the upgrade is not
# served stale from a cached layer: CI passes the UTC date (YYYY-MM-DD), so
# the layer refreshes once a day and is shared within it; a local build may
# leave it.
ARG APT_REFRESH=0
RUN echo "apt refresh ${APT_REFRESH}" && apt-get update && apt-get upgrade -y && apt-get install -y \
    libstdc++6 \
    openssl \
    libncurses6 \
    ca-certificates \
    curl \
    locales \
    build-essential \
    iptables \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen \
    && locale-gen

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/usr/local/cargo/bin:$PATH"

# rustup-init is version- and checksum-pinned (hashes from
# static.rust-lang.org's own .sha256 files) instead of `curl | sh` of a
# moving script that runs as root at build time, and it installs the Rust
# release rust-toolchain.toml names as the default toolchain, so a build
# does not take whatever stable is current.
ARG RUSTUP_VERSION=1.28.2
ARG CARGO_COMPONENT_VERSION=0.21.1
COPY rust-toolchain.toml /tmp/rust-toolchain.toml
RUN ARCH=$(dpkg --print-architecture) \
    && RUST_TOOLCHAIN=$(sed -n 's/^channel = "\([0-9][0-9.]*\)"$/\1/p' /tmp/rust-toolchain.toml) \
    && { [ -n "$RUST_TOOLCHAIN" ] || { echo "rust-toolchain.toml names no channel"; exit 1; }; } \
    && case "$ARCH" in \
         amd64) RUST_TRIPLE=x86_64-unknown-linux-gnu; RUSTUP_SHA=20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c ;; \
         arm64) RUST_TRIPLE=aarch64-unknown-linux-gnu; RUSTUP_SHA=e3853c5a252fca15252d07cb23a1bdd9377a8c6f3efa01531109281ae47f841c ;; \
         *) echo "Unsupported architecture: $ARCH" && exit 1 ;; \
       esac \
    && curl --proto '=https' --tlsv1.2 -fsSL \
       "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${RUST_TRIPLE}/rustup-init" \
       -o /tmp/rustup-init \
    && echo "${RUSTUP_SHA}  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --profile minimal --default-toolchain "$RUST_TOOLCHAIN" \
    && rm /tmp/rustup-init /tmp/rust-toolchain.toml \
    && [ "$(rustc --version | cut -d' ' -f2)" = "$RUST_TOOLCHAIN" ] \
    && rustup target add wasm32-wasip1 wasm32-wasip2 \
    && cargo install --locked cargo-component@${CARGO_COMPONENT_VERSION} \
    && rm -rf /usr/local/cargo/registry /usr/local/cargo/git \
    && mkdir -p /usr/local/cargo/registry /usr/local/cargo/git

# Node.js LTS for tincture builds (npm + Vite) and for the stdio MCP
# servers the backends service runs (`npx -y <package>`). Direct binary
# install, checksum-pinned against nodejs.org's SHASUMS256.txt for this
# version.
ARG NODE_VERSION=24.22.1
RUN ARCH=$(dpkg --print-architecture) \
    && case "$ARCH" in \
         amd64) NODE_ARCH=x64; NODE_SHA=6c172a9ab6718f7b801fb5a7bd486af2ee5e32758086a04b84fcce2aa77095e6 ;; \
         arm64) NODE_ARCH=arm64; NODE_SHA=dbabf7a1cbf947e6059ffad2c27b80041db97dea1e553b62afdee7f13fca336e ;; \
         *) echo "Unsupported architecture: $ARCH" && exit 1 ;; \
       esac \
    && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" \
       -o /tmp/node.tar.xz \
    && echo "${NODE_SHA}  /tmp/node.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
    && rm /tmp/node.tar.xz \
    && node --version && npm --version

# The toolchains stay root-owned: a build or a backend reads them and
# writes only its own home, so none can alter what the next one runs
# with. Every spawn runs with cyfr-locus's fixed PATH, so the Rust
# toolchain's commands are linked into /usr/local/bin.
RUN ln -s /usr/local/cargo/bin/* /usr/local/bin/

# The locus release's user, the runner pool, the build pool and the
# backend pool: each user is alone in its own group and belongs to no
# other. /run/locus holds the release's temporary files and the attach
# socket spawns' relays connect to; the home root holds each spawn's 0700
# home, on a tmpfs mounted with mode=1733.
RUN groupadd -r -g 10001 locus \
    && useradd -r -u 10001 -g locus -d /nonexistent -M -s /usr/sbin/nologin locus \
    && for i in $(seq 1 8); do \
         name="$(printf 'locus-runner%02d' "$i")"; uid=$((30100 + i)); \
         groupadd -r -g "$uid" "$name" \
         && useradd -r -u "$uid" -g "$name" -d /nonexistent -M -s /usr/sbin/nologin "$name" || exit 1; \
       done \
    && for i in $(seq 1 16); do \
         name="$(printf 'locus-build%02d' "$i")"; uid=$((30000 + i)); \
         groupadd -r -g "$uid" "$name" \
         && useradd -r -u "$uid" -g "$name" -d /nonexistent -M -s /usr/sbin/nologin "$name" || exit 1; \
       done \
    && for i in $(seq 1 32); do \
         name="$(printf 'locus-backend%02d' "$i")"; uid=$((20000 + i)); \
         groupadd -r -g "$uid" "$name" \
         && useradd -r -u "$uid" -g "$name" -d /nonexistent -M -s /usr/sbin/nologin "$name" || exit 1; \
       done \
    && install -d -m 1733 -o root -g root /var/lib/locus/homes \
    && install -d -m 0700 -o locus -g locus /run/locus

ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8
ENV ELIXIR_ERL_OPTIONS="+fnu"

WORKDIR /app

COPY --from=keeper /out/cyfr-locus /usr/local/bin/cyfr-locus
COPY apps/locus/keeper/seccomp/keeper.json /etc/cyfr/keeper.json
# The egress guard the builds and backends islands run (docker-compose.yml's
# locus-builds-guard and locus-backends-guard); iptables, installed above,
# is its one tool.
COPY --chmod=0755 apps/locus/keeper/guard/cyfr-guard.sh /usr/local/bin/cyfr-guard
COPY --from=relbuilder /app/_build/prod/rel/locus ./
COPY --from=relbuilder /opt/wasm-tools/wasm-tools /usr/local/bin/wasm-tools
COPY LICENSE FAIR_SOURCE.md /app/
COPY LICENSES/ /app/LICENSES/

# The crates every scaffolded Rust component depends on, fetched once into
# a root-owned Cargo home; each build copies its registry cache into the
# build's own Cargo home (`LOCUS_BUILDS_CARGO_SEED`). The manifests are the
# release's own templates, so the seed follows the scaffold. The release
# boots nothing without a builds key, this one-off command included, so it
# is given one made here and kept nowhere.
ENV LOCUS_BUILDS_CARGO_SEED=/opt/cyfr/cargo-seed
RUN LOCUS_BUILDS_KEY="$(head -c 32 /dev/urandom | od -An -v -tx1 | tr -d ' \n')" \
    /app/bin/locus eval ' \
      for type <- [:reagent, :catalyst, :formula] do \
        dir = Path.join("/tmp/cargo-seed", Atom.to_string(type)); \
        File.mkdir_p!(Path.join(dir, "src")); \
        File.write!(Path.join(dir, "src/lib.rs"), ""); \
        File.write!(Path.join(dir, "Cargo.toml"), Locus.Builder.cargo_toml_for(type)) \
      end' \
    && for manifest in /tmp/cargo-seed/*/Cargo.toml; do \
         CARGO_HOME="$LOCUS_BUILDS_CARGO_SEED" cargo fetch --manifest-path "$manifest" || exit 1; \
       done \
    && rm -rf /tmp/cargo-seed

# The release starts no Erlang distribution: a listener any guest, build
# or backend could reach, authenticated by a cookie any of them could read.
# Its temporary files go where only its own user can reach them; a
# runner's go under the home the keeper gives it
# (`Locus.Runtime.Release.runner_command/0`).
ENV RELEASE_DISTRIBUTION=none \
    RELEASE_TMP=/run/locus

ARG LOCUS_RUNTIME_PORT=4200
ARG LOCUS_BUILDS_PORT=4100
ARG LOCUS_BACKENDS_PORT=4101
EXPOSE ${LOCUS_RUNTIME_PORT} ${LOCUS_BUILDS_PORT} ${LOCUS_BACKENDS_PORT}

# The builds wire's health operation: a POST of the versioned body,
# answered without a key (Prima.BuilderProtocol). A container serving the
# backends service or the runtime probes its own (Prima.LocusBackends, and
# the worker listener's 401 to an unsigned status request), as
# docker-compose.yml's locus-backends and locus-runtime services do.
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 \
    CMD curl -fsS -X POST -H 'content-type: application/json' -d '{"version":1}' \
        "http://localhost:${LOCUS_BUILDS_PORT:-4100}/locus/v1/builds/health" || exit 1

# Run with `cap_drop: [ALL]`, `cap_add: [SETUID, SETGID, KILL]`,
# `security_opt: [no-new-privileges, writable-cgroups=true]`, a read-only
# root, `ipc: none` and the homes and /run/locus tmpfs mounts
# (docker-compose.yml's locus-builds service). The backends service runs
# the same image with the backends pool in its place (docker-compose.yml's
# locus-backends service), and the runtime with the isolated runner pool
# and the seccomp profile above (docker-compose.yml's locus-runtime
# service).
ENTRYPOINT ["cyfr-locus", "serve", "--pool", "build:30001-30016", "--home-root", "/var/lib/locus/homes", "--client-user", "locus", "--", "/app/bin/locus", "start"]
