# syntax=docker/dockerfile:1.7-labs
# The Locus container: the untrusted things CYFR runs, and nothing else.
# One release serves three roles, each by its key and each as a process of
# its own that cyfr-locus starts: holding LOCUS_RUNTIME_KEY it is the
# runtime, the WASM engine and its worker service, reached by CYFR on its
# own listener and reaching CYFR's host API over HTTP (Prima.WorkerAPI,
# Prima.HostAPI); holding LOCUS_BUILDS_KEY it compiles components and
# tinctures over the build wire (Prima.BuilderProtocol), sources in a
# signed request and artifacts in its answer; holding LOCUS_BACKENDS_KEY it
# runs the stdio MCP servers CYFR registers over the backends wire
# (Prima.LocusBackends). A role process that holds the runtime's key holds
# no other, and no role sees another's key, variables, processes, files,
# port or spawns. The app image (Dockerfile) carries no compilers, engine
# or backend; this one carries no endpoint of the product's, no database
# and no tenant state, and the release holds only the shared contracts and
# Locus (`mix release locus`). Compose runs it once as locus, behind its
# egress guard, and once more as that guard (`cyfr-locus guard-control`,
# apps/locus/keeper/guard): the guard holds NET_ADMIN alone,
# installs the egress rules in a network namespace of its own, which locus
# then shares, makes each role process's and each spawn's one route, and
# runs no release.
#
# Process model: cyfr-locus runs as root holding only SETUID, SETGID and
# KILL (it refuses to start with any other capability) and starts, for each
# role whose key it holds, the locus release as that role's user in a space
# of its own: locus-runtime (10011), locus-builds (10012) and
# locus-backends (10013), each with a run folder of its own under
# /run/locus and an environment holding its own variables alone. It runs
# every runner, build or backend under a pooled uid of its own — runners
# as locus-runner01…locus-runner08 (30101-30108), builds as
# locus-build01…locus-build16 (30001-30016), backends as
# locus-backend01…locus-backend32 (20001-20032) — with a 0700 home under
# its role's folder of /var/lib/locus/homes, or a program's kept home
# on its person's disk under /var/lib/locus/kept, owned by that disk's
# one uid (40001-49999, no user entry), inside a memory bound of its own that the keeper sets by
# its kind (a build 1 GiB, a runner and a backend half of the pool's work,
# never under 420 MiB and 384 MiB), and inside the
# pool's work, one memory bound for all of Locus's work, at its role's
# processors (LOCUS_CORE_RESERVE_BYTES, LOCUS_SERVICE_BYTES and
# LOCUS_<ROLE>_CPU_LIMIT). When a runner, a build or a
# backend ends every process of its uid is killed and everything the uid
# left is removed before another gets it; when a role process ends, every
# spawn of its own is retired and it starts again alone. The locus release
# refuses to serve any role without cyfr-locus. A runner runs one
# execution subtree at a time (`Locus.Runtime.Runner`) with its control
# channel on file descriptor 3, holds no key, and the runtime's service
# loads no component.
#
# The memory bound is a cgroup v2 group cyfr-locus makes for each spawn, so
# the container must be started with the security option
# `writable-cgroups=true` (Docker Engine 28 or later on a cgroup v2 host).
# It adds no capability. Without it cyfr-locus can make no role's group
# and refuses to start; nothing runs unbounded.
#
# Every spawn runs in a space of its own: cyfr-locus clones it into a user,
# network and IPC namespace mapping only its pooled uid and gid, so it
# holds no capability and shares no loopback, abstract socket or System V
# object with anything else, and the space's first process into a pid,
# mount and cgroup namespace, where it builds the space's files under
# /var/lib/locus/space: this image read-only, a /proc of the space's own
# processes, its own /tmp, /dev/shm, /run and terminals, its group alone,
# and its home, the only home it sees. Each pool names its spaces' reach:
# the runtime's runners are relay spaces (`runner:…:relay`), whose loopback
# stays down and whose relay is their one way to anything; builds and
# backends are routed spaces (`:routed`), each with its own loopback and
# the one route the guard makes for it (`--guard`), and so is each role
# process, its port forwarded in from CYFR's network alone. The space
# takes no capability of the container's, but three things of the host and
# the engine: the host allows unprivileged user namespaces
# (user.max_user_namespaces above 0); the container runs under the seccomp
# profile /etc/cyfr/keeper.json carries, Docker's default with clone
# allowed to make the space's namespaces and the space's mounts allowed,
# unshare, setns and socketcall denied, socket's and socketpair's domain
# and personality's persona compared by their low 32 bits, as the kernel
# reads them, and every 32-bit and x32 call killed (docker-compose.yml's locus service's
# `security_opt: seccomp=./keeper.seccomp.json`,
# apps/locus/keeper/seccomp/keeper.json shipped beside it); and on a host
# with AppArmor, under this release's profile by its name
# (apps/codex/internal/apparmor, which `cyfr init` and `cyfr update` load
# and .env's CYFR_LOCUS_APPARMOR names), with its system paths unmasked
# (`systempaths=unconfined`). Without any of them, cyfr-locus refuses to
# start, naming what to check. The read-only root the runtime's runners
# see carries the build toolchain's files too; they still hold no
# capability, no route and no descriptor but their channel and relay.

# ---- The process helper, cyfr-locus, cyfr-stub, cyfr-browser, cyfr-fetch
# and the brain drivers cyfr-claude-code, cyfr-codex and cyfr-acp: static Go binaries, pinned
# to the Go release apps/locus/keeper/go.mod names ----
FROM golang:1.27.4-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS keeper
WORKDIR /src
COPY apps/locus/keeper/go.mod apps/locus/keeper/go.sum ./
RUN go mod download
COPY apps/locus/keeper/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/cyfr-locus . \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/cyfr-stub ./cmd/cyfr-stub \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/cyfr-browser ./cmd/cyfr-browser \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/cyfr-claude-code ./cmd/cyfr-claude-code \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/cyfr-codex ./cmd/cyfr-codex \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/cyfr-acp ./cmd/cyfr-acp \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/cyfr-fetch ./cmd/cyfr-fetch \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/cyfr-guest ./cmd/cyfr-guest

# ---- A person's machine (apps/locus/keeper/internal/vm): the guest kernel,
# its system-call table, by which the guest's first process compiles the
# keeper's seccomp profile (package outer), and its VMM, on amd64 alone. Linux, pinned by its archive's sha256, built
# from Firecracker's microVM configuration at the pinned release (each file
# pinned by its sha256) with apps/locus/guest/kernel.config over it, and
# Firecracker itself, pinned by its release archive's sha256. The arm64
# image carries neither: its keeper runs no machine, as on a host without
# KVM, until a Raspberry Pi 5 proves one. ----
FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS guest
ARG TARGETARCH
ARG LINUX_VERSION=6.18.65
ARG LINUX_SHA256=c92606f956f09dc50b5a0e2af9e86763fce27ada1647de97f8d1ac8cfc95801d
ARG FIRECRACKER_VERSION=v1.18.0
ARG FIRECRACKER_SHA256=1ac8eec866dd5eea14efecf6323e22b23eea24054545338a5b34bc5bca6623cd
ARG FIRECRACKER_CONFIG_SHA256=ba22401a0c7292a4c024ebcd10a562d4a1f1bfd2faed671406d3b159c0cf5215
ARG FIRECRACKER_CI_CONFIG_SHA256=6ce47107d9fb695a873ffc4733a1d8e1b4941c4f272e20dac4bf163dfb77f47e
COPY apps/locus/guest/kernel.config /tmp/kernel.config
RUN mkdir -p /out && if [ "$TARGETARCH" != amd64 ]; then exit 0; fi \
    && apt-get update && apt-get install -y --no-install-recommends build-essential flex bison bc libelf-dev \
       libssl-dev xz-utils cpio kmod python3 dwarves ca-certificates curl \
    && cd /tmp \
    && curl -fsSL "https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-${LINUX_VERSION}.tar.xz" -o linux.tar.xz \
    && echo "${LINUX_SHA256}  linux.tar.xz" | sha256sum -c - \
    && configs="https://raw.githubusercontent.com/firecracker-microvm/firecracker/${FIRECRACKER_VERSION}/resources/guest_configs" \
    && curl -fsSL "$configs/microvm-kernel-ci-x86_64-6.18.config" -o microvm.config \
    && curl -fsSL "$configs/ci.config" -o ci.config \
    && echo "${FIRECRACKER_CONFIG_SHA256}  microvm.config" | sha256sum -c - \
    && echo "${FIRECRACKER_CI_CONFIG_SHA256}  ci.config" | sha256sum -c - \
    && curl -fsSL "https://github.com/firecracker-microvm/firecracker/releases/download/${FIRECRACKER_VERSION}/firecracker-${FIRECRACKER_VERSION}-x86_64.tgz" -o firecracker.tgz \
    && echo "${FIRECRACKER_SHA256}  firecracker.tgz" | sha256sum -c - \
    && tar -xzf firecracker.tgz "release-${FIRECRACKER_VERSION}-x86_64/firecracker-${FIRECRACKER_VERSION}-x86_64" \
    && install -m 0755 "release-${FIRECRACKER_VERSION}-x86_64/firecracker-${FIRECRACKER_VERSION}-x86_64" /out/firecracker \
    && mkdir linux && tar -xJf linux.tar.xz -C linux --strip-components=1 && cd linux \
    && cp ../microvm.config .config \
    && scripts/kconfig/merge_config.sh -m .config ../ci.config /tmp/kernel.config \
    && make olddefconfig \
    && grep -E '^CONFIG_.*=y|^# CONFIG_.* is not set' /tmp/kernel.config | while read -r option; do grep -qx "$option" .config || { echo "the guest kernel's configuration lacks: $option"; exit 1; }; done \
    && make -j"$(nproc)" vmlinux \
    && install -m 0644 vmlinux /out/vmlinux \
    && install -m 0644 arch/x86/entry/syscalls/syscall_64.tbl /out/syscall_64.tbl \
    && cd / && rm -rf /tmp/linux /tmp/*.tar.xz /tmp/*.tgz

# ---- The release build ----
FROM hexpm/elixir:1.20.4-erlang-29.1.1-debian-trixie-20261005@sha256:fd5f8520b3836b8b1e5d5e6dd890d1fda394e4e378bbc0cbc67cd618f321e29b AS relbuilder

RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

ENV MIX_ENV=prod
# Mix through 1.20 can wait forever on its own build lock the second time a
# fresh lock directory is taken, and every build step starts one fresh. One
# Mix process at a time builds here, so the lock is off.
ENV MIX_OS_CONCURRENCY_LOCK=0

WORKDIR /app

RUN mix local.hex --force && mix local.rebar --force

# The release is built from the two apps it holds: the umbrella here is
# the contracts and Locus alone, so nothing of the control plane is
# fetched, compiled or present in this stage.
# The pinned wasm-tools every component is validated with
# (`Prima.ComponentFeatures`), its archive checked against the pinned
# sha256 by the one installer (scripts/wasm-tools.sh).
COPY scripts/wasm-tools.sh scripts/wasm-tools.sh
RUN scripts/wasm-tools.sh install /opt/wasm-tools

COPY mix.exs mix.lock ./
COPY apps/prima/mix.exs apps/prima/mix.exs
COPY apps/locus/mix.exs apps/locus/mix.exs

# The deps' precompiled NIFs are fetched into the caches their compiles
# read (rustler_precompiled's and elixir_make's) before the deps compile,
# which cannot download them itself
# (scripts/fetch-prebuilt-binaries.sh says why).
COPY scripts/fetch-prebuilt-binaries.sh scripts/fetch-prebuilt-binaries.sh
RUN mix deps.get --only prod && scripts/fetch-prebuilt-binaries.sh && mix deps.compile

COPY config/ config/
COPY apps/prima/ apps/prima/
COPY apps/locus/ apps/locus/
# Prima.WIT embeds the whole WIT tree at COMPILE time, and the
# runtime never reads it from disk: a release without its ABI fails the
# build here instead.
COPY wit/ wit/

RUN mix do compile + release locus --no-compile

# ---- The toolchain runtime ----
FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad

LABEL org.opencontainers.image.source="https://github.com/cyfrworks/cyfr"
LABEL org.opencontainers.image.licenses="Apache-2.0"

# Debian publishes a fixed package before the base image is rebuilt around
# it, so take what the archive has at build time: the image scans in
# test.yml and release.yml fail on a fixable HIGH or CRITICAL.
# APT_REFRESH is the archive's key (scripts/apt-key.sh), which CI reads
# when its build starts: the layer is reused while the archive holds what
# it held, and built again on the archive's packages as soon as one moves,
# a published fix among them. The script, mounted for this layer alone,
# holds apt's lists to that key, so no layer is cached under a key its
# lists were not. A local build may leave it at 0, unchecked.
#
# Aqua's browser is Debian's Chromium (cyfr-browser, below), its headless
# shell, upgraded with the rest at each build, with a font for the pages
# it renders. The shell is the browser engine alone: no sign-in, sync,
# component updater or session restore, so it reaches nothing by itself.
# It links libgbm, which a headless browser does not use: it allocates no
# GPU buffer. So Mesa's gallium driver, which libgbm1 depends on, is
# purged past the dependency check with what it alone pulled in (LLVM, Z3
# and theirs, about 190 MiB), so none of it is present or listed: starting
# from mesa-libgallium, a package the shell brought joins the purge when
# only the purge's own packages depend on it. What depends on
# mesa-libgallium keeps that one unmet dependency, and every other
# dependency stays met. No later layer and nothing at run time calls apt,
# and one that did would have to install mesa-libgallium first.
ARG APT_REFRESH=0
RUN --mount=type=bind,source=scripts/apt-key.sh,target=/tmp/apt-key.sh \
    bash /tmp/apt-key.sh --update "${APT_REFRESH}" && apt-get upgrade -y && apt-get install -y \
    libstdc++6 \
    openssl \
    libncurses6 \
    ca-certificates \
    curl \
    locales \
    build-essential \
    iptables \
    squashfs-tools \
    procps \
    && apt-get install -y --no-install-recommends fonts-liberation fonts-dejavu-core fonts-noto-color-emoji fonts-noto-cjk \
    && dpkg-query -W -f '${Package}\n' | sort > /tmp/before-browser \
    && apt-get install -y --no-install-recommends chromium-headless-shell \
    && dpkg-query -W -f '${Package}\n' | sort | comm -13 /tmp/before-browser - > /tmp/browser-brought \
    && depends() { dpkg-query -W -f '${Depends},${Pre-Depends}\n' "$@" | tr ',' '\n' \
         | sed 's/ *(.*//; s/ *|.*//; s/^ *//; s/:any$//' | grep . | sort -u; } \
    && echo mesa-libgallium > /tmp/purged \
    && while :; do \
         { cat /tmp/purged; depends $(cat /tmp/purged) | grep -xF -f /tmp/browser-brought; } | sort -u > /tmp/candidates; \
         dpkg-query -W -f '${Package}\n' | grep -vxF -f /tmp/candidates > /tmp/outside; \
         depends $(cat /tmp/outside) | grep -vx mesa-libgallium > /tmp/wanted; \
         { echo mesa-libgallium; grep -vxF -f /tmp/wanted /tmp/candidates; } | sort -u > /tmp/next; \
         cmp -s /tmp/next /tmp/purged && break; \
         mv /tmp/next /tmp/purged; \
       done \
    && grep -q '^libllvm' /tmp/purged \
    && dpkg --purge --force-depends $(cat /tmp/purged) \
    && rm /tmp/before-browser /tmp/browser-brought /tmp/purged /tmp/candidates /tmp/outside /tmp/wanted /tmp/next \
    && ldconfig \
    && ! ldd /usr/lib/chromium/chromium-headless-shell /usr/lib/*/libgbm.so.1 | grep -q 'not found' \
    && ! apt-get check 2>&1 | grep 'Depends:' | grep -qv 'Depends: mesa-libgallium ' \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen \
    && locale-gen

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/usr/local/cargo/bin:$PATH"

# rustup-init is version- and checksum-pinned (hashes from
# static.rust-lang.org's own .sha256 files) instead of `curl | sh` of a
# moving script that runs as root at build time, and it installs the Rust
# release rust-toolchain.toml names as the default toolchain, so a build
# does not take whatever stable is current.
ARG RUSTUP_VERSION=1.28.2
ARG CARGO_COMPONENT_VERSION=0.21.1
COPY rust-toolchain.toml /tmp/rust-toolchain.toml
RUN ARCH=$(dpkg --print-architecture) \
    && RUST_TOOLCHAIN=$(sed -n 's/^channel = "\([0-9][0-9.]*\)"$/\1/p' /tmp/rust-toolchain.toml) \
    && { [ -n "$RUST_TOOLCHAIN" ] || { echo "rust-toolchain.toml names no channel"; exit 1; }; } \
    && case "$ARCH" in \
         amd64) RUST_TRIPLE=x86_64-unknown-linux-gnu; RUSTUP_SHA=20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c ;; \
         arm64) RUST_TRIPLE=aarch64-unknown-linux-gnu; RUSTUP_SHA=e3853c5a252fca15252d07cb23a1bdd9377a8c6f3efa01531109281ae47f841c ;; \
         *) echo "Unsupported architecture: $ARCH" && exit 1 ;; \
       esac \
    && curl --proto '=https' --tlsv1.2 -fsSL \
       "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${RUST_TRIPLE}/rustup-init" \
       -o /tmp/rustup-init \
    && echo "${RUSTUP_SHA}  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --profile minimal --default-toolchain "$RUST_TOOLCHAIN" \
    && rm /tmp/rustup-init /tmp/rust-toolchain.toml \
    && [ "$(rustc --version | cut -d' ' -f2)" = "$RUST_TOOLCHAIN" ] \
    && rustup target add wasm32-wasip1 wasm32-wasip2 \
    && cargo install --locked cargo-component@${CARGO_COMPONENT_VERSION} \
    && rm -rf /usr/local/cargo/registry /usr/local/cargo/git \
    && mkdir -p /usr/local/cargo/registry /usr/local/cargo/git

# Node.js LTS for tincture builds (npm + Vite) and for the stdio MCP
# servers the backends role runs (`npx -y <package>`). Direct binary
# install, checksum-pinned against nodejs.org's SHASUMS256.txt for this
# version.
ARG NODE_VERSION=24.22.1
RUN ARCH=$(dpkg --print-architecture) \
    && case "$ARCH" in \
         amd64) NODE_ARCH=x64; NODE_SHA=6c172a9ab6718f7b801fb5a7bd486af2ee5e32758086a04b84fcce2aa77095e6 ;; \
         arm64) NODE_ARCH=arm64; NODE_SHA=dbabf7a1cbf947e6059ffad2c27b80041db97dea1e553b62afdee7f13fca336e ;; \
         *) echo "Unsupported architecture: $ARCH" && exit 1 ;; \
       esac \
    && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" \
       -o /tmp/node.tar.xz \
    && echo "${NODE_SHA}  /tmp/node.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
    && rm /tmp/node.tar.xz \
    && node --version && npm --version

# The toolchains stay root-owned: a build or a backend reads them and
# writes only its own home, so none can alter what the next one runs
# with. Every spawn's PATH ends with the system's, which cyfr-locus fixes
# (apps/locus/keeper/internal/stage/spec.go), so the Rust toolchain's
# commands are linked into /usr/local/bin.
RUN ln -s /usr/local/cargo/bin/* /usr/local/bin/

# The three role users, the runner pool, the build pool and the backend
# pool: each user is alone in its own group and belongs to no other. The
# locus group, which has no member, shares the kept homes' root. /run/locus
# is root's, 0711, holding a 0700 folder of each role's own: the release's
# temporary files and the socket its spawns' relays connect to. The home
# root holds a folder of each role's, where each spawn of the role makes
# its 0700 home; compose mounts a tmpfs of mode 1733 over each.
# /var/lib/locus/kept is the kept homes' root, the `homes` volume, which
# takes this directory's owner and mode when it is first made: root's and
# the locus group's, 1773, as the keeper's start checks; the keeper alone
# lists it, and a disk's uid, which has no user entry, makes its own
# 0700 folder there, the person's disk. /var/lib/locus/space is where a space's first
# process builds the space's files, in a mount namespace of its own: here
# it stays empty.
RUN groupadd -r -g 10001 locus \
    && for role in runtime:10011 builds:10012 backends:10013; do \
         name="locus-${role%%:*}"; uid="${role##*:}"; \
         groupadd -r -g "$uid" "$name" \
         && useradd -r -u "$uid" -g "$name" -d /nonexistent -M -s /usr/sbin/nologin "$name" \
         && install -d -m 0700 -o "$name" -g "$name" "/run/locus/${role%%:*}" \
         && install -d -m 1733 -o root -g root "/var/lib/locus/homes/${role%%:*}" || exit 1; \
       done \
    && for i in $(seq 1 8); do \
         name="$(printf 'locus-runner%02d' "$i")"; uid=$((30100 + i)); \
         groupadd -r -g "$uid" "$name" \
         && useradd -r -u "$uid" -g "$name" -d /nonexistent -M -s /usr/sbin/nologin "$name" || exit 1; \
       done \
    && for i in $(seq 1 16); do \
         name="$(printf 'locus-build%02d' "$i")"; uid=$((30000 + i)); \
         groupadd -r -g "$uid" "$name" \
         && useradd -r -u "$uid" -g "$name" -d /nonexistent -M -s /usr/sbin/nologin "$name" || exit 1; \
       done \
    && for i in $(seq 1 32); do \
         name="$(printf 'locus-backend%02d' "$i")"; uid=$((20000 + i)); \
         groupadd -r -g "$uid" "$name" \
         && useradd -r -u "$uid" -g "$name" -d /nonexistent -M -s /usr/sbin/nologin "$name" || exit 1; \
       done \
    && chmod 0711 /run/locus \
    && chmod 0755 /var/lib/locus/homes \
    && install -d -m 1773 -o root -g locus /var/lib/locus/kept \
    && install -d -m 0755 -o root -g root /var/lib/locus/space

ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8
ENV ELIXIR_ERL_OPTIONS="+fnu"

WORKDIR /app

COPY --from=keeper /out/cyfr-locus /usr/local/bin/cyfr-locus
# A person's machine: the guest agent, which a guest's kernel runs as its
# first process from the image's programs (squashfs-tools' mksquashfs, above,
# makes them into the machines' device in the `guest` volume), and on amd64
# the guest kernel and Firecracker (package vm).
# The volume's mount point, /var/lib/locus/guest, is Docker's to make: a
# new volume is root's, 0755, and each machine's sockets are kept there
# too, in a folder root's and its VMM's group's alone.
COPY --from=keeper /out/cyfr-guest /usr/local/bin/cyfr-guest
COPY --from=guest /out/ /usr/lib/cyfr/guest/
# CYFR's drivers and the stub, in /opt/cyfr/bin alone, which is first on a
# kept program's PATH (apps/locus/keeper/internal/stage/spec.go), so a
# command of the same name a person installs is never found in their place.
# The MCP stdio server a harness the backends role runs reaches CYFR's
# tools through (Claude Code, which its brain driver cyfr-claude-code sets
# it up for): it answers each call from the answer CYFR puts in the call's
# input, and holds nothing.
COPY --from=keeper /out/cyfr-stub /opt/cyfr/bin/cyfr-stub
# Aqua's browser: the command of a person's browser row, which the backends
# role runs on a terminal in the row's kept home. It starts the image's
# Chromium headless shell with its profile there and drives it over its
# debugging pipe, which stays inside the box: no debugging port is opened.
COPY --from=keeper /out/cyfr-browser /opt/cyfr/bin/cyfr-browser
# Claude Code's driver, as a brain of CYFR's: the start of a brain row's
# command, before the harness's own, which it starts and speaks the
# harness's protocol to in the row's kept home; it speaks the brain wire to
# its holder, and on a terminal runs the harness unchanged. The image
# carries no Claude Code: the row's command fetches it.
COPY --from=keeper /out/cyfr-claude-code /opt/cyfr/bin/cyfr-claude-code
# OpenAI Codex's driver, as a brain of CYFR's, the same way: it starts the
# harness's app-server in the row's kept home and speaks its protocol.
COPY --from=keeper /out/cyfr-codex /opt/cyfr/bin/cyfr-codex
# The one driver of programs that speak the Agent Client Protocol, linked
# under one name a program, the name it runs under picking its program
# (cyfr-antigravity, cyfr-opencode, cyfr-cursor). Its harness reaches
# CYFR's tools through the stub in socket mode, on a socket inside the
# session's own space.
COPY --from=keeper /out/cyfr-acp /opt/cyfr/bin/cyfr-acp
RUN ln -s cyfr-acp /opt/cyfr/bin/cyfr-antigravity && ln -s cyfr-acp /opt/cyfr/bin/cyfr-opencode \
    && ln -s cyfr-acp /opt/cyfr/bin/cyfr-cursor
# The pinned, checksummed fetch of a program that is not on npm into the
# row's own folder, before it runs it (Antigravity's, OpenCode's and
# Cursor's rows): the image carries no program.
COPY --from=keeper /out/cyfr-fetch /opt/cyfr/bin/cyfr-fetch
COPY apps/locus/keeper/seccomp/keeper.json /etc/cyfr/keeper.json
# The name of the AppArmor profile this release runs under, which the
# keeper proves at its boot (its stage.ProfileNameFile).
COPY apps/codex/internal/apparmor/name /etc/cyfr/apparmor-profile
# The container's health probe, each role whose key it holds (HEALTHCHECK).
COPY --chmod=0755 apps/locus/health.sh /usr/local/bin/locus-health
COPY --from=relbuilder /app/_build/prod/rel/locus ./
COPY --from=relbuilder /opt/wasm-tools/wasm-tools /usr/local/bin/wasm-tools
COPY LICENSE FAIR_SOURCE.md /app/
COPY LICENSES/ /app/LICENSES/

# The crates every scaffolded Rust component depends on, fetched once into
# a root-owned Cargo home; each build copies its registry cache into the
# build's own Cargo home (`LOCUS_BUILDS_CARGO_SEED`). The manifests are the
# release's own templates, so the seed follows the scaffold. The release
# boots nothing without a builds key, this one-off command included, so it
# is given one made here and kept nowhere.
ENV LOCUS_BUILDS_CARGO_SEED=/opt/cyfr/cargo-seed
RUN LOCUS_BUILDS_KEY="$(head -c 32 /dev/urandom | od -An -v -tx1 | tr -d ' \n')" \
    /app/bin/locus eval ' \
      for type <- [:reagent, :catalyst, :formula] do \
        dir = Path.join("/tmp/cargo-seed", Atom.to_string(type)); \
        File.mkdir_p!(Path.join(dir, "src")); \
        File.write!(Path.join(dir, "src/lib.rs"), ""); \
        File.write!(Path.join(dir, "Cargo.toml"), Locus.Builder.cargo_toml_for(type)) \
      end' \
    && for manifest in /tmp/cargo-seed/*/Cargo.toml; do \
         CARGO_HOME="$LOCUS_BUILDS_CARGO_SEED" cargo fetch --manifest-path "$manifest" || exit 1; \
       done \
    && rm -rf /tmp/cargo-seed

# The image's identity, last of every file: a digest of its root, every
# path's type, mode, owner and link target and every file's contents, each
# field preceded by its length so none runs into the next, which names the
# machines' device the keeper makes from it, so a new image makes a new one
# (package vm's ImageDigest and Programs).
RUN cyfr-locus image-digest > /etc/cyfr/image-digest

# The release starts no Erlang distribution: a listener any guest, build
# or backend could reach, authenticated by a cookie any of them could read.
# Each role process's temporary files go in its own run folder, which the
# keeper names as its RELEASE_TMP; a runner's go under the home the keeper
# gives it (`Locus.Runtime.Release.runner_command/0`).
ENV RELEASE_DISTRIBUTION=none

# Every role whose key the container holds answers at its port, each at
# its wire's version (apps/locus/health.sh); none held, it is unhealthy.
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 \
    CMD ["locus-health"]

# Run with `cap_drop: [ALL]`, `cap_add: [SETUID, SETGID, KILL]`,
# `security_opt: [no-new-privileges, writable-cgroups=true,
# seccomp=keeper.json]`, a read-only root, `ipc: none`, the homes and
# /run/locus tmpfs mounts, the kept homes' volume, and the guard's control
# mounted read-only at /run/cyfr-guard-control, behind that guard
# (docker-compose.yml's locus service). cyfr-locus starts a role process
# for each `--role <name>:<uid>:<port>:<pool>[:private][:kept|:floor]`
# whose key (LOCUS_<NAME>_KEY) is set: the runtime's, private, reaching
# core's host API, whose runners the warm floor keeps; the builds'; and the
# backends', whose programs keep their homes
# under --kept-homes, each uid of 40001-49999 held by one home for its life
# and given to no pool or other home.
ENTRYPOINT ["cyfr-locus", "serve", "--role", "runtime:10011:4200:runner:private:floor", "--role", "builds:10012:4100:build", "--role", "backends:10013:4101:backends:kept", "--pool", "runner:30101-30108:relay", "--pool", "build:30001-30016:routed", "--pool", "backends:20001-20032:routed", "--home-root", "/var/lib/locus/homes", "--kept-homes", "/var/lib/locus/kept:40001-49999", "--guard", "/run/cyfr-guard-control/guard.sock", "--", "/app/bin/locus", "start"]
