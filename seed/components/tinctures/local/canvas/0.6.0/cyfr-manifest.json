{
  "name": "canvas",
  "type": "tincture",
  "version": "0.6.0",
  "publisher": "local",
  "description": "Your canvas: the day in one sentence, what needs your attention grouped by cause with a grant where one fixes it, your recent runs with Retry on a failed one, your apps, and your schedules with the week ahead, each one paused or resumed with a tap; hide a section and show it again.",
  "tags": ["canvas", "system"],
  "category": "utility",
  "tincture": {
    "icon": "canvas",
    "tagline": "Your day, your runs, your apps and schedules",
    "entry": "dist/index.html",
    "build": {
      "tool": "vite"
    },
    "desktop": {
      "data": ["runs.changes", "schedules.changes", "schedule_runs.changes"],
      "controls": [
        {
          "id": "pause-schedule",
          "label": "Pause",
          "operation": "schedule.pause",
          "pick": {"stream": "schedules.changes", "field": "/schedule_id", "arg": "schedule_id"}
        },
        {
          "id": "resume-schedule",
          "label": "Resume",
          "operation": "schedule.resume",
          "pick": {"stream": "schedules.changes", "field": "/schedule_id", "arg": "schedule_id"}
        },
        {"id": "retry-run", "label": "Retry", "operation": "execution.retry", "args": {}, "pick": {"stream": "runs.changes", "field": "/execution_id", "arg": "execution_id"}}
      ],
      "prefs": {
        "widgets": {
          "attention": {},
          "runs": {},
          "apps": {},
          "schedules": {}
        }
      },
      "chrome": "chrome.css"
    }
  }
}
