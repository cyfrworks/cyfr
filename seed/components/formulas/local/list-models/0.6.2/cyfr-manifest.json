{
  "name": "list-models",
  "type": "formula",
  "version": "0.6.2",
  "publisher": "local",
  "description": "Aggregates available models from all AI provider catalysts (Claude, OpenAI, Gemini, Grok, OpenRouter)",
  "dependencies": {
    "static": [
      {
        "ref": "catalyst:local.claude",
        "optional": true,
        "reason": "Claude LLM provider (ships with the server; the estate lists the models of whichever providers hold a key)"
      },
      {
        "ref": "catalyst:local.openai",
        "optional": true,
        "reason": "OpenAI LLM provider (ships with the server; the estate lists the models of whichever providers hold a key)"
      },
      {
        "ref": "catalyst:local.gemini",
        "optional": true,
        "reason": "Gemini LLM provider (ships with the server; the estate lists the models of whichever providers hold a key)"
      },
      {
        "ref": "catalyst:local.grok",
        "optional": true,
        "reason": "Grok LLM provider (ships with the server; the estate lists the models of whichever providers hold a key)"
      },
      {
        "ref": "catalyst:local.openrouter",
        "optional": true,
        "reason": "OpenRouter LLM provider (ships with the server; the estate lists the models of whichever providers hold a key)"
      }
    ]
  },
  "schema": {
    "input": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "array",
          "description": "Optional filter — which providers to query. Defaults to all.",
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "openai",
              "gemini",
              "grok",
              "openrouter"
            ]
          }
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "models": {
          "type": "object",
          "description": "Map of provider name to their models.list response data"
        },
        "refs": {
          "type": "object",
          "description": "Map of provider name to catalyst reference string"
        },
        "errors": {
          "type": "object",
          "description": "Map of provider name to error message (empty if all succeeded)"
        }
      }
    }
  },
  "examples": [
    {
      "name": "List all models",
      "description": "Query all providers for available models",
      "input": {},
      "output": {
        "models": {
          "claude": {
            "data": [
              "..."
            ],
            "has_more": false
          },
          "openai": {
            "data": [
              "..."
            ]
          },
          "gemini": {
            "models": [
              "..."
            ]
          },
          "grok": {
            "data": [
              "..."
            ]
          },
          "openrouter": {
            "data": [
              "..."
            ]
          }
        },
        "refs": {
          "claude": "catalyst:local.claude",
          "openai": "catalyst:local.openai",
          "gemini": "catalyst:local.gemini",
          "grok": "catalyst:local.grok",
          "openrouter": "catalyst:local.openrouter"
        },
        "errors": {}
      }
    },
    {
      "name": "List OpenAI models only",
      "description": "Query a single provider",
      "input": {
        "providers": [
          "openai"
        ]
      },
      "output": {
        "models": {
          "openai": {
            "data": [
              "..."
            ]
          }
        },
        "refs": {
          "openai": "catalyst:local.openai"
        },
        "errors": {}
      }
    }
  ],
  "caps": {
    "tools": [
      "execution.run"
    ],
    "limits": {
      "max_memory_bytes": 67108864,
      "max_request_size": 1048576,
      "max_response_size": 5242880,
      "timeout": "5m"
    }
  }
}
