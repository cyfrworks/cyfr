{
  "name": "openai-codex",
  "type": "catalyst",
  "version": "0.1.0",
  "publisher": "local",
  "description": "OpenAI Codex as a brain of the model/chat@1 contract: it runs as itself in your program's folder, on your own plan, with CYFR's tools through CYFR's gate",
  "contracts": [
    "model/chat@1"
  ],
  "needs": {
    "openai-codex": {
      "type": "login",
      "program": "openai-codex",
      "reason": "to run OpenAI Codex in its own folder, signed in to your own plan",
      "required": true,
      "install": {
        "command": "npx -y @openai/codex@0.167.0",
        "login_command": "npx -y @openai/codex@0.167.0 login --device-auth"
      }
    }
  },
  "caps": {
    "limits": {
      "timeout": "30m",
      "max_memory_bytes": 67108864,
      "max_request_size": 1048576,
      "max_response_size": 5242880,
      "rate_limit": {
        "requests": 100,
        "window": "1m"
      }
    }
  },
  "schema": {
    "input": {
      "properties": {
        "operation": {
          "enum": [
            "chat",
            "describe",
            "models"
          ]
        },
        "params": {
          "description": "Operation-specific parameters",
          "type": "object"
        }
      },
      "required": [
        "operation"
      ],
      "type": "object"
    },
    "output": {
      "type": "object"
    }
  },
  "examples": [
    {
      "name": "Chat (model/chat@1)",
      "description": "One turn: the newest message starts a turn on OpenAI Codex's thread, its reply streams as contract events, and the response names the session the next turn continues",
      "input": {
        "operation": "chat",
        "params": {
          "model": "default",
          "system": "You are a crew member of this athanor's AQUA.",
          "messages": [
            {
              "role": "user",
              "content": "Read notes/todo.md and say what is left."
            }
          ],
          "tools": [
            {
              "name": "files",
              "description": "Read the athanor's files",
              "parameters": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "read"
                    ]
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "action",
                  "path"
                ]
              }
            }
          ],
          "options": {
            "effort": "high"
          }
        }
      },
      "output": {
        "data": {
          "model": "gpt-6.1-sol",
          "content": [
            {
              "type": "tool_call",
              "id": "call_...",
              "name": "files",
              "arguments": {
                "action": "read",
                "path": "notes/todo.md"
              },
              "provider_data": {
                "request_id": 0,
                "turn_id": "..."
              }
            }
          ],
          "stop_reason": "tool_call",
          "usage": {
            "input_tokens": 0,
            "output_tokens": 0,
            "cache_read_tokens": 0,
            "cache_write_tokens": 0
          },
          "session": "0b5c7c1e-2f3a-4d6e-8a9b-1c2d3e4f5a6b.01a1bb90-88fc-72c0-895e-976b439b7eb5.0-0-0-0"
        },
        "status": 200
      }
    },
    {
      "name": "Describe (model/chat@1)",
      "description": "What this brain can do, and the options OpenAI Codex lets a caller set",
      "input": {
        "operation": "describe",
        "params": {}
      },
      "output": {
        "data": {
          "contracts": [
            "model/chat@1"
          ],
          "provider": "openai-codex",
          "tools": true,
          "provider_tools": [],
          "streaming": true,
          "options": [
            {
              "name": "model",
              "kind": "enum",
              "values": [
                "default",
                "gpt-6.1-sol",
                "gpt-5.5"
              ]
            },
            {
              "name": "effort",
              "kind": "enum",
              "values": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra"
              ]
            }
          ]
        },
        "status": 200
      }
    },
    {
      "name": "Models (model/chat@1)",
      "description": "The models OpenAI Codex lists for its sign-in, its default first",
      "input": {
        "operation": "models",
        "params": {}
      },
      "output": {
        "data": {
          "models": [
            {
              "id": "default",
              "name": "Default (GPT-6.1-Sol)"
            },
            {
              "id": "gpt-6.1-sol",
              "name": "GPT-6.1-Sol"
            }
          ]
        },
        "status": 200
      }
    }
  ]
}
