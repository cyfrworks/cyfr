{
  "name": "grok",
  "type": "catalyst",
  "version": "1.2.0",
  "publisher": "local",
  "description": "xAI Grok API \u2014 the model/chat@1 contract (chat, describe, models) plus chat, vision, image generation, embeddings, responses and files",
  "contracts": [
    "model/chat@1"
  ],
  "needs": {
    "api_key": {
      "type": "api_key:x.ai",
      "reason": "to call the xAI API with your key (console.x.ai)",
      "required": true,
      "fields": [
        "GROK_API_KEY"
      ]
    }
  },
  "caps": {
    "egress": {
      "domains": [
        "api.x.ai"
      ],
      "methods": [
        "GET",
        "POST",
        "DELETE"
      ]
    },
    "limits": {
      "timeout": "3m",
      "max_memory_bytes": 67108864,
      "max_request_size": 1048576,
      "max_response_size": 5242880,
      "rate_limit": {
        "requests": 100,
        "window": "1m"
      }
    }
  },
  "defaults": {
    "base_url": "https://api.x.ai/v1"
  },
  "schema": {
    "input": {
      "properties": {
        "operation": {
          "enum": [
            "chat",
            "describe",
            "models",
            "chat.completions.create",
            "models.list",
            "embeddings.create",
            "images.generate",
            "images.edit",
            "responses.create",
            "files.list",
            "files.get",
            "files.delete"
          ]
        },
        "params": {
          "description": "Operation-specific parameters",
          "type": "object"
        },
        "stream": {
          "description": "Enable streaming for chat completions",
          "type": "boolean"
        }
      },
      "required": [
        "operation"
      ],
      "type": "object"
    },
    "output": {
      "type": "object"
    }
  },
  "examples": [
    {
      "description": "One turn of the model/chat@1 contract: a contract request in, a contract response out",
      "input": {
        "operation": "chat",
        "params": {
          "model": "grok-4",
          "system": "Answer in one sentence.",
          "messages": [
            {
              "role": "user",
              "content": "What is a catalyst?"
            }
          ],
          "tools": [
            {
              "name": "files.read",
              "description": "Read a file",
              "parameters": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ]
              }
            }
          ],
          "max_tokens": 1024
        }
      },
      "name": "Chat (model/chat@1)",
      "output": {
        "data": {
          "content": [
            {
              "text": "...",
              "type": "text"
            }
          ],
          "model": "grok-4",
          "stop_reason": "end_turn",
          "usage": {
            "cache_read_tokens": 0,
            "cache_write_tokens": 0,
            "input_tokens": 42,
            "output_tokens": 17
          }
        },
        "status": 200
      }
    },
    {
      "description": "What this catalyst can do, answered without a key",
      "input": {
        "operation": "describe",
        "params": {}
      },
      "name": "Describe (model/chat@1)",
      "output": {
        "data": {
          "contracts": [
            "model/chat@1"
          ],
          "streaming": false,
          "tools": true
        },
        "status": 200
      }
    },
    {
      "description": "The models the bound key can reach, as contract entries",
      "input": {
        "operation": "models",
        "params": {}
      },
      "name": "Models (model/chat@1)",
      "output": {
        "data": {
          "models": [
            {
              "id": "grok-4",
              "name": "..."
            }
          ]
        },
        "status": 200
      }
    },
    {
      "input": {
        "operation": "chat.completions.create",
        "params": {
          "messages": [
            {
              "content": "Hello",
              "role": "user"
            }
          ],
          "model": "grok-4-1-fast-reasoning"
        }
      },
      "name": "Chat completion",
      "output": {
        "data": {
          "choices": [
            {
              "message": {
                "content": "Hi!",
                "role": "assistant"
              }
            }
          ]
        },
        "status": 200
      }
    },
    {
      "input": {
        "operation": "chat.completions.create",
        "params": {
          "messages": [
            {
              "content": "Count to 5",
              "role": "user"
            }
          ],
          "model": "grok-4-1-fast-reasoning"
        },
        "stream": true
      },
      "name": "Streaming chat",
      "output": {
        "data": {
          "chunks": [
            "..."
          ],
          "combined_text": "1, 2, 3, 4, 5"
        },
        "status": 200
      }
    },
    {
      "input": {
        "operation": "images.generate",
        "params": {
          "model": "grok-imagine-image",
          "prompt": "A sunset over mountains"
        }
      },
      "name": "Generate image",
      "output": {
        "data": {
          "data": [
            {
              "url": "..."
            }
          ]
        },
        "status": 200
      }
    },
    {
      "input": {
        "operation": "models.list",
        "params": {}
      },
      "name": "List models",
      "output": {
        "data": {
          "data": [
            "..."
          ]
        },
        "status": 200
      }
    },
    {
      "input": {
        "operation": "responses.create",
        "params": {
          "input": [
            {
              "file_id": "file-abc123",
              "type": "input_file"
            },
            {
              "text": "Summarize this document",
              "type": "input_text"
            }
          ],
          "model": "grok-4-fast-reasoning"
        }
      },
      "name": "Chat with files (Responses API)",
      "output": {
        "data": {
          "output": [
            {
              "content": [
                "..."
              ],
              "type": "message"
            }
          ]
        },
        "status": 200
      }
    },
    {
      "input": {
        "operation": "files.list",
        "params": {}
      },
      "name": "List files",
      "output": {
        "data": {
          "data": []
        },
        "status": 200
      }
    }
  ]
}
