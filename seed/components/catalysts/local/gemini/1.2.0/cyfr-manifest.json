{
  "name": "gemini",
  "type": "catalyst",
  "version": "1.2.0",
  "publisher": "local",
  "description": "Google Gemini API \u2014 the model/chat@1 contract (chat, describe, models) plus text generation, streaming, embeddings and token counting",
  "contracts": [
    "model/chat@1"
  ],
  "needs": {
    "api_key": {
      "type": "api_key:aistudio.google.com",
      "reason": "to call the Gemini API with your key (aistudio.google.com/apikey)",
      "required": true,
      "fields": [
        "GEMINI_API_KEY"
      ]
    }
  },
  "caps": {
    "egress": {
      "domains": [
        "generativelanguage.googleapis.com"
      ],
      "methods": [
        "GET",
        "POST"
      ]
    },
    "limits": {
      "timeout": "3m",
      "max_memory_bytes": 67108864,
      "max_request_size": 1048576,
      "max_response_size": 5242880,
      "rate_limit": {
        "requests": 100,
        "window": "1m"
      }
    }
  },
  "defaults": {
    "base_url": "https://generativelanguage.googleapis.com/v1beta"
  },
  "schema": {
    "input": {
      "properties": {
        "operation": {
          "enum": [
            "chat",
            "describe",
            "models",
            "content.generate",
            "content.stream",
            "tokens.count",
            "embeddings.create",
            "embeddings.batch",
            "models.list",
            "models.get",
            "generate",
            "stream",
            "embed",
            "batch_embed",
            "count_tokens"
          ]
        },
        "params": {
          "description": "Operation-specific parameters (model goes here)",
          "type": "object"
        },
        "stream": {
          "description": "Enable streaming (used with content.generate)",
          "type": "boolean"
        }
      },
      "required": [
        "operation"
      ],
      "type": "object"
    },
    "output": {
      "type": "object"
    }
  },
  "examples": [
    {
      "description": "One turn of the model/chat@1 contract: a contract request in, a contract response out",
      "input": {
        "operation": "chat",
        "params": {
          "model": "gemini-2.5-flash",
          "system": "Answer in one sentence.",
          "messages": [
            {
              "role": "user",
              "content": "What is a catalyst?"
            }
          ],
          "tools": [
            {
              "name": "files.read",
              "description": "Read a file",
              "parameters": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ]
              }
            }
          ],
          "max_tokens": 1024
        }
      },
      "name": "Chat (model/chat@1)",
      "output": {
        "data": {
          "content": [
            {
              "text": "...",
              "type": "text"
            }
          ],
          "model": "gemini-2.5-flash",
          "stop_reason": "end_turn",
          "usage": {
            "cache_read_tokens": 0,
            "cache_write_tokens": 0,
            "input_tokens": 42,
            "output_tokens": 17
          }
        },
        "status": 200
      }
    },
    {
      "description": "What this catalyst can do, answered without a key",
      "input": {
        "operation": "describe",
        "params": {}
      },
      "name": "Describe (model/chat@1)",
      "output": {
        "data": {
          "contracts": [
            "model/chat@1"
          ],
          "streaming": false,
          "tools": true
        },
        "status": 200
      }
    },
    {
      "description": "The models the bound key can reach, as contract entries",
      "input": {
        "operation": "models",
        "params": {}
      },
      "name": "Models (model/chat@1)",
      "output": {
        "data": {
          "models": [
            {
              "id": "gemini-2.5-flash",
              "name": "..."
            }
          ]
        },
        "status": 200
      }
    },
    {
      "description": "Simple text generation with Gemini 2.5 Flash",
      "input": {
        "operation": "content.generate",
        "params": {
          "contents": [
            {
              "parts": [
                {
                  "text": "Explain quantum computing in one sentence"
                }
              ],
              "role": "user"
            }
          ],
          "model": "gemini-2.5-flash"
        },
        "stream": false
      },
      "name": "Generate text",
      "output": {
        "data": {
          "candidates": [
            {
              "content": {
                "parts": [
                  {
                    "text": "..."
                  }
                ]
              }
            }
          ]
        },
        "status": 200
      }
    },
    {
      "description": "Streaming text generation via SSE",
      "input": {
        "operation": "content.stream",
        "params": {
          "contents": [
            {
              "parts": [
                {
                  "text": "Write a haiku about Rust"
                }
              ],
              "role": "user"
            }
          ],
          "model": "gemini-2.5-flash"
        },
        "stream": true
      },
      "name": "Stream text",
      "output": {
        "data": {
          "chunks": [
            "..."
          ],
          "combined_text": "..."
        },
        "status": 200
      }
    },
    {
      "input": {
        "operation": "embeddings.create",
        "params": {
          "content": {
            "parts": [
              {
                "text": "Hello world"
              }
            ]
          },
          "model": "gemini-embedding-001",
          "taskType": "RETRIEVAL_QUERY"
        },
        "stream": false
      },
      "name": "Embed text",
      "output": {
        "data": {
          "embedding": {
            "values": [
              0.1,
              0.2,
              "..."
            ]
          }
        },
        "status": 200
      }
    },
    {
      "input": {
        "operation": "tokens.count",
        "params": {
          "contents": [
            {
              "parts": [
                {
                  "text": "How many tokens is this?"
                }
              ],
              "role": "user"
            }
          ],
          "model": "gemini-2.5-flash"
        },
        "stream": false
      },
      "name": "Count tokens",
      "output": {
        "data": {
          "totalTokens": 7
        },
        "status": 200
      }
    },
    {
      "input": {
        "operation": "models.list",
        "params": {},
        "stream": false
      },
      "name": "List models",
      "output": {
        "data": {
          "models": [
            "..."
          ]
        },
        "status": 200
      }
    }
  ]
}
