{
  "name": "gemini",
  "type": "catalyst",
  "version": "1.1.0",
  "publisher": "local",
  "description": "Google Gemini API SDK \u2014 text generation, streaming, embeddings, token counting, and model listing",
  "needs": {
    "api_key": {
      "type": "api_key:aistudio.google.com",
      "reason": "to call the Gemini API with your key (aistudio.google.com/apikey)",
      "required": true,
      "fields": [
        "GEMINI_API_KEY"
      ]
    }
  },
  "caps": {
    "egress": {
      "domains": [
        "generativelanguage.googleapis.com"
      ],
      "methods": [
        "GET",
        "POST"
      ]
    },
    "limits": {
      "timeout": "3m",
      "max_memory_bytes": 67108864,
      "max_request_size": 1048576,
      "max_response_size": 5242880,
      "rate_limit": {
        "requests": 100,
        "window": "1m"
      }
    }
  },
  "defaults": {
    "base_url": "https://generativelanguage.googleapis.com/v1beta"
  },
  "schema": {
    "input": {
      "properties": {
        "operation": {
          "enum": [
            "content.generate",
            "content.stream",
            "tokens.count",
            "embeddings.create",
            "embeddings.batch",
            "models.list",
            "models.get",
            "generate",
            "stream",
            "embed",
            "batch_embed",
            "count_tokens"
          ]
        },
        "params": {
          "description": "Operation-specific parameters (model goes here)",
          "type": "object"
        },
        "stream": {
          "description": "Enable streaming (used with content.generate)",
          "type": "boolean"
        }
      },
      "required": [
        "operation"
      ],
      "type": "object"
    },
    "output": {
      "type": "object"
    }
  },
  "examples": [
    {
      "description": "Simple text generation with Gemini 2.5 Flash",
      "input": {
        "operation": "content.generate",
        "params": {
          "contents": [
            {
              "parts": [
                {
                  "text": "Explain quantum computing in one sentence"
                }
              ],
              "role": "user"
            }
          ],
          "model": "gemini-2.5-flash"
        },
        "stream": false
      },
      "name": "Generate text",
      "output": {
        "data": {
          "candidates": [
            {
              "content": {
                "parts": [
                  {
                    "text": "..."
                  }
                ]
              }
            }
          ]
        },
        "status": 200
      }
    },
    {
      "description": "Streaming text generation via SSE",
      "input": {
        "operation": "content.stream",
        "params": {
          "contents": [
            {
              "parts": [
                {
                  "text": "Write a haiku about Rust"
                }
              ],
              "role": "user"
            }
          ],
          "model": "gemini-2.5-flash"
        },
        "stream": true
      },
      "name": "Stream text",
      "output": {
        "data": {
          "chunks": [
            "..."
          ],
          "combined_text": "..."
        },
        "status": 200
      }
    },
    {
      "input": {
        "operation": "embeddings.create",
        "params": {
          "content": {
            "parts": [
              {
                "text": "Hello world"
              }
            ]
          },
          "model": "gemini-embedding-001",
          "taskType": "RETRIEVAL_QUERY"
        },
        "stream": false
      },
      "name": "Embed text",
      "output": {
        "data": {
          "embedding": {
            "values": [
              0.1,
              0.2,
              "..."
            ]
          }
        },
        "status": 200
      }
    },
    {
      "input": {
        "operation": "tokens.count",
        "params": {
          "contents": [
            {
              "parts": [
                {
                  "text": "How many tokens is this?"
                }
              ],
              "role": "user"
            }
          ],
          "model": "gemini-2.5-flash"
        },
        "stream": false
      },
      "name": "Count tokens",
      "output": {
        "data": {
          "totalTokens": 7
        },
        "status": 200
      }
    },
    {
      "input": {
        "operation": "models.list",
        "params": {},
        "stream": false
      },
      "name": "List models",
      "output": {
        "data": {
          "models": [
            "..."
          ]
        },
        "status": 200
      }
    }
  ]
}
