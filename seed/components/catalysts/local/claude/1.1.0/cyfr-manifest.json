{
  "name": "claude",
  "type": "catalyst",
  "version": "1.1.0",
  "publisher": "local",
  "description": "Anthropic Claude API SDK \u2014 messages, streaming, token counting, batches, and model listing",
  "needs": {
    "api_key": {
      "type": "api_key:anthropic.com",
      "reason": "to call the Anthropic API with your key (console.anthropic.com/settings/keys)",
      "required": true,
      "fields": [
        "ANTHROPIC_API_KEY"
      ]
    }
  },
  "caps": {
    "egress": {
      "domains": [
        "api.anthropic.com"
      ],
      "methods": [
        "GET",
        "POST"
      ]
    },
    "limits": {
      "timeout": "3m",
      "max_memory_bytes": 67108864,
      "max_request_size": 1048576,
      "max_response_size": 5242880,
      "rate_limit": {
        "requests": 100,
        "window": "1m"
      }
    }
  },
  "defaults": {
    "api_version": "2023-06-01",
    "base_url": "https://api.anthropic.com"
  },
  "schema": {
    "input": {
      "properties": {
        "operation": {
          "enum": [
            "messages.create",
            "messages.stream",
            "messages.count_tokens",
            "models.list",
            "batches.create",
            "batches.get",
            "batches.list",
            "batches.cancel",
            "batches.results"
          ]
        },
        "params": {
          "description": "Operation-specific parameters",
          "type": "object"
        }
      },
      "required": [
        "operation"
      ],
      "type": "object"
    },
    "output": {
      "type": "object"
    }
  },
  "examples": [
    {
      "description": "Simple message creation with Claude",
      "input": {
        "operation": "messages.create",
        "params": {
          "max_tokens": 1024,
          "messages": [
            {
              "content": "Say hello in one word",
              "role": "user"
            }
          ],
          "model": "claude-sonnet-4-5-20250929"
        }
      },
      "name": "Create a message",
      "output": {
        "data": {
          "content": [
            {
              "text": "Hello!",
              "type": "text"
            }
          ],
          "id": "msg_...",
          "role": "assistant",
          "type": "message"
        },
        "status": 200
      }
    },
    {
      "description": "Streaming message creation via SSE",
      "input": {
        "operation": "messages.stream",
        "params": {
          "max_tokens": 1024,
          "messages": [
            {
              "content": "Write a haiku about Rust",
              "role": "user"
            }
          ],
          "model": "claude-sonnet-4-5-20250929"
        }
      },
      "name": "Stream a message",
      "output": {
        "data": {
          "chunks": [
            "..."
          ],
          "combined_text": "..."
        },
        "status": 200
      }
    },
    {
      "description": "Count input tokens for a message",
      "input": {
        "operation": "messages.count_tokens",
        "params": {
          "messages": [
            {
              "content": "How many tokens is this?",
              "role": "user"
            }
          ],
          "model": "claude-sonnet-4-5-20250929"
        }
      },
      "name": "Count tokens",
      "output": {
        "data": {
          "input_tokens": 14
        },
        "status": 200
      }
    },
    {
      "description": "List available Claude models",
      "input": {
        "operation": "models.list",
        "params": {}
      },
      "name": "List models",
      "output": {
        "data": {
          "data": [
            "..."
          ],
          "has_more": false
        },
        "status": 200
      }
    },
    {
      "description": "Create a message batch for async processing",
      "input": {
        "operation": "batches.create",
        "params": {
          "requests": [
            {
              "custom_id": "req-1",
              "params": {
                "max_tokens": 1024,
                "messages": [
                  {
                    "content": "Hello",
                    "role": "user"
                  }
                ],
                "model": "claude-sonnet-4-5-20250929"
              }
            }
          ]
        }
      },
      "name": "Create a batch",
      "output": {
        "data": {
          "id": "msgbatch_...",
          "processing_status": "in_progress",
          "type": "message_batch"
        },
        "status": 200
      }
    }
  ]
}
