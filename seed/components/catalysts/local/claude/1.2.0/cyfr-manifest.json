{
  "name": "claude",
  "type": "catalyst",
  "version": "1.2.0",
  "publisher": "local",
  "description": "Anthropic Claude API \u2014 the model/chat@1 contract (chat, describe, models) plus messages, streaming, token counting and batches",
  "contracts": [
    "model/chat@1"
  ],
  "needs": {
    "api_key": {
      "type": "api_key:anthropic.com",
      "reason": "to call the Anthropic API with your key (console.anthropic.com/settings/keys)",
      "required": true,
      "fields": [
        "ANTHROPIC_API_KEY"
      ]
    }
  },
  "caps": {
    "egress": {
      "domains": [
        "api.anthropic.com"
      ],
      "methods": [
        "GET",
        "POST"
      ]
    },
    "limits": {
      "timeout": "3m",
      "max_memory_bytes": 67108864,
      "max_request_size": 1048576,
      "max_response_size": 5242880,
      "rate_limit": {
        "requests": 100,
        "window": "1m"
      }
    }
  },
  "defaults": {
    "api_version": "2023-06-01",
    "base_url": "https://api.anthropic.com"
  },
  "schema": {
    "input": {
      "properties": {
        "operation": {
          "enum": [
            "chat",
            "describe",
            "models",
            "messages.create",
            "messages.stream",
            "messages.count_tokens",
            "models.list",
            "batches.create",
            "batches.get",
            "batches.list",
            "batches.cancel",
            "batches.results"
          ]
        },
        "params": {
          "description": "Operation-specific parameters",
          "type": "object"
        }
      },
      "required": [
        "operation"
      ],
      "type": "object"
    },
    "output": {
      "type": "object"
    }
  },
  "examples": [
    {
      "description": "One turn of the model/chat@1 contract: a contract request in, a contract response out",
      "input": {
        "operation": "chat",
        "params": {
          "model": "claude-sonnet-4-6",
          "system": "Answer in one sentence.",
          "messages": [
            {
              "role": "user",
              "content": "What is a catalyst?"
            }
          ],
          "tools": [
            {
              "name": "files.read",
              "description": "Read a file",
              "parameters": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ]
              }
            }
          ],
          "max_tokens": 1024
        }
      },
      "name": "Chat (model/chat@1)",
      "output": {
        "data": {
          "content": [
            {
              "text": "...",
              "type": "text"
            }
          ],
          "model": "claude-sonnet-4-6",
          "stop_reason": "end_turn",
          "usage": {
            "cache_read_tokens": 0,
            "cache_write_tokens": 0,
            "input_tokens": 42,
            "output_tokens": 17
          }
        },
        "status": 200
      }
    },
    {
      "description": "What this catalyst can do, answered without a key",
      "input": {
        "operation": "describe",
        "params": {}
      },
      "name": "Describe (model/chat@1)",
      "output": {
        "data": {
          "contracts": [
            "model/chat@1"
          ],
          "streaming": false,
          "tools": true
        },
        "status": 200
      }
    },
    {
      "description": "The models the bound key can reach, as contract entries",
      "input": {
        "operation": "models",
        "params": {}
      },
      "name": "Models (model/chat@1)",
      "output": {
        "data": {
          "models": [
            {
              "id": "claude-sonnet-4-6",
              "name": "..."
            }
          ]
        },
        "status": 200
      }
    },
    {
      "description": "Simple message creation with Claude",
      "input": {
        "operation": "messages.create",
        "params": {
          "max_tokens": 1024,
          "messages": [
            {
              "content": "Say hello in one word",
              "role": "user"
            }
          ],
          "model": "claude-sonnet-4-5-20250929"
        }
      },
      "name": "Create a message",
      "output": {
        "data": {
          "content": [
            {
              "text": "Hello!",
              "type": "text"
            }
          ],
          "id": "msg_...",
          "role": "assistant",
          "type": "message"
        },
        "status": 200
      }
    },
    {
      "description": "Streaming message creation via SSE",
      "input": {
        "operation": "messages.stream",
        "params": {
          "max_tokens": 1024,
          "messages": [
            {
              "content": "Write a haiku about Rust",
              "role": "user"
            }
          ],
          "model": "claude-sonnet-4-5-20250929"
        }
      },
      "name": "Stream a message",
      "output": {
        "data": {
          "chunks": [
            "..."
          ],
          "combined_text": "..."
        },
        "status": 200
      }
    },
    {
      "description": "Count input tokens for a message",
      "input": {
        "operation": "messages.count_tokens",
        "params": {
          "messages": [
            {
              "content": "How many tokens is this?",
              "role": "user"
            }
          ],
          "model": "claude-sonnet-4-5-20250929"
        }
      },
      "name": "Count tokens",
      "output": {
        "data": {
          "input_tokens": 14
        },
        "status": 200
      }
    },
    {
      "description": "List available Claude models",
      "input": {
        "operation": "models.list",
        "params": {}
      },
      "name": "List models",
      "output": {
        "data": {
          "data": [
            "..."
          ],
          "has_more": false
        },
        "status": 200
      }
    },
    {
      "description": "Create a message batch for async processing",
      "input": {
        "operation": "batches.create",
        "params": {
          "requests": [
            {
              "custom_id": "req-1",
              "params": {
                "max_tokens": 1024,
                "messages": [
                  {
                    "content": "Hello",
                    "role": "user"
                  }
                ],
                "model": "claude-sonnet-4-5-20250929"
              }
            }
          ]
        }
      },
      "name": "Create a batch",
      "output": {
        "data": {
          "id": "msgbatch_...",
          "processing_status": "in_progress",
          "type": "message_batch"
        },
        "status": 200
      }
    }
  ]
}
