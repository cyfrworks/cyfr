{
  "name": "openrouter",
  "type": "catalyst",
  "version": "1.3.2",
  "publisher": "local",
  "description": "OpenRouter API \u2014 the model/chat@1 contract (chat, describe, models) plus unified access to 400+ models with automatic fallback",
  "contracts": [
    "model/chat@1"
  ],
  "needs": {
    "api_key": {
      "type": "api_key:openrouter.ai",
      "reason": "to call the OpenRouter API with your key (openrouter.ai/settings/keys)",
      "required": true,
      "fields": [
        "OPENROUTER_API_KEY"
      ]
    }
  },
  "caps": {
    "egress": {
      "domains": [
        "openrouter.ai"
      ],
      "methods": [
        "GET",
        "POST"
      ]
    },
    "limits": {
      "timeout": "3m",
      "max_memory_bytes": 67108864,
      "max_request_size": 1048576,
      "max_response_size": 5242880,
      "rate_limit": {
        "requests": 100,
        "window": "1m"
      }
    }
  },
  "defaults": {
    "base_url": "https://openrouter.ai/api/v1"
  },
  "schema": {
    "input": {
      "properties": {
        "operation": {
          "enum": [
            "chat",
            "describe",
            "models",
            "chat.completions.create",
            "models.list",
            "embeddings.create",
            "credits.get",
            "key.info"
          ]
        },
        "params": {
          "description": "Operation-specific parameters",
          "type": "object"
        },
        "stream": {
          "description": "Enable streaming for chat completions",
          "type": "boolean"
        }
      },
      "required": [
        "operation"
      ],
      "type": "object"
    },
    "output": {
      "type": "object"
    }
  },
  "examples": [
    {
      "description": "One turn of the model/chat@1 contract: a contract request in, the answer streamed as contract events and the whole contract response out",
      "input": {
        "operation": "chat",
        "params": {
          "model": "anthropic/claude-sonnet-4-6",
          "system": "Answer in one sentence.",
          "messages": [
            {
              "role": "user",
              "content": "What is a catalyst?"
            }
          ],
          "tools": [
            {
              "name": "files.read",
              "description": "Read a file",
              "parameters": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ]
              }
            }
          ],
          "max_tokens": 1024
        }
      },
      "name": "Chat (model/chat@1)",
      "output": {
        "data": {
          "content": [
            {
              "text": "...",
              "type": "text"
            }
          ],
          "model": "anthropic/claude-sonnet-4-6",
          "stop_reason": "end_turn",
          "usage": {
            "cache_read_tokens": 0,
            "cache_write_tokens": 0,
            "input_tokens": 42,
            "output_tokens": 17
          }
        },
        "status": 200
      }
    },
    {
      "description": "What this catalyst can do, answered without a key",
      "input": {
        "operation": "describe",
        "params": {}
      },
      "name": "Describe (model/chat@1)",
      "output": {
        "data": {
          "contracts": [
            "model/chat@1"
          ],
          "streaming": true,
          "tools": true
        },
        "status": 200
      }
    },
    {
      "description": "What this catalyst can do with one model, and that model's context window and output ceiling",
      "input": {
        "operation": "describe",
        "params": {
          "model": "anthropic/claude-sonnet-4-6"
        }
      },
      "name": "Describe a model (model/chat@1)",
      "output": {
        "data": {
          "contracts": [
            "model/chat@1"
          ],
          "model": "anthropic/claude-sonnet-4-6",
          "streaming": true,
          "tools": true,
          "context_window": 200000,
          "max_output_tokens": 64000
        },
        "status": 200
      }
    },
    {
      "description": "The models the bound key can reach, as contract entries",
      "input": {
        "operation": "models",
        "params": {}
      },
      "name": "Models (model/chat@1)",
      "output": {
        "data": {
          "models": [
            {
              "id": "anthropic/claude-sonnet-4-6",
              "name": "..."
            }
          ]
        },
        "status": 200
      }
    },
    {
      "input": {
        "operation": "chat.completions.create",
        "params": {
          "messages": [
            {
              "content": "Hello",
              "role": "user"
            }
          ],
          "model": "anthropic/claude-sonnet-4"
        }
      },
      "name": "Chat completion",
      "output": {
        "data": {
          "choices": [
            {
              "message": {
                "content": "Hi!"
              }
            }
          ]
        },
        "status": 200
      }
    },
    {
      "input": {
        "operation": "chat.completions.create",
        "params": {
          "messages": [
            {
              "content": "Count to 5",
              "role": "user"
            }
          ],
          "model": "meta-llama/llama-3.1-8b-instruct:free"
        },
        "stream": true
      },
      "name": "Streaming chat",
      "output": {
        "data": {
          "chunks": [
            "..."
          ],
          "combined_text": "1, 2, 3, 4, 5"
        },
        "status": 200
      }
    },
    {
      "input": {
        "operation": "models.list",
        "params": {}
      },
      "name": "List models",
      "output": {
        "data": {
          "data": [
            "..."
          ]
        },
        "status": 200
      }
    },
    {
      "input": {
        "operation": "credits.get",
        "params": {}
      },
      "name": "Check credits",
      "output": {
        "data": {
          "total_credits": 10.0,
          "total_usage": 1.5
        },
        "status": 200
      }
    }
  ]
}
