{
  "name": "openrouter",
  "type": "catalyst",
  "version": "1.1.0",
  "publisher": "local",
  "description": "OpenRouter API \u2014 unified access to 400+ AI models with automatic fallback",
  "needs": {
    "api_key": {
      "type": "api_key:openrouter.ai",
      "reason": "to call the OpenRouter API with your key (openrouter.ai/settings/keys)",
      "required": true,
      "fields": [
        "OPENROUTER_API_KEY"
      ]
    }
  },
  "caps": {
    "egress": {
      "domains": [
        "openrouter.ai"
      ],
      "methods": [
        "GET",
        "POST"
      ]
    },
    "limits": {
      "timeout": "3m",
      "max_memory_bytes": 67108864,
      "max_request_size": 1048576,
      "max_response_size": 5242880,
      "rate_limit": {
        "requests": 100,
        "window": "1m"
      }
    }
  },
  "defaults": {
    "base_url": "https://openrouter.ai/api/v1"
  },
  "schema": {
    "input": {
      "properties": {
        "operation": {
          "enum": [
            "chat.completions.create",
            "models.list",
            "embeddings.create",
            "credits.get",
            "key.info"
          ]
        },
        "params": {
          "description": "Operation-specific parameters",
          "type": "object"
        },
        "stream": {
          "description": "Enable streaming for chat completions",
          "type": "boolean"
        }
      },
      "required": [
        "operation"
      ],
      "type": "object"
    },
    "output": {
      "type": "object"
    }
  },
  "examples": [
    {
      "input": {
        "operation": "chat.completions.create",
        "params": {
          "messages": [
            {
              "content": "Hello",
              "role": "user"
            }
          ],
          "model": "anthropic/claude-sonnet-4"
        }
      },
      "name": "Chat completion",
      "output": {
        "data": {
          "choices": [
            {
              "message": {
                "content": "Hi!"
              }
            }
          ]
        },
        "status": 200
      }
    },
    {
      "input": {
        "operation": "chat.completions.create",
        "params": {
          "messages": [
            {
              "content": "Count to 5",
              "role": "user"
            }
          ],
          "model": "meta-llama/llama-3.1-8b-instruct:free"
        },
        "stream": true
      },
      "name": "Streaming chat",
      "output": {
        "data": {
          "chunks": [
            "..."
          ],
          "combined_text": "1, 2, 3, 4, 5"
        },
        "status": 200
      }
    },
    {
      "input": {
        "operation": "models.list",
        "params": {}
      },
      "name": "List models",
      "output": {
        "data": {
          "data": [
            "..."
          ]
        },
        "status": 200
      }
    },
    {
      "input": {
        "operation": "credits.get",
        "params": {}
      },
      "name": "Check credits",
      "output": {
        "data": {
          "total_credits": 10.0,
          "total_usage": 1.5
        },
        "status": 200
      }
    }
  ]
}
