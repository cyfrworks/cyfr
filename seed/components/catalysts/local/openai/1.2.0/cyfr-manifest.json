{
  "name": "openai",
  "type": "catalyst",
  "version": "1.2.0",
  "publisher": "local",
  "description": "OpenAI API \u2014 the model/chat@1 contract (chat, describe, models) plus chat completions, streaming, embeddings, moderations, images, audio, responses and files",
  "contracts": [
    "model/chat@1"
  ],
  "needs": {
    "api_key": {
      "type": "api_key:openai.com",
      "reason": "to call the OpenAI API with your key (platform.openai.com/api-keys)",
      "required": true,
      "fields": [
        "OPENAI_API_KEY"
      ]
    }
  },
  "caps": {
    "egress": {
      "domains": [
        "api.openai.com"
      ],
      "methods": [
        "GET",
        "POST"
      ]
    },
    "limits": {
      "timeout": "3m",
      "max_memory_bytes": 67108864,
      "max_request_size": 1048576,
      "max_response_size": 5242880,
      "rate_limit": {
        "requests": 100,
        "window": "1m"
      }
    }
  },
  "defaults": {
    "base_url": "https://api.openai.com/v1"
  },
  "schema": {
    "input": {
      "properties": {
        "operation": {
          "enum": [
            "chat",
            "describe",
            "models",
            "chat.completions.create",
            "models.list",
            "models.get",
            "embeddings.create",
            "moderations.create",
            "images.generate",
            "audio.speech",
            "audio.transcriptions",
            "audio.translations",
            "responses.create",
            "files.list",
            "files.get",
            "files.delete"
          ]
        },
        "params": {
          "description": "Operation-specific parameters",
          "type": "object"
        },
        "stream": {
          "description": "Enable streaming (used with chat.completions.create)",
          "type": "boolean"
        }
      },
      "required": [
        "operation"
      ],
      "type": "object"
    },
    "output": {
      "type": "object"
    }
  },
  "examples": [
    {
      "description": "One turn of the model/chat@1 contract: a contract request in, a contract response out",
      "input": {
        "operation": "chat",
        "params": {
          "model": "gpt-5",
          "system": "Answer in one sentence.",
          "messages": [
            {
              "role": "user",
              "content": "What is a catalyst?"
            }
          ],
          "tools": [
            {
              "name": "files.read",
              "description": "Read a file",
              "parameters": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ]
              }
            }
          ],
          "max_tokens": 1024
        }
      },
      "name": "Chat (model/chat@1)",
      "output": {
        "data": {
          "content": [
            {
              "text": "...",
              "type": "text"
            }
          ],
          "model": "gpt-5",
          "stop_reason": "end_turn",
          "usage": {
            "cache_read_tokens": 0,
            "cache_write_tokens": 0,
            "input_tokens": 42,
            "output_tokens": 17
          }
        },
        "status": 200
      }
    },
    {
      "description": "What this catalyst can do, answered without a key",
      "input": {
        "operation": "describe",
        "params": {}
      },
      "name": "Describe (model/chat@1)",
      "output": {
        "data": {
          "contracts": [
            "model/chat@1"
          ],
          "streaming": false,
          "tools": true
        },
        "status": 200
      }
    },
    {
      "description": "The models the bound key can reach, as contract entries",
      "input": {
        "operation": "models",
        "params": {}
      },
      "name": "Models (model/chat@1)",
      "output": {
        "data": {
          "models": [
            {
              "id": "gpt-5",
              "name": "..."
            }
          ]
        },
        "status": 200
      }
    },
    {
      "description": "Simple chat completion with GPT-4o-mini",
      "input": {
        "operation": "chat.completions.create",
        "params": {
          "max_tokens": 10,
          "messages": [
            {
              "content": "Say hello in one word",
              "role": "user"
            }
          ],
          "model": "gpt-4o-mini"
        },
        "stream": false
      },
      "name": "Chat completion",
      "output": {
        "data": {
          "choices": [
            {
              "message": {
                "content": "Hello!",
                "role": "assistant"
              }
            }
          ],
          "id": "chatcmpl-..."
        },
        "status": 200
      }
    },
    {
      "description": "Streaming chat completion via SSE",
      "input": {
        "operation": "chat.completions.create",
        "params": {
          "max_tokens": 50,
          "messages": [
            {
              "content": "Write a haiku about Rust",
              "role": "user"
            }
          ],
          "model": "gpt-4o-mini"
        },
        "stream": true
      },
      "name": "Stream chat completion",
      "output": {
        "data": {
          "chunks": [
            "..."
          ],
          "combined_text": "..."
        },
        "status": 200
      }
    },
    {
      "description": "List available OpenAI models",
      "input": {
        "operation": "models.list",
        "params": {},
        "stream": false
      },
      "name": "List models",
      "output": {
        "data": {
          "data": [
            "..."
          ],
          "object": "list"
        },
        "status": 200
      }
    },
    {
      "description": "Generate embeddings for text",
      "input": {
        "operation": "embeddings.create",
        "params": {
          "input": "Hello world",
          "model": "text-embedding-3-small"
        },
        "stream": false
      },
      "name": "Create embeddings",
      "output": {
        "data": {
          "data": [
            {
              "embedding": [
                0.1,
                0.2,
                "..."
              ],
              "index": 0
            }
          ]
        },
        "status": 200
      }
    },
    {
      "description": "Generate an image with DALL-E",
      "input": {
        "operation": "images.generate",
        "params": {
          "model": "dall-e-3",
          "n": 1,
          "prompt": "A cat sitting on a rainbow",
          "size": "1024x1024"
        },
        "stream": false
      },
      "name": "Generate image",
      "output": {
        "data": {
          "data": [
            {
              "url": "..."
            }
          ]
        },
        "status": 200
      }
    }
  ]
}
