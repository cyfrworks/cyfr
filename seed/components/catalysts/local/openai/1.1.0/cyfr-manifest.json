{
  "name": "openai",
  "type": "catalyst",
  "version": "1.1.0",
  "publisher": "local",
  "description": "OpenAI API SDK \u2014 chat completions, streaming, models, embeddings, moderations, images, audio, responses, and files",
  "needs": {
    "api_key": {
      "type": "api_key:openai.com",
      "reason": "to call the OpenAI API with your key (platform.openai.com/api-keys)",
      "required": true,
      "fields": [
        "OPENAI_API_KEY"
      ]
    }
  },
  "caps": {
    "egress": {
      "domains": [
        "api.openai.com"
      ],
      "methods": [
        "GET",
        "POST"
      ]
    },
    "limits": {
      "timeout": "3m",
      "max_memory_bytes": 67108864,
      "max_request_size": 1048576,
      "max_response_size": 5242880,
      "rate_limit": {
        "requests": 100,
        "window": "1m"
      }
    }
  },
  "defaults": {
    "base_url": "https://api.openai.com/v1"
  },
  "schema": {
    "input": {
      "properties": {
        "operation": {
          "enum": [
            "chat.completions.create",
            "models.list",
            "models.get",
            "embeddings.create",
            "moderations.create",
            "images.generate",
            "audio.speech",
            "audio.transcriptions",
            "audio.translations",
            "responses.create",
            "files.list",
            "files.get",
            "files.delete"
          ]
        },
        "params": {
          "description": "Operation-specific parameters",
          "type": "object"
        },
        "stream": {
          "description": "Enable streaming (used with chat.completions.create)",
          "type": "boolean"
        }
      },
      "required": [
        "operation"
      ],
      "type": "object"
    },
    "output": {
      "type": "object"
    }
  },
  "examples": [
    {
      "description": "Simple chat completion with GPT-4o-mini",
      "input": {
        "operation": "chat.completions.create",
        "params": {
          "max_tokens": 10,
          "messages": [
            {
              "content": "Say hello in one word",
              "role": "user"
            }
          ],
          "model": "gpt-4o-mini"
        },
        "stream": false
      },
      "name": "Chat completion",
      "output": {
        "data": {
          "choices": [
            {
              "message": {
                "content": "Hello!",
                "role": "assistant"
              }
            }
          ],
          "id": "chatcmpl-..."
        },
        "status": 200
      }
    },
    {
      "description": "Streaming chat completion via SSE",
      "input": {
        "operation": "chat.completions.create",
        "params": {
          "max_tokens": 50,
          "messages": [
            {
              "content": "Write a haiku about Rust",
              "role": "user"
            }
          ],
          "model": "gpt-4o-mini"
        },
        "stream": true
      },
      "name": "Stream chat completion",
      "output": {
        "data": {
          "chunks": [
            "..."
          ],
          "combined_text": "..."
        },
        "status": 200
      }
    },
    {
      "description": "List available OpenAI models",
      "input": {
        "operation": "models.list",
        "params": {},
        "stream": false
      },
      "name": "List models",
      "output": {
        "data": {
          "data": [
            "..."
          ],
          "object": "list"
        },
        "status": 200
      }
    },
    {
      "description": "Generate embeddings for text",
      "input": {
        "operation": "embeddings.create",
        "params": {
          "input": "Hello world",
          "model": "text-embedding-3-small"
        },
        "stream": false
      },
      "name": "Create embeddings",
      "output": {
        "data": {
          "data": [
            {
              "embedding": [
                0.1,
                0.2,
                "..."
              ],
              "index": 0
            }
          ]
        },
        "status": 200
      }
    },
    {
      "description": "Generate an image with DALL-E",
      "input": {
        "operation": "images.generate",
        "params": {
          "model": "dall-e-3",
          "n": 1,
          "prompt": "A cat sitting on a rainbow",
          "size": "1024x1024"
        },
        "stream": false
      },
      "name": "Generate image",
      "output": {
        "data": {
          "data": [
            {
              "url": "..."
            }
          ]
        },
        "status": 200
      }
    }
  ]
}
